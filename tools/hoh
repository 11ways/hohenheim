};

// -- entry --------------------------------------------------------------------

// Two flag tables rather than an if-chain, so a flag that TAKES a value accepts
// both spellings (--context staging and --context=staging) by construction.
const BOOLEAN_FLAGS = {
    '--json': 'json', '--yes': 'yes', '-y': 'yes', '--secret': 'secret',
    '--keep-ns': 'keepNs', '--help': 'help', '-h': 'help',
};
const VALUE_FLAGS = { '-n': 'n', '--context': 'context' };

const flags = {};
const positional = [];
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (BOOLEAN_FLAGS[arg]) {
        flags[BOOLEAN_FLAGS[arg]] = true;
        continue;
    }
    if (VALUE_FLAGS[arg]) {
        const value = argv[++i];
        if (value === undefined) die(`${arg} needs a value.`);
        flags[VALUE_FLAGS[arg]] = value;
        continue;
    }
    const equals = arg.indexOf('=');
    const named = equals > 0 ? VALUE_FLAGS[arg.slice(0, equals)] : undefined;
    if (named) {
        flags[named] = arg.slice(equals + 1);
        continue;
    }
    positional.push(arg);
}

const command = flags.help ? 'help' : (positional.shift() || 'help');
const handler = commands[command];
if (!handler) die(`Unknown command "${command}". Run: hoh help`);
// Promise.resolve: a command handler is allowed to be synchronous, and chaining
// .catch on its undefined return is exactly how `hoh help` used to crash AFTER
// printing. Every future sync handler is covered by construction.
Promise.resolve().then(() => handler(positional)).catch(e => die(e.message || String(e)));
