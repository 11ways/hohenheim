#!/usr/bin/env node
'use strict';
// hoh - Hohenheim PaaS CLI. A THIN client of the /api/v1 automation surface:
// every operation is one documented HTTP call, authenticated with a znit_ API
// key. There is deliberately NO logic here beyond transport, table rendering
// and the human confirmation interlock -- authority, validation and refusal
// text all live server-side, so this tool can never become a second policy.
//
// Single-file node (>= 20) script, stdlib only. Configuration:
//   ~/.config/hoh/config.json:
//     { "current": "default",
//       "contexts": { "default": { "host": "https://panel.example", "token": "znit_..." } } }
//   `current` is the stored DEFAULT; --context <name> / HOH_CONTEXT pick another
//   one for this invocation WITHOUT moving it (two lanes on two boxes never
//   clobber each other), and env HOH_HOST / HOH_TOKEN bypass the file entirely.
//
// AIDEV-NOTE: precedence is explicit-beats-ambient. --context outranks
// HOH_HOST/HOH_TOKEN, because a flag typed on THIS command line is a deliberate
// selection while the env is whatever the surrounding shell happens to carry;
// with no flag the env still wins over the file, as it always did.
//
// AIDEV-NOTE: rollback prompts for the site SLUG before acting (--yes skips).
// The server demands no phrase -- the product's ConfirmationSpec is a client
// interlock by design -- so this prompt is the CLI's half of that contract,
// exactly as the admin dialog is the browser's half.

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const readline = require('node:readline');

const CONFIG_PATH = path.join(os.homedir(), '.config', 'hoh', 'config.json');

function loadConfig() {
    try {
        return JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));
    } catch {
        return {};
    }
}

function saveConfig(config) {
    fs.mkdirSync(path.dirname(CONFIG_PATH), { recursive: true });
    fs.writeFileSync(CONFIG_PATH, JSON.stringify(config, null, 2) + '\n', { mode: 0o600 });
    fs.chmodSync(CONFIG_PATH, 0o600);
}

/** The context this invocation selects, which is NOT necessarily the stored default. */
function contextName(config) {
    return flags.context || process.env.HOH_CONTEXT || (config && config.current) || 'default';
}

function requestedContext() {
    return flags.context || process.env.HOH_CONTEXT || '';
}

/**
 * Set by `hoh login` while it verifies the credentials it is ABOUT to store: they are
 * not in the file yet, and under --context the stored lookup would answer with the OLD
 * key for that context (or refuse a context that does not exist yet).
 */
let pendingContext = null;

function activeContext() {
    if (pendingContext) {
        return pendingContext;
    }
    // A named context is a deliberate selection: it reads its OWN token, never the
    // ambient HOH_TOKEN, so a shell pointed at one box cannot leak a key to another.
    if (!flags.context && process.env.HOH_HOST) {
        return { host: process.env.HOH_HOST, token: process.env.HOH_TOKEN || '' };
    }
    const config = loadConfig();
    const name = contextName(config);
    const ctx = (config.contexts || {})[name];
    if (!ctx || !ctx.host) {
        if (requestedContext()) {
            die(`No context named "${name}" in ${CONFIG_PATH}. Run: hoh context list`);
        }
        die(`No context configured. Run: hoh login <host>  (or set HOH_HOST/HOH_TOKEN)`);
    }
    const token = flags.context ? ctx.token : (process.env.HOH_TOKEN || ctx.token);
    return { host: ctx.host, token: token || '' };
}

function die(message) {
    process.stderr.write(message + '\n');
    process.exit(1);
}

// -- transport ----------------------------------------------------------------

async function api(method, apiPath, form) {
    const ctx = activeContext();
    if (!ctx.token) die('No API key configured for this context (hoh login, or HOH_TOKEN).');
    const headers = { 'X-Api-Key': ctx.token };
    let body;
    if (form) {
        headers['Content-Type'] = 'application/x-www-form-urlencoded';
        body = new URLSearchParams(form).toString();
    }
    let response;
    try {
        response = await fetch(ctx.host.replace(/\/$/, '') + apiPath, { method, headers, body });
    } catch (e) {
        die(`Cannot reach ${ctx.host}: ${e.cause ? e.cause.message : e.message}`);
    }
    const text = await response.text();
    let data;
    try {
        data = JSON.parse(text);
    } catch {
        data = null;
    }
    if (!response.ok) {
        if (data && data.error) {
            const code = data.error.code || data.error;
            const message = data.error.message || '';
            die(`Refused (${response.status}) ${code}${message ? ': ' + message : ''}`);
        }
        if (response.status === 404) die('Not found (or not yours).');
        if (response.status === 403) die('Refused (403): this credential is not an API key.');
        die(`Request failed (${response.status})${text ? ': ' + text.slice(0, 300) : ''}`);
    }
    return data;
}

const get = (p) => api('GET', p);
const post = (p, form) => api('POST', p, form || {});

// -- rendering ----------------------------------------------------------------

function table(rows, columns) {
    if (!rows.length) {
        console.log('(none)');
        return;
    }
    const widths = columns.map(c => Math.max(c.length,
        ...rows.map(r => String(r[c] ?? '').length)));
    const line = (cells) => cells.map((cell, i) => String(cell ?? '').padEnd(widths[i]))
        .join('  ').trimEnd();
    console.log(line(columns));
    console.log(line(widths.map(w => '-'.repeat(w))));
    for (const row of rows) console.log(line(columns.map(c => row[c])));
}

function emit(data, rowsKey, columns) {
    if (flags.json) {
        console.log(JSON.stringify(data, null, 2));
        return;
    }
    if (rowsKey) table(data[rowsKey] || [], columns);
    else console.log(JSON.stringify(data, null, 2));
}

// -- prompts ------------------------------------------------------------------

function ask(question, { hidden = false } = {}) {
    if (!process.stdin.isTTY) {
        return Promise.resolve(null);
    }
    return new Promise(resolve => {
        const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
        if (hidden) {
            const write = rl._writeToOutput.bind(rl);
            rl._writeToOutput = s => { if (s.includes(question)) write(s); };
        }
        rl.question(question, answer => {
            rl.close();
            if (hidden) process.stderr.write('\n');
            resolve(answer);
        });
    });
}

// -- site write verbs (hoh site create|delete|domains|domain ...) --------------
//
// key=value pairs are passed to the API VERBATIM as form fields, dotted keys
// included (settings.forward_host=127.0.0.1, custom_headers.0.key=Host): the
// field vocabulary is the server's form, documented in docs/paas-api.md, and
// this tool never learns it -- an unknown key comes back as a named refusal.

function fieldsOf(pairs, usage) {
    const form = {};
    for (const pair of pairs) {
        const at = pair.indexOf('=');
        if (at < 1) die(usage);
        form[pair.slice(0, at)] = pair.slice(at + 1);
    }
    return form;
}

async function confirmSlug(id, verb) {
    const site = await get(`/api/v1/sites/${id}`);
    if (flags.yes) return site;
    const typed = await ask(`${verb} "${site.slug}". Type the site slug to confirm: `);
    if (typed === null) die(`Refusing to ${verb.toLowerCase()} without confirmation (pass --yes in scripts).`);
    if (typed.trim() !== site.slug) die('Slug mismatch; nothing was done.');
    return site;
}

const domainColumns = ['id', 'hostname', 'match_type', 'path', 'listen_on', 'force_ssl', 'live'];

const siteVerbs = {

    async create([name, kind, ...pairs]) {
        const usage = 'Usage: hoh site create <name> <upstream-kind> [field=value ...]';
        if (!name || !kind) die(usage);
        const form = fieldsOf(pairs, usage);
        form.name = name;
        form.upstream_kind = kind;
        const site = await post('/api/v1/sites', form);
        if (flags.json) return emit(site);
        console.log(`Site ${site.id} "${site.slug}" created (${site.type}, enabled=${site.enabled}).`);
    },

    async delete([id]) {
        if (!id) die('Usage: hoh site delete <site-id> [--yes]');
        await confirmSlug(id, 'Delete');
        const result = await post(`/api/v1/sites/${id}/delete`);
        console.log(`Site ${result.id} ${result.status}.`);
    },

    async domains([id]) {
        if (!id) die('Usage: hoh site domains <site-id>');
        emit(await get(`/api/v1/sites/${id}/domains`), 'domains', domainColumns);
    },

    async domain([verb, siteId, ...rest]) {
        const usage = 'Usage: hoh site domain add <site-id> <hostname> [field=value ...]'
            + ' | hoh site domain remove <site-id> <domain-id> [--yes]';
        if (verb === 'add') {
            const [hostname, ...pairs] = rest;
            if (!siteId || !hostname) die(usage);
            const form = fieldsOf(pairs, usage);
            form.hostname = hostname;
            const domain = await post(`/api/v1/sites/${siteId}/domains`, form);
            if (flags.json) return emit(domain);
            console.log(`Domain ${domain.id} ${domain.hostname} added to site ${domain.site_id}`
                + ` (${domain.match_type}, live=${domain.live}).`);
            return;
        }
        if (verb === 'remove') {
            const [domainId] = rest;
            if (!siteId || !domainId) die(usage);
            await confirmSlug(siteId, `Remove domain ${domainId} from`);
            const result = await post(`/api/v1/sites/${siteId}/domains/${domainId}/delete`);
            console.log(`Domain ${result.id} removed from site ${result.site_id}.`);
            return;
        }
        die(usage);
    },
};

// -- access-list verbs (hoh access-list create|list|delete|rule add) ----------

const accessListColumns = ['id', 'name', 'satisfy', 'shared'];

const accessListVerbs = {

    async create([name, ...pairs]) {
        const usage = 'Usage: hoh access-list create <name> [field=value ...]';
        if (!name) die(usage);
        const form = fieldsOf(pairs, usage);
        form.name = name;
        const list = await post('/api/v1/access-lists', form);
        if (flags.json) return emit(list);
        console.log(`Access list ${list.id} "${list.name}" created`
            + ` (satisfy=${list.satisfy}, shared=${list.shared}).`);
    },

    async list() {
        const data = await get('/api/v1/access-lists');
        emit(data, 'access_lists', accessListColumns);
    },

    async delete([id]) {
        if (!id) die('Usage: hoh access-list delete <access-list-id> [--yes]');
        const list = await get(`/api/v1/access-lists/${id}`);
        if (!flags.yes) {
            const typed = await ask(`Delete "${list.name}" and its rules.`
                + ' Type the list name to confirm: ');
            if (typed === null) {
                die('Refusing to delete without confirmation (pass --yes in scripts).');
            }
            if (typed.trim() !== list.name) die('Name mismatch; nothing was done.');
        }
        const result = await post(`/api/v1/access-lists/${id}/delete`);
        console.log(`Access list ${result.id} ${result.status}.`);
    },

    async rule([verb, listId, type, ...pairs]) {
        const usage = 'Usage: hoh access-list rule add <access-list-id> <type>'
            + ' [field=value ...]';
        if (verb !== 'add') die(usage);
        if (!listId || !type) die(usage);
        const form = fieldsOf(pairs, usage);
        form.type = type;
        const rule = await post(`/api/v1/access-lists/${listId}/rules`, form);
        if (flags.json) return emit(rule);
        console.log(`Rule ${rule.id} (${rule.type}) added to access list`
            + ` ${rule.access_list_id}, enabled=${rule.enabled}.`);
    },
};

// -- instance write verbs (hoh instance create|show|delete) -------------------

const instanceVerbs = {

    async create([name, kind, ...pairs]) {
        const usage = 'Usage: hoh instance create <name> <kind> [field=value ...]';
        if (!name || !kind) die(usage);
        const form = fieldsOf(pairs, usage);
        form.name = name;
        form.kind = kind;
        const instance = await post('/api/v1/instances', form);
        if (flags.json) return emit(instance);
        console.log(`Instance ${instance.id} "${instance.name}" created`
            + ` (${instance.kind}, status=${instance.status}).`);
    },

    async show([id]) {
        if (!id) die('Usage: hoh instance show <instance-id>');
        emit(await get(`/api/v1/instances/${id}`));
    },

    async delete([id]) {
        if (!id) die('Usage: hoh instance delete <instance-id> [--yes]');
        const instance = await get(`/api/v1/instances/${id}`);
        if (!flags.yes) {
            const typed = await ask(`Destroy "${instance.name}" and its workload.`
                + ' Type the instance name to confirm: ');
            if (typed === null) {
                die('Refusing to delete without confirmation (pass --yes in scripts).');
            }
            if (typed.trim() !== instance.name) die('Name mismatch; nothing was done.');
        }
        const result = await post(`/api/v1/instances/${id}/delete`);
        console.log(`Instance ${result.id} ${result.status}.`);
    },
};

// -- commands -----------------------------------------------------------------

// -- dns verbs (hoh dns zones | dns zone create|import) ------------------------
//
// The DNS half of the migration lane: a primary zone created through the admin
// form's own pipeline (its apex NS rows seeded from the controller's declared
// dns.nameservers), and the Zone-file tab's import. An import REPLACES the file's
// apex NS set with the declared nameservers unless --keep-ns says otherwise, and
// the answer names everything it did not take verbatim (the SOA, the swapped NS).

const zoneColumns = ['id', 'origin', 'role', 'enabled', 'serial', 'nameservers', 'delegation_status'];

const dnsVerbs = {

    async zones() {
        const data = await get('/api/v1/dns/zones');
        if (flags.json) return emit(data);
        table((data.zones || []).map(z => ({
            ...z, nameservers: (z.nameservers || []).join(', '),
        })), zoneColumns);
    },

    async zone([verb, ...rest]) {
        const usage = 'Usage: hoh dns zone create <origin> [field=value ...]'
            + ' | hoh dns zone import <zone-id> <zone-file> [--keep-ns]';
        if (verb === 'create') {
            const [origin, ...pairs] = rest;
            if (!origin) die(usage);
            const form = fieldsOf(pairs, usage);
            form.origin = origin;
            const zone = await post('/api/v1/dns/zones', form);
            if (flags.json) return emit(zone);
            const ns = (zone.nameservers || []).join(', ') || 'none declared';
            console.log(`Zone ${zone.id} "${zone.origin}" created (${zone.role}, apex NS: ${ns}).`);
            return;
        }
        if (verb === 'import') {
            const [id, file] = rest;
            if (!id || !file) die(usage);
            let text;
            try {
                text = fs.readFileSync(file, 'utf8');
            } catch (e) {
                die(`Cannot read ${file}: ${e.message}`);
            }
            const form = { zone_text: text };
            if (flags.keepNs) form.keep_ns = 'on';
            const result = await post(`/api/v1/dns/zones/${id}/import`, form);
            if (flags.json) return emit(result);
            console.log(`Zone ${result.id} ${result.origin}: ${result.imported} records imported,`
                + ` serial ${result.serial}.`);
            for (const note of result.notes || []) console.log(`  note: ${note}`);
            for (const line of result.skipped || []) console.log(`  skipped: ${line}`);
            return;
        }
        die(usage);
    },
};

const commands = {

    async login([host]) {
        if (!host) die('Usage: hoh login <host-url>');
        const token = process.env.HOH_TOKEN
            || await ask('API key (znit_...): ', { hidden: true });
        if (!token) die('An API key is required (mint one under /account/api-keys).');
        // Verify before storing: one harmless read proves host + key together.
        pendingContext = { host, token };
        try {
            await get('/api/v1/projects');
        }
        finally {
            pendingContext = null;
        }
        const config = loadConfig();
        config.contexts = config.contexts || {};
        // The ACTIVE context, resolved exactly like every other verb resolves it
        // (--context > HOH_CONTEXT > the stored default > "default"). Writing to
        // "default" regardless is how `hoh context use bravo; hoh login <bravo>`
        // stored bravo's key under alpha and left bravo unauthenticated.
        const name = contextName(config);
        config.contexts[name] = { host, token };
        config.current = config.current || name;
        saveConfig(config);
        console.log(`Context "${name}" saved to ${CONFIG_PATH}`);
        if (config.current !== name) {
            // Say so rather than let the next bare command silently use the other box.
            console.log(`The default context is still "${config.current}".`
                + ` Use it with: hoh --context ${name} <command>`
                + `  (or make it the default: hoh context use ${name})`);
        }
    },

    // Contexts are how one workstation drives several controllers. `use` moves the
    // stored default; --context / HOH_CONTEXT select for ONE invocation and move
    // nothing, so two concurrent lanes cannot clobber each other's default.
    async context([verb, name]) {
        const config = loadConfig();
        const contexts = config.contexts || {};
        const names = Object.keys(contexts);

        if (!verb || verb === 'list') {
            const selected = contextName(config);
            const envHost = !flags.context && process.env.HOH_HOST ? process.env.HOH_HOST : '';
            const rows = names.map(n => ({
                name: n,
                host: contexts[n].host || '',
                key: contexts[n].token ? 'stored' : '(none)',
                default: n === config.current ? 'yes' : '',
                selected: !envHost && n === selected ? 'yes' : '',
            }));
            if (flags.json) {
                return emit({ contexts: rows, current: config.current || null,
                    selected: envHost ? null : selected, env_host: envHost || null });
            }
            table(rows, ['name', 'host', 'key', 'default', 'selected']);
            if (envHost) {
                console.log(`\nHOH_HOST=${envHost} is set and overrides every stored context.`);
            } else if (requestedContext() && !contexts[selected]) {
                console.log(`\nNo context named "${selected}" is stored.`);
            }
            return;
        }

        if (verb === 'use') {
            if (!name) die('Usage: hoh context use <name>');
            if (!contexts[name]) {
                die(`No context named "${name}". Run: hoh context list`);
            }
            config.current = name;
            saveConfig(config);
            console.log(`Default context is now "${name}" (${contexts[name].host}).`);
            return;
        }

        die('Usage: hoh context list | hoh context use <name>');
    },

    async projects([id]) {
        if (id) {
            emit(await get(`/api/v1/projects/${id}`));
            return;
        }
        const data = await get('/api/v1/projects');
        if (flags.json) return emit(data);
        table((data.projects || []).map(p => ({
            id: p.id, name: p.name,
            environments: (p.environments || []).map(e => `${e.id}:${e.name}`).join(', '),
        })), ['id', 'name', 'environments']);
    },

    async sites() {
        const data = await get('/api/v1/sites');
        if (flags.json) return emit(data);
        table((data.sites || []).map(s => ({
            id: s.id, slug: s.slug, type: s.type, source: s.source,
            enabled: s.enabled, health: s.health,
            project: s.project ? s.project.name : '',
        })), ['id', 'slug', 'type', 'source', 'enabled', 'health', 'project']);
    },

    async site([first, ...rest]) {
        if (siteVerbs[first]) return siteVerbs[first](rest);
        if (!first) die('Usage: hoh site <site-id> | hoh site create|delete|domains|domain ...');
        emit(await get(`/api/v1/sites/${first}`));
    },

    async dns([first, ...rest]) {
        if (dnsVerbs[first]) return dnsVerbs[first](rest);
        die('Usage: hoh dns zones | hoh dns zone create|import ...');
    },

    async deploy([id]) {
        if (!id) die('Usage: hoh deploy <site-id>');
        const result = await post(`/api/v1/sites/${id}/deploy`);
        console.log(`Deploy ${result.status} for site ${result.id}.`);
    },

    async rollback([id]) {
        if (!id) die('Usage: hoh rollback <site-id> [--yes]');
        const site = await get(`/api/v1/sites/${id}`);
        if (!flags.yes) {
            const typed = await ask(
                `Roll back "${site.slug}" to its retained release. Type the site slug to confirm: `);
            if (typed === null) {
                die('Refusing to roll back without confirmation (pass --yes in scripts).');
            }
            if (typed.trim() !== site.slug) {
                die('Slug mismatch; nothing was done.');
            }
        }
        const result = await post(`/api/v1/sites/${id}/rollback`);
        console.log(`Rollback ${result.status} for site ${result.id}.`);
    },

    async releases([id]) {
        if (!id) die('Usage: hoh releases <site-id>');
        emit(await get(`/api/v1/sites/${id}/releases`), 'releases',
            ['id', 'kind', 'status', 'image', 'failure_reason', 'finished_at']);
    },

    async release([siteId, opId]) {
        if (!siteId || !opId) die('Usage: hoh release <site-id> <release-id>');
        const data = await get(`/api/v1/sites/${siteId}/releases/${opId}`);
        if (flags.json) return emit(data);
        const { step_log, ...rest } = data;
        console.log(JSON.stringify(rest, null, 2));
        if (step_log) console.log('\n' + step_log);
    },

    async builds([id]) {
        if (!id) die('Usage: hoh builds <site-id>');
        emit(await get(`/api/v1/sites/${id}/builds`), 'builds',
            ['id', 'builder_kind', 'status', 'image', 'failure_reason', 'finished_at']);
    },

    async 'build-log'([siteId, buildId]) {
        if (!siteId || !buildId) die('Usage: hoh build-log <site-id> <build-id>');
        const data = await get(`/api/v1/sites/${siteId}/builds/${buildId}/log`);
        process.stdout.write((data.log || '') + '\n');
    },

    async deployments([id]) {
        if (!id) die('Usage: hoh deployments <site-id>');
        emit(await get(`/api/v1/sites/${id}/deployments`), 'deployments',
            ['id', 'status', 'reason', 'commit_sha', 'finished_at']);
    },

    async 'deploy-log'([siteId, deployId]) {
        if (!siteId || !deployId) die('Usage: hoh deploy-log <site-id> <deployment-id>');
        const data = await get(`/api/v1/sites/${siteId}/deployments/${deployId}/log`);
        process.stdout.write((data.log || '') + '\n');
    },

    async instances() {
        emit(await get('/api/v1/instances'), 'instances',
            ['id', 'name', 'kind', 'status', 'template']);
    },

    async instance([first, ...rest]) {
        if (instanceVerbs[first]) return instanceVerbs[first](rest);
        if (!first) die('Usage: hoh instance <instance-id> | hoh instance create|show|delete ...');
        emit(await get(`/api/v1/instances/${first}`));
    },

    async 'access-list'([first, ...rest]) {
        if (accessListVerbs[first]) return accessListVerbs[first](rest);
        if (!first) die('Usage: hoh access-list create|list|delete|rule ...');
        emit(await get(`/api/v1/access-lists/${first}`));
    },

    async logs([id]) {
        if (!id) die('Usage: hoh logs <instance-id> [-n <lines>]');
        const lines = flags.n ? `?lines=${encodeURIComponent(flags.n)}` : '';
        const data = await get(`/api/v1/instances/${id}/logs${lines}`);
        process.stdout.write((data.lines || '') + '\n');
    },

    async power([id, action]) {
        if (!id || !action) die('Usage: hoh power <instance-id> start|stop|restart');
        const result = await post(`/api/v1/instances/${id}/power`, { action });
        console.log(`Instance ${result.id}: ${result.action} -> ${result.status}`);
    },

    async vars([scope, id, verb, key, value]) {
        const bases = {
            instance: (i) => `/api/v1/instances/${i}/variables`,
            env: (i) => `/api/v1/environments/${i}/variables`,
        };
        if (!bases[scope] || !id) {
            die('Usage: hoh vars instance|env <id> [set <KEY> [<value>] [--secret] | unset <KEY>]');
        }
        const base = bases[scope](id);
        if (!verb) {
            const data = await get(base);
            if (flags.json) return emit(data);
            table((data.variables || []).map(v => ({
                key: v.key, kind: v.kind,
                value: v.kind === 'secret' ? (v.has_value ? '(set)' : '(empty)') : v.value,
            })), ['key', 'kind', 'value']);
            return;
        }
        if (verb === 'set') {
            if (!key) die('Usage: hoh vars ' + scope + ' <id> set <KEY> [<value>] [--secret]');
            let resolved = value;
            if (resolved === undefined) {
                // No value on the command line: read it hidden, so secrets stay out of
                // shell history and process listings.
                resolved = await ask(`Value for ${key}: `, { hidden: true });
                if (resolved === null) die('A value is required (pipe it or pass it inline).');
            }
            const kind = flags.secret ? 'secret' : 'plain';
            await post(base, { key, kind, value: resolved });
            console.log(`${key} set (${kind}).`);
            return;
        }
        if (verb === 'unset') {
            if (!key) die('Usage: hoh vars ' + scope + ' <id> unset <KEY>');
            await post(`${base}/delete`, { key });
            console.log(`${key} removed.`);
            return;
        }
        die(`Unknown vars verb "${verb}".`);
    },

    async help() {
        console.log(`hoh - Hohenheim PaaS CLI (a thin client of /api/v1)

Usage: hoh [--context <name>] <command> [args] [--json] [--yes]

