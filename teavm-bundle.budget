# TeaVM bundle size budget: max allowed bytes per generated bundle.
# The build FAILS when a bundle exceeds these. After a deliberate size
# change, regenerate with the updateBundleBudget task and commit.
# measured= is the size this ceiling was derived from, so the next
# breach can report how much the bundle GREW since this baseline.
cms.js.raw=5066548 measured=4825283
cms.js.gzip=1203743 measured=1146421
