<!DOCTYPE html>
<html data-theme="dark">
<head><meta charset="UTF-8"><title>Hohenheim - Sites</title></head>
<body onload="main()">
<hh-layout pageTitle={% "Sites" %}>

    {% declare siteCount: Integer %}

    <div class="hh-page-actions">
        <p class="hh-page-actions__description">Manage your proxy sites and their domains.</p>
        <a href="/sites/create" style="text-decoration: none;"><pl-button variant="primary">Create Site</pl-button></a>
    </div>

    <pl-card>
        <pl-card-content>
            <pl-table>
                <pl-table-header><pl-table-row>
                    <pl-table-head>Name</pl-table-head>
                    <pl-table-head>Type</pl-table-head>
                    <pl-table-head>Status</pl-table-head>
                    <pl-table-head>Domains</pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body>
                    {% if siteCount == 0 %}
                    <pl-table-row>
                        <pl-table-cell colspan="4" style="text-align:center; color: var(--pl-color-text-muted); padding: var(--pl-space-2xl);">No sites configured yet.</pl-table-cell>
                    </pl-table-row>
                    {% /if %}
                </pl-table-body>
            </pl-table>
        </pl-card-content>
    </pl-card>

</hh-layout>
</body>
</html>
