<!DOCTYPE html>
<html data-theme="dark">
<head><meta charset="UTF-8"><title>Hohenheim - Certificates</title></head>
<body onload="main()">
<hh-layout pageTitle={% "Certificates" %}>

    <div class="hh-page-actions">
        <p class="hh-page-actions__description">SSL/TLS certificates for your sites.</p>
        <pl-button variant="primary">Upload Certificate</pl-button>
    </div>

    <pl-card>
        <pl-card-content>
            <pl-table>
                <pl-table-header><pl-table-row>
                    <pl-table-head>Name</pl-table-head>
                    <pl-table-head>Domains</pl-table-head>
                    <pl-table-head>Provider</pl-table-head>
                    <pl-table-head>Expires</pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body><pl-table-row>
                    <pl-table-cell colspan="4" style="text-align:center; color: var(--pl-color-text-muted); padding: var(--pl-space-2xl);">No certificates yet.</pl-table-cell>
                </pl-table-row></pl-table-body>
            </pl-table>
        </pl-card-content>
    </pl-card>

</hh-layout>
</body>
</html>
