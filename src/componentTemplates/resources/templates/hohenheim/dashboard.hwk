<!DOCTYPE html>
<html data-theme="dark">
<head><meta charset="UTF-8"><title>Hohenheim - Dashboard</title></head>
<body onload="main()">
<hh-layout pageTitle={% "Dashboard" %}>

    {% declare siteCount: Integer %}
    {% declare certCount: Integer %}
    {% declare proxyStatus: String %}
    {% declare routeCount: Integer %}

    <div class="hh-stat-grid">
        <pl-card>
            <pl-card-header><pl-card-title>Sites</pl-card-title><pl-card-description>Managed proxy sites</pl-card-description></pl-card-header>
            <pl-card-content><p style="font-size: var(--pl-font-size-3xl); font-weight: 700;">{{ siteCount }}</p></pl-card-content>
        </pl-card>
        <pl-card>
            <pl-card-header><pl-card-title>Certificates</pl-card-title><pl-card-description>SSL/TLS certificates</pl-card-description></pl-card-header>
            <pl-card-content><p style="font-size: var(--pl-font-size-3xl); font-weight: 700;">{{ certCount }}</p></pl-card-content>
        </pl-card>
        <pl-card>
            <pl-card-header><pl-card-title>Proxy</pl-card-title><pl-card-description>{{ routeCount }} active routes</pl-card-description></pl-card-header>
            <pl-card-content><pl-badge variant={% "default" %}>{{ proxyStatus }}</pl-badge></pl-card-content>
        </pl-card>
    </div>

</hh-layout>
</body>
</html>
