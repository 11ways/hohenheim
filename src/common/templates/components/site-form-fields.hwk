{% tag HhSiteFormFields {

    public form: SiteFormData = null
    public selectedType: String = "hohenheim:proxy"
    public source: String = ""

    template {
        <div class="hh-form-group">
            <pl-label target="site-name">Site Name</pl-label>
            <pl-input id="site-name" type={% "text" %} name={% "name" %} value={% form.siteName %} placeholder={% "My Website" %} required={% true %}></pl-input>
        </div>

        <div class="hh-form-group">
            <pl-label target="site-type">Site Type</pl-label>
            <pl-select id="site-type" name="site_type" bind:value={% selectedType{:} %}>
                <pl-select-trigger placeholder="Select type"></pl-select-trigger>
                <pl-select-content>
                    {% each form.siteTypes as index, st %}
                        <pl-select-item value={% st.get("value") %} label={% st.get("label") %}>{{ st.get("label") }}{% if st.get("description") != null %} - {{ st.get("description") }}{% /if %}</pl-select-item>
                    {% /each %}
                </pl-select-content>
            </pl-select>
        </div>

        <div class="hh-form-group">
            <pl-label target="source">Source</pl-label>
            <pl-select id="source" name="source" bind:value={% source{:} %}>
                <pl-select-trigger placeholder="Local"></pl-select-trigger>
                <pl-select-content>
                    <pl-select-item value="" label="Local">Local - files on disk</pl-select-item>
                    <pl-select-item value="git" label="Git">Git - clone from repository</pl-select-item>
                </pl-select-content>
            </pl-select>
        </div>

        {% if source{:} == "git" %}
            <pl-separator></pl-separator>
            <hh-git-source-settings form={% form %}></hh-git-source-settings>
        {% /if %}

        <div class="hh-form-group">
            <pl-label target="auth-provider">Auth Provider</pl-label>
            <pl-select id="auth-provider" name="auth_provider_id" value={% form.authProviderId %}>
                <pl-select-trigger placeholder="None"></pl-select-trigger>
                <pl-select-content>
                    <pl-select-item value="" label="None">None - no identity gate</pl-select-item>
                    {% each form.authProviders as index, ap %}
                        <pl-select-item value={% ap.get("value") %} label={% ap.get("label") %}>{{ ap.get("label") }}</pl-select-item>
                    {% /each %}
                </pl-select-content>
            </pl-select>
            <p class="hh-form-hint">Gate every request to this site behind an auth provider before it reaches the upstream.</p>
        </div>

        <div class="hh-form-group">
            <pl-label target="access-list">Access List</pl-label>
            <pl-select id="access-list" name="access_list_id" value={% form.accessListId %}>
                <pl-select-trigger placeholder="None"></pl-select-trigger>
                <pl-select-content>
                    <pl-select-item value="" label="None">None - no IP restrictions</pl-select-item>
                    {% each form.accessLists as index, al %}
                        <pl-select-item value={% al.get("value") %} label={% al.get("label") %}>{{ al.get("label") }}</pl-select-item>
                    {% /each %}
                </pl-select-content>
            </pl-select>
            <p class="hh-form-hint">Apply an IP allow/deny list (with optional basic auth) to every request.</p>
        </div>

        <pl-separator></pl-separator>

        <hh-site-type-fields form={% form %} selectedType={% &selectedType{:} %}></hh-site-type-fields>
    }
} %}
