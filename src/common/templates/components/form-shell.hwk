{% tag HhFormShell {

    public action: String = ""
    public title: String = ""
    public description: String = ""
    public submitLabel: String = "Save"
    public cancelHref: String = ""
    public error: String = ""

    template {
        <hh-form-error error={% error %}></hh-form-error>
        <form method="POST" action={% action %}>
            {% csrf() %}
            <pl-card class="hh-form-card">
                <pl-card-header>
                    <pl-card-title>{{ title }}</pl-card-title>
                    {% if description != "" %}
                        <pl-card-description>{{ description }}</pl-card-description>
                    {% /if %}
                </pl-card-header>
                <pl-card-content>
                    <div class="hh-form-stack">
                        <slot></slot>
                    </div>
                </pl-card-content>
            </pl-card>
            <div class="hh-form-actions">
                <pl-button variant={% "primary" %} type={% "submit" %}>{{ submitLabel }}</pl-button>
                <a href={% cancelHref %} class="hh-button-link"><pl-button variant={% "outline" %} type={% "button" %}>Cancel</pl-button></a>
            </div>
        </form>
    }
} %}
