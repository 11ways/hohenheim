{% tag HhAuthProviderFields {

    public name: String = ""
    public selectedType: String = "hohenheim:proteus"
    public authProviderTypes: List = null
    public requiredPermission: String = ""
    public endpoint: String = ""
    public realmClient: String = ""
    public accessKey: String = ""
    public authenticator: String = "password"
    public credentials: List = null

    template {
        <div class="hh-form-group">
            <pl-label target="provider-name">Name</pl-label>
            <pl-input id="provider-name" type={% "text" %} name={% "name" %} value={% name %} placeholder={% "Staff SSO" %} required={% true %}></pl-input>
        </div>

        <div class="hh-form-group">
            <pl-label target="provider-type">Provider Type</pl-label>
            <pl-select id="provider-type" name="provider_type" bind:value={% selectedType{:} %}>
                <pl-select-trigger placeholder="Select type"></pl-select-trigger>
                <pl-select-content>
                    {% each authProviderTypes as index, pt %}
                        <pl-select-item value={% pt.get("value") %} label={% pt.get("label") %}>{{ pt.get("label") }}</pl-select-item>
                    {% /each %}
                </pl-select-content>
            </pl-select>
        </div>

        <pl-separator></pl-separator>

        {% if selectedType{:} == "hohenheim:proteus" %}
            <div class="hh-form-group">
                <pl-label target="endpoint">Realm Server URL</pl-label>
                <pl-input id="endpoint" type={% "text" %} name={% "endpoint" %} value={% endpoint %} placeholder={% "https://proteus.example/" %} required={% true %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="realm-client">Realm Client</pl-label>
                <pl-input id="realm-client" type={% "text" %} name={% "realm_client" %} value={% realmClient %} placeholder={% "my-app" %} required={% true %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="access-key">Access Key</pl-label>
                <pl-input id="access-key" type={% "password" %} name={% "access_key" %} value={% accessKey %} required={% true %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="authenticator">Authenticator</pl-label>
                <pl-input id="authenticator" type={% "text" %} name={% "authenticator" %} value={% authenticator %} placeholder={% "password" %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="required-permission">Required Permission</pl-label>
                <pl-input id="required-permission" type={% "text" %} name={% "required_permission" %} value={% requiredPermission %} placeholder={% "hohenheim.site.my-app" %}></pl-input>
                <p class="hh-form-hint">Leave blank to allow ANY authenticated identity. Set a leaf permission (e.g. hohenheim.site.my-app) to restrict access.</p>
            </div>
        {% elseif selectedType{:} == "hohenheim:basic" %}
            <p class="hh-form-hint">Username + password pairs. Passwords are hashed on save; leave a password blank when editing to keep the existing one.</p>
            <hh-key-value-editor
                initialPairs={% credentials %}
                namePrefix={% "credentials" %}
                namePlaceholder={% "username" %}
                valuePlaceholder={% "password" %}></hh-key-value-editor>
        {% /if %}
    }
} %}
