{% tag HhEmptyRow {

    public count: Integer = 0
    public colspan: String = "1"
    public message: String = ""

    template {
        {% if count == 0 %}
            <pl-table-row>
                <pl-table-cell colspan={% colspan %} class="hh-empty-state">{{ message }}</pl-table-cell>
            </pl-table-row>
        {% /if %}
    }
} %}
