{% tag HhMatchTypeSelect {

    public value: String = "exact"

    template {
        <pl-select id="match-type" name="match_type" value={% value %}>
            <pl-select-trigger placeholder="Match type"></pl-select-trigger>
            <pl-select-content>
                <pl-select-item value="exact" label="Exact">Exact</pl-select-item>
                <pl-select-item value="wildcard" label="Wildcard">Wildcard</pl-select-item>
                <pl-select-item value="regex" label="Regex">Regex</pl-select-item>
            </pl-select-content>
        </pl-select>
    }
} %}
