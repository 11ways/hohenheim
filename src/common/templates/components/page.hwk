{% tag HhPage {

    public title: String = ""
    public subtitle: String = ""

    template {
        <header class="hh-header">
            {% if subtitle != "" %}
                <div>
                    <h1 class="hh-header__title">{{ title }}</h1>
                    <p class="hh-header__subtitle">{{ subtitle }}</p>
                </div>
            {% else %}
                <h1 class="hh-header__title">{{ title }}</h1>
            {% /if %}
        </header>
        <main class="hh-content">
            <slot></slot>
        </main>
    }
} %}
