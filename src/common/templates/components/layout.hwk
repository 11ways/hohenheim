{% tag HhLayout {

    public pageTitle: String = ""

    template {
        {% style(href: "/plumage.css") %}
        {% style(href: "/hohenheim.css") %}
        {% script(src: "/hohenheim.js") %}

        <nav class="hh-sidebar">
            <div class="hh-sidebar__logo">Hohenheim</div>
            <ul class="hh-sidebar__nav">
                <li><a class="hh-sidebar__link" href="/">Dashboard</a></li>
                <li><a class="hh-sidebar__link" href="/sites">Sites</a></li>
                <li><a class="hh-sidebar__link" href="/certificates">Certificates</a></li>
                <li><a class="hh-sidebar__link" href="/access-lists">Access Lists</a></li>
                <li><a class="hh-sidebar__link" href="/settings">Settings</a></li>
                <li><a class="hh-sidebar__link" href="/audit">Audit Log</a></li>
            </ul>
            <div class="hh-sidebar__footer">
                <form method="POST" action="/logout">
                    <pl-button variant={% "ghost" %} size={% "sm" %} type={% "submit" %}>Sign Out</pl-button>
                </form>
            </div>
        </nav>
        <div class="hh-main">
            <he-block block-name="main"></he-block>
        </div>
    }
} %}
