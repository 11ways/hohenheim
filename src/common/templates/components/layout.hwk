{% tag HhLayout {

    style {
        display: block;
    }

    public pageTitle: String = ""

    template {
        <pl-app-shell>
            <pl-app-header>
                <pl-sidebar-toggle></pl-sidebar-toggle>
                <span class="hh-brand">Hohenheim</span>
            </pl-app-header>
            <pl-app-sidebar>
                <pl-nav>
                    <pl-nav-item href="/">Dashboard</pl-nav-item>
                    <pl-nav-item href="/sites">Sites</pl-nav-item>
                    <pl-nav-item href="/certificates">Certificates</pl-nav-item>
                    <pl-nav-item href="/access-lists">Access Lists</pl-nav-item>
                    <pl-nav-item href="/databases">Databases</pl-nav-item>
                    <pl-nav-item href="/servers">Servers</pl-nav-item>
                    <pl-nav-item href="/notifications">Notifications</pl-nav-item>
                    <pl-nav-item href="/settings">Settings</pl-nav-item>
                    <pl-nav-item href="/audit">Audit Log</pl-nav-item>
                </pl-nav>
                <div class="hh-sidebar__footer">
                    <hh-post-action action={% "/logout" %} label={% "Sign Out" %}></hh-post-action>
                </div>
            </pl-app-sidebar>
            <pl-app-content>
                <he-block block-name="main"></he-block>
            </pl-app-content>
        </pl-app-shell>
    }
} %}
