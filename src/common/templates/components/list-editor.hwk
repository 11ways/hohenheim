{% tag HhListEditor {

    style {
        display: block;
    }

    public initialItems: List = null
    public namePrefix: String = "item"
    public placeholder: String = "Enter a value"
    private items: List = null

    @mount
    function init() {
        let result = []
        if initialItems != null {
            initialItems |> Array.forEach(v => {
                let wrapper = Map.create()
                Map.put(wrapper, "value", v)
                List.add(result, wrapper)
            })
        }
        items = result
    }

    function addItem() {
        let wrapper = Map.create()
        Map.put(wrapper, "value", "")
        let copy = items |> Array.filter(i => true)
        List.add(copy, wrapper)
        items = copy
    }


    template {
        <div class="hh-list-editor">
            {% each items{:} as index, item %}
            <div class="hh-kv-row">
                <pl-input name={% namePrefix + "[" + index + "]" %} value={% item.get("value") %} placeholder={% placeholder %}></pl-input>
                <pl-button variant={% "ghost" %} size={% "sm" %} type={% "button" %} event:click={% () => items = items |> Array.filter(i => i != item) %}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </pl-button>
            </div>
            {% /each %}
            <pl-button variant={% "outline" %} size={% "sm" %} type={% "button" %} event:click={% addItem() %}>Add</pl-button>
        </div>
    }
} %}
