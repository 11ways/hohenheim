{% tag HhSiteTypeFields {

    public selectedType: String = "hohenheim:proxy"
    public forwardHost: String = ""
    public forwardPort: String = ""
    public websocketUpgrade: Boolean = true
    public ignoreCertificates: Boolean = false
    public script: String = ""
    public nodePath: String = ""
    public minimumProcesses: String = "1"
    public maximumProcesses: String = "5"
    public rootPath: String = ""
    public fallbackFile: String = ""
    public targetUrl: String = ""
    public httpStatus: String = "302"

    template {
        {% if selectedType{:} == "hohenheim:proxy" %}
        <div class="hh-form-section">
            <div class="hh-form-row">
                <div class="hh-form-group hh-form-group--grow">
                    <pl-label target="forward-host">Upstream Host</pl-label>
                    <pl-input id="forward-host" type={% "text" %} name={% "forward_host" %} value={% forwardHost %} placeholder={% "127.0.0.1" %}></pl-input>
                </div>
                <div class="hh-form-group hh-form-group--port">
                    <pl-label target="forward-port">Port</pl-label>
                    <pl-input id="forward-port" type={% "number" %} name={% "forward_port" %} value={% forwardPort %} placeholder={% "3000" %}></pl-input>
                </div>
            </div>
            <div class="hh-form-group">
                <label class="hh-checkbox-label">
                    <input type="checkbox" name="websocket_upgrade" checked={% websocketUpgrade %}>
                    <span>WebSocket Proxying</span>
                </label>
                <p class="hh-form-hint">Proxy WebSocket upgrade requests to upstream.</p>
            </div>
            <div class="hh-form-group">
                <label class="hh-checkbox-label">
                    <input type="checkbox" name="ignore_certificates" checked={% ignoreCertificates %}>
                    <span>Ignore upstream TLS errors</span>
                </label>
                <p class="hh-form-hint">Skip certificate verification when proxying to HTTPS upstreams.</p>
            </div>
        </div>
        {% /if %}

        {% if selectedType{:} == "hohenheim:node" || selectedType{:} == "hohenheim:alchemy" %}
        <div class="hh-form-section">
            <div class="hh-form-group">
                <pl-label target="script">Script Path</pl-label>
                <pl-input id="script" type={% "text" %} name={% "script" %} value={% script %} placeholder={% "/path/to/app.js" %}></pl-input>
                <p class="hh-form-hint">Absolute path to the entry script.</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="node-path">Node Binary</pl-label>
                <pl-input id="node-path" type={% "text" %} name={% "node_path" %} value={% nodePath %} placeholder={% "node" %}></pl-input>
                <p class="hh-form-hint">Path to the Node.js binary. Leave empty for system default.</p>
            </div>
            <div class="hh-form-row">
                <div class="hh-form-group hh-form-group--grow">
                    <pl-label target="min-processes">Min Processes</pl-label>
                    <pl-input id="min-processes" type={% "number" %} name={% "minimum_processes" %} value={% minimumProcesses %} placeholder={% "1" %}></pl-input>
                </div>
                <div class="hh-form-group hh-form-group--grow">
                    <pl-label target="max-processes">Max Processes</pl-label>
                    <pl-input id="max-processes" type={% "number" %} name={% "maximum_processes" %} value={% maximumProcesses %} placeholder={% "5" %}></pl-input>
                </div>
            </div>
        </div>
        {% /if %}

        {% if selectedType{:} == "hohenheim:static" %}
        <div class="hh-form-section">
            <div class="hh-form-group">
                <pl-label target="root-path">Root Directory</pl-label>
                <pl-input id="root-path" type={% "text" %} name={% "root_path" %} value={% rootPath %} placeholder={% "/var/www/html" %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="fallback-file">SPA Fallback File</pl-label>
                <pl-input id="fallback-file" type={% "text" %} name={% "fallback_file" %} value={% fallbackFile %} placeholder={% "index.html" %}></pl-input>
            </div>
        </div>
        {% /if %}

        {% if selectedType{:} == "hohenheim:redirect" %}
        <div class="hh-form-section">
            <div class="hh-form-group">
                <pl-label target="target-url">Target URL</pl-label>
                <pl-input id="target-url" type={% "text" %} name={% "target_url" %} value={% targetUrl %} placeholder={% "https://example.com" %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="http-status">Status Code</pl-label>
                <select id="http-status" name="http_status" class="hh-select">
                    <option value="302">302 Found (temporary)</option>
                    <option value="301">301 Permanent</option>
                    <option value="307">307 Temporary Redirect</option>
                    <option value="308">308 Permanent Redirect</option>
                </select>
            </div>
        </div>
        {% /if %}
    }
} %}
