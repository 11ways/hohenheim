{% tag HhSiteTypeFields {

    public form: SiteFormData = null
    public selectedType: String = "hohenheim:proxy"

    template {
        {% if selectedType{:} == "hohenheim:proxy" %}
            <hh-proxy-settings form={% form %}></hh-proxy-settings>
        {% elseif selectedType{:} == "hohenheim:node" || selectedType{:} == "hohenheim:alchemy" %}
            <hh-node-settings
                form={% form %}
                waitForReadyDefault={% selectedType{:} == "hohenheim:alchemy" %}
            ></hh-node-settings>
        {% elseif selectedType{:} == "hohenheim:command" %}
            <hh-command-settings form={% form %}></hh-command-settings>
        {% elseif selectedType{:} == "hohenheim:static" %}
            <hh-static-settings form={% form %}></hh-static-settings>
        {% elseif selectedType{:} == "hohenheim:redirect" %}
            <hh-redirect-settings form={% form %}></hh-redirect-settings>
        {% elseif selectedType{:} == "hohenheim:docker" %}
            <hh-docker-settings form={% form %}></hh-docker-settings>
        {% /if %}
    }
} %}
