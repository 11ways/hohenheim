{% tag HhSiteTypeFields {

    public selectedType: String = "hohenheim:proxy"
    public settings: Map = null
    public environmentVariables: List = null
    public apiKeys: List = null
    public nodeVersions: List = null
    public systemUsers: List = null
    public servers: List = null

    template {
        {% if selectedType{:} == "hohenheim:proxy" %}
            <hh-proxy-settings settings={% settings %}></hh-proxy-settings>
        {% elseif selectedType{:} == "hohenheim:node" || selectedType{:} == "hohenheim:alchemy" %}
            <hh-node-settings
                settings={% settings %}
                environmentVariables={% environmentVariables %}
                apiKeys={% apiKeys %}
                nodeVersions={% nodeVersions %}
                systemUsers={% systemUsers %}
            ></hh-node-settings>
        {% elseif selectedType{:} == "hohenheim:static" %}
            <hh-static-settings settings={% settings %}></hh-static-settings>
        {% elseif selectedType{:} == "hohenheim:redirect" %}
            <hh-redirect-settings settings={% settings %}></hh-redirect-settings>
        {% elseif selectedType{:} == "hohenheim:docker" %}
            <hh-docker-settings settings={% settings %} servers={% servers %}></hh-docker-settings>
        {% /if %}
    }
} %}
