{% tag HhPostAction {

    public action: String = ""
    public label: String = ""
    public variant: String = "ghost"
    public size: String = "sm"
    public confirm: String = ""

    template {
        {%
            let formId = "hh-pa-" + String.replace(String.replace(action, "/", "-"), ":", "-")
        %}
        <form method="POST" action={% action %} attr:id={% formId %}>
            {% csrf() %}
            {% if confirm != "" %}
                {#
                    The dialog content is PORTALLED to the document bottom, so the
                    confirm button is not a DOM descendant of this form -- it submits
                    through the native form= attribute association instead.
                #}
                <pl-alert-dialog>
                    <pl-alert-dialog-trigger>
                        <pl-button variant={% variant %} size={% size %} type={% "button" %}>{{ label }}</pl-button>
                    </pl-alert-dialog-trigger>
                    <pl-alert-dialog-content>
                        <pl-alert-dialog-header>
                            <pl-alert-dialog-title>Are you sure?</pl-alert-dialog-title>
                            <pl-alert-dialog-description>{{ confirm }}</pl-alert-dialog-description>
                        </pl-alert-dialog-header>
                        <pl-alert-dialog-footer>
                            <pl-alert-dialog-cancel>
                                <pl-button variant={% "outline" %} type={% "button" %}>Cancel</pl-button>
                            </pl-alert-dialog-cancel>
                            {#
                                Deliberately NOT pl-alert-dialog-action: its click handler closes
                                the dialog synchronously, detaching the button before its default
                                action (the form submission) runs. The navigation closes it instead.
                            #}
                            <pl-button variant={% variant == "ghost" ? "destructive" : variant %} type={% "submit" %} form={% formId %}>{{ label }}</pl-button>
                        </pl-alert-dialog-footer>
                    </pl-alert-dialog-content>
                </pl-alert-dialog>
            {% else %}
                <pl-button variant={% variant %} size={% size %} type={% "submit" %}>{{ label }}</pl-button>
            {% /if %}
        </form>
    }
} %}
