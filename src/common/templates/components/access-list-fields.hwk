{% tag HhAccessListFields {

    public name: String = ""
    public satisfy: String = "any"
    public basicAuthUser: String = ""
    public basicAuthPass: String = ""
    public allowedIps: String = ""
    public deniedIps: String = ""

    template {
        <div class="hh-form-group">
            <pl-label target="name">Name</pl-label>
            <pl-input id="name" type={% "text" %} name={% "name" %} value={% name %} placeholder={% "Staging Access" %} required={% true %}></pl-input>
        </div>

        <div class="hh-form-group">
            <pl-label target="satisfy">Satisfy</pl-label>
            <pl-select name="satisfy" value={% satisfy %}>
                <pl-select-trigger placeholder="Satisfy"></pl-select-trigger>
                <pl-select-content>
                    <pl-select-item value="any" label="Any (IP or Auth)">Any (IP or Auth)</pl-select-item>
                    <pl-select-item value="all" label="All (IP and Auth)">All (IP and Auth)</pl-select-item>
                </pl-select-content>
            </pl-select>
            <p class="hh-form-hint">Any: pass if IP matches OR auth succeeds. All: both must pass.</p>
        </div>

        <pl-separator></pl-separator>

        <div class="hh-form-group">
            <pl-label target="basic-auth-user">Basic Auth Username</pl-label>
            <pl-input id="basic-auth-user" type={% "text" %} name={% "basic_auth_user" %} value={% basicAuthUser %} placeholder={% "Leave empty for no auth" %}></pl-input>
        </div>

        <div class="hh-form-group">
            <pl-label target="basic-auth-pass">Basic Auth Password</pl-label>
            <pl-input id="basic-auth-pass" type={% "password" %} name={% "basic_auth_pass" %} value={% basicAuthPass %}></pl-input>
        </div>

        <pl-separator></pl-separator>

        <div class="hh-form-group">
            <pl-label target="allowed-ips">Allowed IPs</pl-label>
            <pl-textarea id="allowed-ips" name={% "allowed_ips" %} value={% allowedIps %} placeholder={% "One per line, e.g.\n192.168.1.0/24\n10.0.0.1" %}></pl-textarea>
            <p class="hh-form-hint">One IP or CIDR per line. Leave empty to allow all.</p>
        </div>

        <div class="hh-form-group">
            <pl-label target="denied-ips">Denied IPs</pl-label>
            <pl-textarea id="denied-ips" name={% "denied_ips" %} value={% deniedIps %} placeholder={% "One per line" %}></pl-textarea>
            <p class="hh-form-hint">One IP or CIDR per line. Deny takes priority over allow.</p>
        </div>
    }
} %}
