{% tag HhDockerSettings {

    public form: SiteFormData = null

    template {
        {%
            let settings = form.settings
            let image = settings.getString("image", "")
            let imageTag = settings.getString("tag", "")
            let containerPort = settings.getString("container_port", "")
            let command = settings.getString("command", "")
            let dockerfile = settings.getString("dockerfile", "")
            let server = settings.getString("server", "")
        %}
        <div class="hh-form-section">
            <div class="hh-form-row">
                <pl-field class="hh-form-group--grow">
                    <pl-label>Image</pl-label>
                    <pl-input type={% "text" %} name={% "image" %} value={% image %} placeholder={% "nginx" %}></pl-input>
                    <pl-field-description>Leave empty for a git-sourced site; the image is built from its Dockerfile.</pl-field-description>
                </pl-field>
                <pl-field>
                    <pl-label>Tag</pl-label>
                    <pl-input type={% "text" %} name={% "tag" %} value={% imageTag %} placeholder={% "latest" %}></pl-input>
                </pl-field>
                <pl-field class="hh-form-group--port">
                    <pl-label>Container Port</pl-label>
                    <pl-input type={% "number" %} name={% "container_port" %} value={% containerPort %} placeholder={% "80" %} min={% "1" %} max={% "65535" %}></pl-input>
                </pl-field>
            </div>
            <pl-field>
                <pl-label>Command Override</pl-label>
                <pl-input type={% "text" %} name={% "command" %} value={% command %} placeholder={% "(image default)" %}></pl-input>
                <pl-field-description>Overrides the image's default command (space-separated).</pl-field-description>
            </pl-field>
            <pl-field>
                <pl-label>Dockerfile Path</pl-label>
                <pl-input type={% "text" %} name={% "dockerfile" %} value={% dockerfile %} placeholder={% "Dockerfile" %}></pl-input>
                <pl-field-description>Used only for git-sourced sites (path within the checkout).</pl-field-description>
            </pl-field>
            <div class="hh-form-group">
                <pl-label>Environment Variables</pl-label>
                <hh-key-value-editor initialPairs={% form.environmentVariables %} namePrefix={% "environment_variables" %} namePlaceholder={% "NAME" %} valuePlaceholder={% "value" %}></hh-key-value-editor>
            </div>
            <pl-field>
                <pl-label>Server</pl-label>
                <pl-select name="server" value={% server %}>
                    <pl-select-trigger placeholder="local"></pl-select-trigger>
                    <pl-select-content>
                        {% each form.servers as srvIndex, srvName %}
                        <pl-select-item value={% srvName %} label={% srvName %}>{{ srvName }}</pl-select-item>
                        {% /each %}
                    </pl-select-content>
                </pl-select>
                <pl-field-description>Registered server name to run on; leave empty for the local host.</pl-field-description>
            </pl-field>
        </div>
    }
} %}
