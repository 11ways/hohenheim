{% tag HhDockerSettings {

    public settings: Map = null

    template {
        {%
            let image = settings != null && settings.get("image") != null ? settings.get("image") + "" : ""
            let imageTag = settings != null && settings.get("tag") != null ? settings.get("tag") + "" : ""
            let containerPort = settings != null && settings.get("container_port") != null ? settings.get("container_port") + "" : ""
            let command = settings != null && settings.get("command") != null ? settings.get("command") + "" : ""
            let dockerfile = settings != null && settings.get("dockerfile") != null ? settings.get("dockerfile") + "" : ""
            let server = settings != null && settings.get("server") != null ? settings.get("server") + "" : ""
        %}
        <div class="hh-form-section">
            <div class="hh-form-row">
                <div class="hh-form-group hh-form-group--grow">
                    <pl-label target="docker-image">Image</pl-label>
                    <pl-input id="docker-image" type={% "text" %} name={% "image" %} value={% image %} placeholder={% "nginx" %}></pl-input>
                    <p class="hh-form-hint">Leave empty for a git-sourced site; the image is built from its Dockerfile.</p>
                </div>
                <div class="hh-form-group">
                    <pl-label target="docker-tag">Tag</pl-label>
                    <pl-input id="docker-tag" type={% "text" %} name={% "tag" %} value={% imageTag %} placeholder={% "latest" %}></pl-input>
                </div>
                <div class="hh-form-group hh-form-group--port">
                    <pl-label target="docker-port">Container Port</pl-label>
                    <pl-input id="docker-port" type={% "number" %} name={% "container_port" %} value={% containerPort %} placeholder={% "80" %} min={% "1" %} max={% "65535" %}></pl-input>
                </div>
            </div>
            <div class="hh-form-group">
                <pl-label target="docker-command">Command Override</pl-label>
                <pl-input id="docker-command" type={% "text" %} name={% "command" %} value={% command %} placeholder={% "(image default)" %}></pl-input>
                <p class="hh-form-hint">Overrides the image's default command (space-separated).</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="docker-dockerfile">Dockerfile Path</pl-label>
                <pl-input id="docker-dockerfile" type={% "text" %} name={% "dockerfile" %} value={% dockerfile %} placeholder={% "Dockerfile" %}></pl-input>
                <p class="hh-form-hint">Used only for git-sourced sites (path within the checkout).</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="docker-server">Server</pl-label>
                <pl-input id="docker-server" type={% "text" %} name={% "server" %} value={% server %} placeholder={% "local" %}></pl-input>
                <p class="hh-form-hint">Registered server name to run on; leave empty for the local host.</p>
            </div>
        </div>
    }
} %}
