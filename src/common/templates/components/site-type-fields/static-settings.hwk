{% tag HhStaticSettings {

    public settings: Map = null

    template {
        {%
            let rootPath = settings.getString("root_path", "")
            let fallbackFile = settings.getString("fallback_file", "")
            let indexes = settings.getBoolean("indexes", true)
            let autoindex = settings.getBoolean("autoindex", false)
            let showHiddenFiles = settings.getBoolean("show_hidden_files", false)
            let staticDelay = settings.getString("delay", "")
        %}
        <div class="hh-form-section">
            <pl-field>
                <pl-label>Root Directory</pl-label>
                <pl-input type={% "text" %} name={% "root_path" %} value={% rootPath %} placeholder={% "/var/www/html" %}></pl-input>
            </pl-field>
            <pl-field>
                <pl-label>SPA Fallback File</pl-label>
                <pl-input type={% "text" %} name={% "fallback_file" %} value={% fallbackFile %} placeholder={% "index.html" %}></pl-input>
            </pl-field>
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="indexes" name="indexes" checked={% indexes %}></pl-checkbox>
                <pl-label target="indexes">Use index.html for directories</pl-label>
            </div>
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="autoindex" name="autoindex" checked={% autoindex %}></pl-checkbox>
                <pl-label target="autoindex">Show directory listing</pl-label>
            </div>
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="show_hidden_files" name="show_hidden_files" checked={% showHiddenFiles %}></pl-checkbox>
                <pl-label target="show_hidden_files">Show hidden files</pl-label>
            </div>
            <pl-field>
                <pl-label>Request Delay (ms)</pl-label>
                <pl-input type={% "number" %} name={% "delay" %} value={% staticDelay %} placeholder={% "0" %}></pl-input>
            </pl-field>
        </div>
    }
} %}
