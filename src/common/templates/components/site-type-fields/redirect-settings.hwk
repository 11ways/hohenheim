{% tag HhRedirectSettings {

    public settings: Map = null

    template {
        {%
            let targetUrl = settings.getString("target_url", "")
            let httpStatus = settings.getString("http_status", "302")
            let redirectDelay = settings.getString("delay", "")
        %}
        <div class="hh-form-section">
            <pl-field>
                <pl-label>Target URL</pl-label>
                <pl-input type={% "text" %} name={% "target_url" %} value={% targetUrl %} placeholder={% "https://example.com" %}></pl-input>
            </pl-field>
            <pl-field>
                <pl-label>Status Code</pl-label>
                <pl-select name="http_status" value={% httpStatus %}>
                    <pl-select-trigger placeholder="Status Code"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="302" label="302 Found (temporary)">302 Found (temporary)</pl-select-item>
                        <pl-select-item value="301" label="301 Permanent">301 Permanent</pl-select-item>
                        <pl-select-item value="307" label="307 Temporary Redirect">307 Temporary Redirect</pl-select-item>
                        <pl-select-item value="308" label="308 Permanent Redirect">308 Permanent Redirect</pl-select-item>
                    </pl-select-content>
                </pl-select>
            </pl-field>
            <pl-field>
                <pl-label>Request Delay (ms)</pl-label>
                <pl-input type={% "number" %} name={% "delay" %} value={% redirectDelay %} placeholder={% "0" %}></pl-input>
            </pl-field>
        </div>
    }
} %}
