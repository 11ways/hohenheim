{% tag HhNodeSettings {

    public settings: Map = null
    public environmentVariables: List = null
    public apiKeys: List = null
    public nodeVersions: List = null
    public systemUsers: List = null

    template {
        {%
            let script = settings.getString("script", "")
            let nodeVersionId = settings.getString("node_version_id", "")
            let systemUserId = settings.getString("system_user_id", "")
            let minimumProcesses = settings.getString("minimum_processes", "1")
            let maximumProcesses = settings.getString("maximum_processes", "5")
            let waitForReady = settings.getBoolean("wait_for_ready", false)
            let nodeDelay = settings.getString("delay", "")
        %}
        <div class="hh-form-section">
            <pl-field>
                <pl-label>Script Path</pl-label>
                <pl-input type={% "text" %} name={% "script" %} value={% script %} placeholder={% "/path/to/app.js" %}></pl-input>
                <pl-field-description>Absolute path to the entry script.</pl-field-description>
            </pl-field>
            <pl-field>
                <pl-label>Node Binary</pl-label>
                <pl-select name="node_version_id" value={% nodeVersionId %}>
                    <pl-select-trigger placeholder="System default"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="" label="System default">System default (node)</pl-select-item>
                        {% each nodeVersions as index, nv %}
                            <pl-select-item value={% nv.get("id") + "" %} label={% "Node " + nv.get("version") %}>Node {{ nv.get("version") }} ({{ nv.get("path") }})</pl-select-item>
                        {% /each %}
                    </pl-select-content>
                </pl-select>
            </pl-field>
            <pl-field>
                <pl-label>Run As User</pl-label>
                <pl-select name="system_user_id" value={% systemUserId %}>
                    <pl-select-trigger placeholder="Current user"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="" label="Current user">Current user</pl-select-item>
                        {% each systemUsers as index, su %}
                            <pl-select-item value={% su.get("id") + "" %} label={% su.get("name") %}>{{ su.get("name") }} (uid {{ su.get("uid") }})</pl-select-item>
                        {% /each %}
                    </pl-select-content>
                </pl-select>
                <pl-field-description>Run child processes as a different system user.</pl-field-description>
            </pl-field>
            <div class="hh-form-row">
                <pl-field>
                    <pl-label>Min Processes</pl-label>
                    <pl-input type={% "number" %} name={% "minimum_processes" %} value={% minimumProcesses %} placeholder={% "1" %} min={% "1" %} max={% "20" %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-label>Max Processes</pl-label>
                    <pl-input type={% "number" %} name={% "maximum_processes" %} value={% maximumProcesses %} placeholder={% "5" %} min={% "1" %} max={% "20" %}></pl-input>
                </pl-field>
            </div>
            {#
                Composite/grouped controls stay on hh-form-group: pl-field publishes a single control id
                via its plumage.field.id statekey, which descendant pl-inputs inherit -- the multi-input
                key-value editors and the checkbox would get duplicate/incorrect ids inside a pl-field.
            #}
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="wait_for_ready" name="wait_for_ready" checked={% waitForReady %}></pl-checkbox>
                <pl-label target="wait_for_ready">Wait For Ready Signal</pl-label>
                <p class="hh-form-hint">Only enable this when the child process sends a ready signal.</p>
            </div>
            <div class="hh-form-group">
                <pl-label>Environment Variables</pl-label>
                <hh-key-value-editor initialPairs={% environmentVariables %} namePrefix={% "environment_variables" %} namePlaceholder={% "NAME" %} valuePlaceholder={% "value" %}></hh-key-value-editor>
            </div>
            <div class="hh-form-group">
                <pl-label>API Keys</pl-label>
                <hh-key-value-editor initialPairs={% apiKeys %} namePrefix={% "api_keys" %} valueOnly={% true %} valuePlaceholder={% "Enter a key" %}></hh-key-value-editor>
                <p class="hh-form-hint">Keys for X-Hohenheim-Key header control.</p>
            </div>
            <pl-field>
                <pl-label>Request Delay (ms)</pl-label>
                <pl-input type={% "number" %} name={% "delay" %} value={% nodeDelay %} placeholder={% "0" %}></pl-input>
            </pl-field>
        </div>
    }
} %}
