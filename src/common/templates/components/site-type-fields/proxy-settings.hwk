{% tag HhProxySettings {

    public form: SiteFormData = null

    template {
        {%
            let settings = form.settings
            let forwardScheme = settings.getString("forward_scheme", "http")
            let forwardHost = settings.getString("forward_host", "")
            let forwardPort = settings.getString("forward_port", "")
            let proxySocket = settings.getString("socket", "")
            let websocketUpgrade = settings.getBoolean("websocket_upgrade", true)
            let ignoreCertificates = settings.getBoolean("ignore_certificates", false)
            let rewriteLocation = settings.getBoolean("rewrite_location", true)
            let proxyDelay = settings.getString("delay", "")
        %}
        <div class="hh-form-section">
            <div class="hh-form-row">
                <pl-field class="hh-form-group--grow">
                    <pl-label>Scheme</pl-label>
                    <pl-select name="forward_scheme" value={% forwardScheme %}>
                        <pl-select-trigger placeholder="Scheme"></pl-select-trigger>
                        <pl-select-content>
                            <pl-select-item value="http" label="HTTP">HTTP</pl-select-item>
                            <pl-select-item value="https" label="HTTPS">HTTPS</pl-select-item>
                        </pl-select-content>
                    </pl-select>
                </pl-field>
                <pl-field class="hh-form-group--grow">
                    <pl-label>Upstream Host</pl-label>
                    <pl-input type={% "text" %} name={% "forward_host" %} value={% forwardHost %} placeholder={% "127.0.0.1" %}></pl-input>
                </pl-field>
                <pl-field class="hh-form-group--port">
                    <pl-label>Port</pl-label>
                    <pl-input type={% "number" %} name={% "forward_port" %} value={% forwardPort %} placeholder={% "3000" %} min={% "1" %} max={% "65535" %}></pl-input>
                </pl-field>
            </div>
            <pl-field>
                <pl-label>Unix Socket Path</pl-label>
                <pl-input type={% "text" %} name={% "socket" %} value={% proxySocket %} placeholder={% "/run/app.sock" %}></pl-input>
                <pl-field-description>Forward to a Unix socket instead of TCP host and port.</pl-field-description>
            </pl-field>
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="websocket_upgrade" name="websocket_upgrade" checked={% websocketUpgrade %}></pl-checkbox>
                <pl-label target="websocket_upgrade">WebSocket Proxying</pl-label>
                <p class="hh-form-hint">Proxy WebSocket upgrade requests to upstream.</p>
            </div>
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="ignore_certificates" name="ignore_certificates" checked={% ignoreCertificates %}></pl-checkbox>
                <pl-label target="ignore_certificates">Ignore upstream TLS errors</pl-label>
                <p class="hh-form-hint">Skip certificate verification when proxying to HTTPS upstreams.</p>
            </div>
            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="rewrite_location" name="rewrite_location" checked={% rewriteLocation %}></pl-checkbox>
                <pl-label target="rewrite_location">Rewrite redirect Location headers</pl-label>
                <p class="hh-form-hint">Replace the upstream host in redirects with the public hostname so the backend address never leaks.</p>
            </div>
            <pl-field>
                <pl-label>Request Delay (ms)</pl-label>
                <pl-input type={% "number" %} name={% "delay" %} value={% proxyDelay %} placeholder={% "0" %}></pl-input>
            </pl-field>
        </div>
    }
} %}
