{% tag HhProxySettings {

    public settings: Map = null

    template {
        {%
            let forwardScheme = settings.getString("forward_scheme", "http")
            let forwardHost = settings.getString("forward_host", "")
            let forwardPort = settings.getString("forward_port", "")
            let proxySocket = settings.getString("socket", "")
            let websocketUpgrade = settings.getBoolean("websocket_upgrade", true)
            let ignoreCertificates = settings.getBoolean("ignore_certificates", false)
            let proxyDelay = settings.getString("delay", "")
        %}
        <div class="hh-form-section">
            <div class="hh-form-row">
                <div class="hh-form-group hh-form-group--grow">
                    <pl-label target="forward-scheme">Scheme</pl-label>
                    <pl-select id="forward-scheme" name="forward_scheme" value={% forwardScheme %}>
                        <pl-select-trigger placeholder="Scheme"></pl-select-trigger>
                        <pl-select-content>
                            <pl-select-item value="http" label="HTTP">HTTP</pl-select-item>
                            <pl-select-item value="https" label="HTTPS">HTTPS</pl-select-item>
                        </pl-select-content>
                    </pl-select>
                </div>
                <div class="hh-form-group hh-form-group--grow">
                    <pl-label target="forward-host">Upstream Host</pl-label>
                    <pl-input id="forward-host" type={% "text" %} name={% "forward_host" %} value={% forwardHost %} placeholder={% "127.0.0.1" %}></pl-input>
                </div>
                <div class="hh-form-group hh-form-group--port">
                    <pl-label target="forward-port">Port</pl-label>
                    <pl-input id="forward-port" type={% "number" %} name={% "forward_port" %} value={% forwardPort %} placeholder={% "3000" %} min={% "1" %} max={% "65535" %}></pl-input>
                </div>
            </div>
            <div class="hh-form-group">
                <pl-label target="proxy-socket">Unix Socket Path</pl-label>
                <pl-input id="proxy-socket" type={% "text" %} name={% "socket" %} value={% proxySocket %} placeholder={% "/run/app.sock" %}></pl-input>
                <p class="hh-form-hint">Forward to a Unix socket instead of TCP host and port.</p>
            </div>
            <div class="hh-form-group">
                <label class="hh-checkbox-label">
                    <input type="checkbox" name="websocket_upgrade" checked={% websocketUpgrade %}>
                    <span>WebSocket Proxying</span>
                </label>
                <p class="hh-form-hint">Proxy WebSocket upgrade requests to upstream.</p>
            </div>
            <div class="hh-form-group">
                <label class="hh-checkbox-label">
                    <input type="checkbox" name="ignore_certificates" checked={% ignoreCertificates %}>
                    <span>Ignore upstream TLS errors</span>
                </label>
                <p class="hh-form-hint">Skip certificate verification when proxying to HTTPS upstreams.</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="proxy-delay">Request Delay (ms)</pl-label>
                <pl-input id="proxy-delay" type={% "number" %} name={% "delay" %} value={% proxyDelay %} placeholder={% "0" %}></pl-input>
            </div>
        </div>
    }
} %}
