{% tag HhBoolBadge {

    public value: Boolean = false
    public onLabel: String = "Yes"
    public offLabel: String = "No"
    public onVariant: String = "default"
    public offVariant: String = "outline"

    template {
        {% if value == true %}
            <pl-badge variant={% onVariant %}>{{ onLabel }}</pl-badge>
        {% else %}
            <pl-badge variant={% offVariant %}>{{ offLabel }}</pl-badge>
        {% /if %}
    }
} %}
