{% tag HhProxyStatusBadge {

    public status: String = ""

    template {
        {% if status |> String.startsWith("Failed") %}
            <pl-badge variant={% "destructive" %}>{{ status }}</pl-badge>
        {% elseif status |> String.startsWith("Running") %}
            <pl-badge variant={% "default" %}>{{ status }}</pl-badge>
        {% else %}
            <pl-badge variant={% "outline" %}>{{ status }}</pl-badge>
        {% /if %}
    }
} %}
