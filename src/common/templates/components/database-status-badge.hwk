{% tag HhDatabaseStatusBadge {

    public status: String = ""
    public running: Boolean = false
    public port: Integer = 0

    template {
        {% if status == "provisioning" %}
            <pl-badge variant={% "secondary" %}>Provisioning</pl-badge>
        {% elseif status == "failed" %}
            <pl-badge variant={% "destructive" %}>Failed</pl-badge>
        {% elseif running == true %}
            <pl-badge variant={% "default" %}>Running{% if port > 0 %} {{ port }}{% /if %}</pl-badge>
        {% else %}
            <pl-badge variant={% "outline" %}>Stopped</pl-badge>
        {% /if %}
    }
} %}
