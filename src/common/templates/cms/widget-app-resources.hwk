{#- An app's measured resources: each gauge is the framework's own usage partial, so NOT MEASURED stays an answer and
    never a bar at zero. -#}
{% declare widget: WidgetInstance %}
{% declare data: List<AppUsage> = null %}
{% let title = t("resources", scope: "app_overview") %}
<pl-card class="widget hh-app-card" data-app-card="resources">
    {% render "hohenheim:cms/app-card-header" var:title=title %}
    <pl-card-content class="hh-app-card-stack">
        {% each data as gauge %}
        <div class="hh-app-usage" data-app-usage>
            <span class="hh-app-usage-label">{{ gauge.label }}</span>
            {% render "zenitwidget:widget-display/usage-bar" var:widget=widget var:data=gauge.usage %}
        </div>
        {% /each %}
    </pl-card-content>
</pl-card>
