{#- Stats tab on an instance: live CPU / memory / network, seeded server-side from the
    hub's ring and kept live by the instance-stats channel through the mounted
    hh-instance-stats element. No script tag anywhere. -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare instanceId: Integer %}
{% declare running: Boolean = false %}
{% declare cpuSeed: List %}
{% declare memorySeed: List %}
{% declare rxSeed: List %}
{% declare txSeed: List %}
{% declare disk: InstanceDiskView %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ instanceName }}</h1>
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {#- The CONTRACT, stated rather than implied: the rings below are live-only (nothing
        is stored, by decision), and the one PERSISTED figure -- the disk sweeper's
        observation -- exists only on a runtime that enforces a root quota. -#}
    <pl-alert variant="default" data-stats-contract="1">{{ t("live_only", scope: "instance_stats") }}</pl-alert>

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("disk", scope: "instance_stats") }}</pl-card-title>
            <pl-card-description>{{ t("disk_description", scope: "instance_stats") }}</pl-card-description>
        </pl-card-header>
        {% if disk.measured && disk.enforced %}
        <pl-card-content data-disk-state="measured">
            <pl-usage-bar value={% disk.percent %} max={% 100 %} showLabel={% true %}></pl-usage-bar>
            <p>{{ disk.usedBytes }} B / {{ disk.limitBytes }} B</p>
        </pl-card-content>
        {% else %}
        <pl-card-content data-disk-state="not-measured">
            <p class="hh-disk-unmeasured">
                <pl-badge variant="secondary">{{ t("not_measured", scope: "instance_stats") }}</pl-badge>
                {{ t("not_measured_body", scope: "instance_stats", runtime: disk.runtime) }}
            </p>
        </pl-card-content>
        {% /if %}
    </pl-card>

    {% if running %}
    {#- The element owns the whole live half: seeds render server-side, the channel link
        is opened in its @mount and closed by its Cleanup.on, so hard loads, soft
        navigations and navigations AWAY all do the right thing with no script tag. -#}
    <hh-instance-stats instanceId={% instanceId %}
                       cpuSeed={% cpuSeed %}
                       memorySeed={% memorySeed %}
                       rxSeed={% rxSeed %}
                       txSeed={% txSeed %}></hh-instance-stats>
    {% else %}
    <pl-empty-state icon="chart-line">
        <pl-empty-state-title>{{ t("not_running", scope: "instance_stats") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("not_running_description", scope: "instance_stats") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
