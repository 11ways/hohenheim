{# Dashboard attention panel: one row per operational state needing an
   operator, or a quiet all-clear. The server collector attaches typed items
   as runtime widget data; WidgetTree transport carries them transparently. #}
{% declare widget: WidgetInstance %}
{% declare data: List<AttentionItem> %}

{% snippet attentionContent(item: AttentionItem) %}
<span class="hh-attention-icon">
    <pl-icon name={% item.icon %} size="sm"></pl-icon>
</span>
<span class="hh-attention-body">
    <span class="hh-attention-title">{{ item.title }}</span>
    {% if item.detail != null %}
    <span class="hh-attention-detail">{{ item.detail }}</span>
    {% /if %}
</span>
{% /snippet %}

<div class="widget widget-attention hh-attention" data-attention-count={% "" + (data != null ? data.size() : 0) %}>
    <h3 class="widget-heading">{{ t("attention", scope: "dashboard") }}</h3>
    {% if data %}
    <ul class="hh-attention-list">
        {% each data as item %}
        <li class={% item.url != "" ? "hh-attention-item" : "hh-attention-item hh-attention-static" %}
            data-severity={% item.severity %}>
            {% if item.url != "" %}
            <a class="hh-attention-target" href={% item.url %}>
                {% render attentionContent(item) %}
                <span class="hh-attention-chevron" attr:aria-label={% Cms.text(t("open", scope: "attention")) %}>
                    <pl-icon name="chevron-right" size="sm"></pl-icon>
                </span>
            </a>
            {% else %}
            {% render attentionContent(item) %}
            {% /if %}
        </li>
        {% /each %}
    </ul>
    {% else %}
    <div class="hh-attention-clear">
        <pl-icon name="circle-check" size="lg"></pl-icon>
        <span>{{ t("all_clear", scope: "dashboard") }}</span>
    </div>
    {% /if %}
</div>
