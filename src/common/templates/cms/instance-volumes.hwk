{#- Volumes tab on a volume-mounting instance: each declared host directory with its
    container path, quota, observed usage and exclusivity, linking into the
    (nav-hidden) volume resource forms. -#}
{% declare title: String %}
{% declare instanceId: Integer %}
{% declare instanceName: String %}
{% declare volumes: List %}
{% declare addVolumeTarget: RouteTarget = null %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ instanceName }}</h1>
        {% if addVolumeTarget %}
        <pl-button variant="primary" use:Zenit.route={% addVolumeTarget %} id="add-volume-link">{{ t("add", scope: "instance_volume") }}</pl-button>
        {% /if %}
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    <p class="hh-tab-hint">{{ t("tab_hint", scope: "instance_volume") }}</p>

    {% if volumes %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("name", scope: "field") }}</pl-table-head>
            <pl-table-head>{{ t("container_path", scope: "field") }}</pl-table-head>
            <pl-table-head>{{ t("usage", scope: "instance_volume") }}</pl-table-head>
            <pl-table-head>{{ t("quota", scope: "instance_volume") }}</pl-table-head>
            <pl-table-head></pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each volumes as index, volume %}
            <pl-table-row>
                <pl-table-cell>
                    {% if addVolumeTarget %}<a use:Zenit.route={% volume.get("editTarget") %}>{{ volume.get("name") }}</a>{% else %}{{ volume.get("name") }}{% /if %}
                </pl-table-cell>
                <pl-table-cell><code>{{ volume.get("containerPath") }}</code></pl-table-cell>
                <pl-table-cell>
                    {% if volume.get("usedText") != "" %}
                    {{ volume.get("usedText") }}
                    {% else %}
                    <span class="hh-muted">{{ t("never_measured", scope: "instance_volume") }}</span>
                    {% /if %}
                </pl-table-cell>
                <pl-table-cell>
                    {% if volume.get("quotaText") != "" %}
                    {{ volume.get("quotaText") }}
                    {% else %}
                    <span class="hh-muted">{{ t("no_quota", scope: "instance_volume") }}</span>
                    {% /if %}
                </pl-table-cell>
                <pl-table-cell>
                    {% if volume.get("exclusive") == true %}
                    <pl-badge variant="warning">{{ t("exclusive", scope: "instance_volume") }}</pl-badge>
                    {% /if %}
                </pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="database">
        <pl-empty-state-title>{{ t("empty", scope: "instance_volume") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "instance_volume") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
