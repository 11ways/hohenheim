{#- Dev sessions tab on a dev-namespace site: the live tunnel registrations, and once a token made for the viewer. -#}
{% declare title: String %}
{% declare siteName: String %}
{% declare sessions: List %}
{% declare head: RecordHeadState = null %}
{#- A registration token Hohenheim made for this viewer's account, shown once; empty when none waits. -#}
{% declare disclosedToken: String = "" %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page">
    {% if head != null %}{% render "zenitcms:record-head" var:head=head %}{% /if %}
    {% if disclosedToken %}
    <pl-one-time-secret heading={% t("registration_token_disclosure_title", scope: "site") %} warning={% t("registration_token_disclosure_warning", scope: "site") %} value={% disclosedToken %}></pl-one-time-secret>
    {% /if %}

    {% if sessions %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("name", scope: "dev_sessions") }}</pl-table-head>
            <pl-table-head>{{ t("url", scope: "dev_sessions") }}</pl-table-head>
            <pl-table-head>{{ t("connected_since", scope: "dev_sessions") }}</pl-table-head>
            <pl-table-head>{{ t("active_streams", scope: "dev_sessions") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each sessions as index, session %}
            <pl-table-row>
                <pl-table-cell><code>{{ session.get("name") }}</code></pl-table-cell>
                <pl-table-cell>
                    <a href={% session.get("origin") %} target="_blank" rel="noopener">{{ session.get("origin") }}</a>
                </pl-table-cell>
                <pl-table-cell><pl-relative-time datetime={% session.get("registeredAtIso") %} units="one"></pl-relative-time></pl-table-cell>
                <pl-table-cell>{{ session.get("streams") }}</pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="flask">
        <pl-empty-state-title>{{ t("empty", scope: "dev_sessions") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_hint", scope: "dev_sessions") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
