{#- Credentials tab on a managed database: the one delegated surface the `credentials`
    capability gates. Every address is resolved live, never stored. -#}
{% declare name: String %}
{% declare engine: String %}
{% declare status: String %}
{% declare dbUser: String %}
{% declare dbPassword: String %}
{% declare dbName: String %}
{% declare containerHost: String = "" %}
{% declare port: String = "" %}
{% declare head: RecordHeadState = null %}
{% extend "zenitcms:shell" var:title=name %}

{% block "main" %}
<section class="cms-resource-form-page">
    {% if head != null %}{% render "zenitcms:record-head" var:head=head %}{% /if %}

    {% render "hohenheim:cms/database-connection" var:engine=engine var:status=status var:dbName=dbName var:dbUser=dbUser
        var:dbPassword=dbPassword var:containerHost=containerHost var:port=port %}
</section>
{% /block %}
