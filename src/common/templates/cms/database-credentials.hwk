{#- Credentials tab on a managed database: the one delegated surface the `credentials`
    capability gates. Every address is resolved live, never stored. -#}
{% declare name: String %}
{% declare engine: String %}
{% declare status: String %}
{% declare dbUser: String %}
{% declare dbPassword: String %}
{% declare dbName: String %}
{% declare containerHost: String = "" %}
{% declare port: String = "" %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% extend "zenitcms:shell" var:title=name var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-form-page">
    <header class="cms-resource-list-header">
        <h1>{{ t("credentials_title", scope: "database_tab", name: name) }}</h1>
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("connection", scope: "database_tab") }}</pl-card-title>
            <pl-card-description>{{ t("status", scope: "database_tab", status: status) }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <pl-table>
                <pl-table-body>
                    <pl-table-row>
                        <pl-table-cell>{{ t("engine", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>{{ engine }}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("database", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>{{ dbName }}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("user", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>{{ dbUser }}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("password", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>
                            <code>{{ dbPassword }}</code>
                            <pl-copy-button value={% dbPassword %} ariaLabel={% t("copy_password", scope: "database_tab") %}></pl-copy-button>
                        </pl-table-cell>
                    </pl-table-row>
                    {% if containerHost != "" %}
                    <pl-table-row>
                        <pl-table-cell>{{ t("container_host", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell><code>{{ containerHost }}</code></pl-table-cell>
                    </pl-table-row>
                    {% /if %}
                    {% if port != "" %}
                    <pl-table-row>
                        <pl-table-cell>{{ t("port", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell><code>{{ port }}</code></pl-table-cell>
                    </pl-table-row>
                    {% /if %}
                </pl-table-body>
            </pl-table>
        </pl-card-content>
    </pl-card>
</section>
{% /block %}
