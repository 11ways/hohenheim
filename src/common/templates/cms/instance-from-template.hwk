{#- Create an instance from a template: without a selected template, the chooser of the templates the viewer may
    create from; with one, its fixed summary and the wizard document (details, then the template's variables) the
    framework draws for the PAGE action, submitted once through the hosting panel's invoke route. -#}
{% declare title: String %}
{% declare document: PageFormState = null %}
{% declare templateName: String = "" %}
{% declare templateDescription: String = "" %}
{% declare approved: Boolean = false %}
{% declare hasInstall: Boolean = false %}
{% declare choices: List = null %}
{% declare cancelTarget: RouteTarget %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-form-page">
    {% if document != null %}
    <header class="cms-resource-list-header">
        <h1>{{ t("create_from", scope: "instance_from_template") }} {{ templateName }}</h1>
    </header>

    {% if templateDescription != "" %}<p>{{ templateDescription }}</p>{% /if %}
    {% if !approved %}
    <pl-alert variant="warning">{{ t("unapproved_note", scope: "instance_from_template") }}</pl-alert>
    {% /if %}
    {% if hasInstall %}
    <pl-alert variant="info">{{ t("install_note", scope: "instance_from_template") }}</pl-alert>
    {% /if %}

    {% render "zenitcms:form/page-action" var:page=document %}
    {% else %}
    <header class="cms-resource-list-header">
        <h1>{{ title }}</h1>
    </header>
    <pl-card><pl-card-content>
        <ul class="hh-template-choices" data-hh-template-choices>
            {% each choices as index, choice %}
            <li><a use:Zenit.route={% choice.get("target") %}>{{ choice.get("name") }}</a></li>
            {% /each %}
        </ul>
    </pl-card-content></pl-card>
    {% /if %}
    <pl-button variant="ghost" use:Zenit.route={% cancelTarget %}>{{ t("cancel", scope: "instance_from_template") }}</pl-button>
</section>
{% /block %}
