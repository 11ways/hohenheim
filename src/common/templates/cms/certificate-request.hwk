{#- Let's Encrypt HTTP-01 and DNS-01 request flow. Manual DNS orders stay
    in memory while the operator publishes every displayed TXT value. -#}
{% declare title: String %}
{% declare error: String = "" %}
{% declare domainForm: FormState %}
{% declare niceName: String = "" %}
{% declare dnsHookConfigured: Boolean = false %}
{% declare internalDnsAvailable: Boolean = false %}
{% declare manualToken: String = "" %}
{% declare dnsRecords: List<Map<String, Object>> %}
{% declare reissueCertId: Integer = 0 %}
{% declare challengeType: String = "http" %}
{% declare dnsMode: String = "manual" %}
{% declare accountEmail: String = "" %}
{% declare startOverTarget: RouteTarget %}
{% declare certificatesTarget: RouteTarget %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-form-page">
    <header class="cms-resource-list-header"><h1>{{ title }}</h1></header>

    {#- The toast rides the template vars the dispatch injects; the ambient
       Cms.flash*() channel is retired (invisible in client renders). -#}
    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}

    {% if error != "" %}<pl-alert variant="destructive">{{ error }}</pl-alert>{% /if %}

    {% if manualToken != "" %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("publish_records", scope: "certificate_request") }}</pl-card-title>
            <pl-card-description>{{ t("publish_description", scope: "certificate_request") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <pl-alert variant="warning">{{ t("manual_ephemeral", scope: "certificate_request") }}</pl-alert>
            <pl-table>
                <pl-table-header><pl-table-row>
                    <pl-table-head>{{ t("record_name", scope: "certificate_request") }}</pl-table-head>
                    <pl-table-head>{{ t("record_value", scope: "certificate_request") }}</pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body>
                    {% each dnsRecords as record %}
                    <pl-table-row>
                        <pl-table-cell><code>{{ record.name }}</code> <pl-copy-button value={% record.name %} ariaLabel={% t("copy_record_name", scope: "certificate_request") %}></pl-copy-button></pl-table-cell>
                        <pl-table-cell><code>{{ record.value }}</code> <pl-copy-button value={% record.value %} ariaLabel={% t("copy_record_value", scope: "certificate_request") %}></pl-copy-button></pl-table-cell>
                    </pl-table-row>
                    {% /each %}
                </pl-table-body>
            </pl-table>
        </pl-card-content>
    </pl-card>
    <form use:Zenit.form={% Zenit.Endpoints.hohenheim.certificates_request %}>
        <input type="hidden" name="manual_token" value={% manualToken %}>
        <div class="cms-form-actions">
            <pl-button variant="primary" type="submit">{{ t("verify_dns", scope: "certificate_request") }}</pl-button>
            <a use:Zenit.route={% startOverTarget %}>{{ t("start_over", scope: "certificate_request") }}</a>
        </div>
    </form>
    {% else %}
    <form use:Zenit.form={% Zenit.Endpoints.hohenheim.certificates_request %}>
        {#- The re-issue id is what makes this POST write back into an existing row
            instead of minting a new certificate. -#}
        {% if reissueCertId > 0 %}
        <input type="hidden" name="reissue_cert_id" value={% reissueCertId %}>
        <pl-alert variant="info">{{ t("reissue_notice", scope: "certificate_request") }}</pl-alert>
        {% /if %}
        <pl-card><pl-card-content><zf-form-scope><div class="zf-entries">
            <pl-field>
                <pl-label target="nice_name">{{ t("name", scope: "certificate_request") }}</pl-label>
                <pl-input inputId="nice_name" type="text" name="nice_name" value={% niceName %} placeholder={% t("name_placeholder", scope: "certificate_request") %}></pl-input>
            </pl-field>
            {% each domainForm.entries as entry %}
            {% render entry.templateId var:entry=entry %}
            {% /each %}
            <pl-field>
                <pl-label>{{ t("validation", scope: "certificate_request") }}</pl-label>
                <pl-select name="challenge_type" value={% challengeType %} submitEmpty={% true %}>
                    <pl-select-item value="http">HTTP-01</pl-select-item>
                    <pl-select-item value="dns">DNS-01</pl-select-item>
                </pl-select>
                <pl-field-description>{{ t("validation_help", scope: "certificate_request") }}</pl-field-description>
            </pl-field>
            <pl-field>
                <pl-label>{{ t("dns_mode", scope: "certificate_request") }}</pl-label>
                <pl-select name="dns_mode" value={% dnsMode %} submitEmpty={% true %}>
                    <pl-select-item value="manual">{{ t("manual", scope: "certificate_request") }}</pl-select-item>
                    <pl-select-item value="internal" disabled={% !internalDnsAvailable %}>{{ t("internal_dns", scope: "certificate_request") }}</pl-select-item>
                    <pl-select-item value="command" disabled={% !dnsHookConfigured %}>{{ t("automatic_hook", scope: "certificate_request") }}</pl-select-item>
                </pl-select>
                <pl-field-description>{% if internalDnsAvailable %}{{ t("internal_ready", scope: "certificate_request") }}{% else %}{{ t("internal_unavailable", scope: "certificate_request") }}{% /if %}</pl-field-description>
                <pl-field-description>{% if dnsHookConfigured %}{{ t("hook_ready", scope: "certificate_request") }}{% else %}{{ t("hook_missing", scope: "certificate_request") }}{% /if %}</pl-field-description>
            </pl-field>
            <pl-field>
                <pl-label target="letsencrypt_email">{{ t("account_email", scope: "certificate_request") }}</pl-label>
                <pl-input inputId="letsencrypt_email" type="email" name="letsencrypt_email" value={% accountEmail %}></pl-input>
                <pl-field-description>{{ t("account_email_help", scope: "certificate_request") }}</pl-field-description>
            </pl-field>
        </div></zf-form-scope></pl-card-content></pl-card>
        <div class="cms-form-actions">
            <pl-button variant="primary" type="submit">{% if reissueCertId > 0 %}{{ t("reissue_submit", scope: "certificate_request") }}{% else %}{{ t("request", scope: "certificate_request") }}{% /if %}</pl-button>
            <a use:Zenit.route={% certificatesTarget %}>{{ t("cancel", scope: "certificate_request") }}</a>
        </div>
    </form>
    {% /if %}
</section>
{% /block %}
