{% declare widget: WidgetInstance %}
{#- The site resource lives on the admin panel; bound through the typed CMS route,
    never a path literal. -#}
{% let newSiteTarget = BoundEndpoint.with(Endpoint.with(Zenit.Endpoints.cms.resource_create_form, Zenit.Params.cms.panel, "admin"), Zenit.Params.cms.resource, "sites") %}
<pl-empty-state>
    <pl-icon name="rocket"></pl-icon>
    <pl-empty-state-title>{{ t("title", scope: "onboarding") }}</pl-empty-state-title>
    <pl-empty-state-description>{{ t("description", scope: "onboarding") }}</pl-empty-state-description>
    <a use:Zenit.route={% newSiteTarget %}><pl-button variant="primary">{{ t("create_site", scope: "onboarding") }}</pl-button></a>
</pl-empty-state>
