{#- The dashboard's Apps band (board Main): every app by name, what it is and where, and whether HTTPS works for it,
    read from the one App directory the Apps list reads. -#}
{% declare widget: WidgetInstance %}
{% declare data: List<AppSummary> = null %}
{% if data != null and data %}
<section data-hh-dashboard-apps-band>
    <pl-section-header><h2>{{ t("apps", scope: "dashboard") }}</h2></pl-section-header>
    <pl-list variant="card" data-hh-dashboard-apps>
        {% each data as app %}
        <pl-list-item data-hh-dashboard-app={% app.name %}>
            <pl-list-item-title><a href={% app.url %} data-row-link>{{ app.name }}</a></pl-list-item-title>
            {% if app.detail != "" %}<pl-list-item-meta>{{ app.detail }}</pl-list-item-meta>{% /if %}
            <pl-list-item-trailing>{% render "hohenheim:cms/cell/site-tls" var:value=app.https %}</pl-list-item-trailing>
        </pl-list-item>
        {% /each %}
    </pl-list>
</section>
{% /if %}
