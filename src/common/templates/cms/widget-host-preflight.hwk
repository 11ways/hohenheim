{# The stored preflight report: the kernel-truth verdict, the checks that must pass before admission and the
   advice that never blocks (each with what did not pass first, what it found in words, its own stamp and how to fix
   it), and the measured facts in words with their units. The overall verdict sits in the header's action slot, apart
   from the "Last preflight" line. No live probe happens here -- this reads what the last check wrote. #}
{% declare widget: WidgetInstance %}
{% declare data: HostPreflightReportView = null %}

{% snippet preflightChecks(checks: List<PreflightCheckView>) %}
<pl-table>
    <pl-table-header><pl-table-row>
        <pl-table-head>{{ t("check", scope: "server_overview") }}</pl-table-head>
        <pl-table-head>{{ t("status", scope: "server_overview") }}</pl-table-head>
        <pl-table-head>{{ t("detail", scope: "server_overview") }}</pl-table-head>
        <pl-table-head>{{ t("checked_at", scope: "server_overview") }}</pl-table-head>
    </pl-table-row></pl-table-header>
    <pl-table-body>
        {% each checks as check %}
        <pl-table-row data-check={% check.name %}>
            <pl-table-cell>{{ check.label }}</pl-table-cell>
            <pl-table-cell><pl-badge variant={% check.statusVariant %} attr:data-status={% check.status %}>{{ check.statusLabel }}</pl-badge></pl-table-cell>
            <pl-table-cell class="hh-check-detail">
                {{ check.detail }}
                {% if check.fix != null %}
                <p class="hh-check-fix" data-fix="1"><strong>{{ t("how_to_fix", scope: "server_overview") }}</strong> {{ check.fix }}</p>
                {% /if %}
            </pl-table-cell>
            <pl-table-cell>
                {% if check.atIso != null %}
                <pl-relative-time datetime={% check.atIso %} title={% check.atIso %} units="one"></pl-relative-time>
                {% /if %}
            </pl-table-cell>
        </pl-table-row>
        {% /each %}
    </pl-table-body>
</pl-table>
{% /snippet %}

<pl-card class="widget hh-overview-card">
    <pl-card-header>
        <pl-card-title>{{ t("preflight_report", scope: "server_overview") }}</pl-card-title>
        {% if data != null && data.probedAtIso != null %}
        <pl-card-description>
            {{ t("last_preflight", scope: "server_overview") }}
            <pl-relative-time datetime={% data.probedAtIso %} title={% data.probedAtIso %} units="one"></pl-relative-time>
        </pl-card-description>
        <pl-card-header-actions>
            <pl-badge variant={% data.summaryVariant %} data-preflight-verdict="1">{{ data.summaryLabel }}</pl-badge>
        </pl-card-header-actions>
        {% /if %}
    </pl-card-header>
    <pl-card-content>
        {% if data != null && data.kernel != null %}
        <p class="hh-kernel-state" data-kernel-isolation="1">
            <span class="hh-trust-label">{{ t("kernel_isolation", scope: "server_overview") }}</span>
            {% if data.kernel.required == false %}
            <pl-badge variant="secondary">{{ t("kernel_not_required", scope: "server_overview") }}</pl-badge>
            {% elseif data.kernel.laneAvailable == false %}
            <pl-badge variant="destructive">{{ t("kernel_no_lane", scope: "server_overview") }}</pl-badge>
            {% elseif data.kernel.proven %}
            <pl-badge variant="success">{{ t("kernel_proven", scope: "server_overview") }}</pl-badge>
            {% if data.kernel.checkedAtIso != null %}
            <pl-relative-time datetime={% data.kernel.checkedAtIso %} title={% data.kernel.checkedAtIso %} units="one"></pl-relative-time>
            {% /if %}
            {% else %}
            <pl-badge variant="destructive">{{ t("kernel_unproven", scope: "server_overview") }}</pl-badge>
            {% /if %}
            {% if data.kernel.endpointNote != "" %}
            <span class="hh-kernel-endpoint">{{ t("kernel_endpoint_note", scope: "server_overview", socket: data.kernel.endpointNote) }}</span>
            {% /if %}
        </p>
        {% /if %}
        {% if data != null && data.mustPass.size() + data.advice.size() > 0 %}
        {#- What did not pass is drawn open, with its fix; what passed folds behind its count (board FO91,
            Host-Overview): thirty rows saying "Passed" hid the two that needed reading. -#}
        {% if data.attention.size() > 0 %}
        <p class="hh-checks-note">{{ t("advice_never_blocks", scope: "server_overview") }}</p>
        {% render preflightChecks(data.attention) %}
        {% /if %}
        {% if data.passing.size() > 0 %}
        <pl-collapsible data-preflight-passing="1">
            <pl-collapsible-trigger caret>{{ t("checks_passed", scope: "server_overview", count: data.passing.size()) }}</pl-collapsible-trigger>
            <pl-collapsible-content>
                {% render preflightChecks(data.passing) %}
            </pl-collapsible-content>
        </pl-collapsible>
        {% /if %}
        {% else %}
        <pl-empty-state icon="stethoscope">
            <pl-empty-state-title>{{ t("never_preflighted", scope: "server_overview") }}</pl-empty-state-title>
            <pl-empty-state-description>{{ t("never_preflighted_hint", scope: "server_overview") }}</pl-empty-state-description>
        </pl-empty-state>
        {% /if %}
        {% if data != null && data.facts %}
        <pl-collapsible data-preflight-facts="1">
            <pl-collapsible-trigger caret>{{ t("facts_measured", scope: "server_overview", count: data.facts.size()) }}</pl-collapsible-trigger>
            <pl-collapsible-content>
                <pl-table>
                    <pl-table-header><pl-table-row>
                        <pl-table-head>{{ t("fact", scope: "server_overview") }}</pl-table-head>
                        <pl-table-head>{{ t("value", scope: "server_overview") }}</pl-table-head>
                        <pl-table-head>{{ t("measured_at", scope: "server_overview") }}</pl-table-head>
                    </pl-table-row></pl-table-header>
                    <pl-table-body>
                        {% each data.facts as fact %}
                        <pl-table-row data-fact={% fact.name %}>
                            <pl-table-cell>{{ fact.label }}</pl-table-cell>
                            <pl-table-cell>{{ fact.value }}</pl-table-cell>
                            <pl-table-cell>
                                {% if fact.measuredAtIso != null %}
                                <pl-relative-time datetime={% fact.measuredAtIso %} title={% fact.measuredAtIso %} units="one"></pl-relative-time>
                                {% /if %}
                            </pl-table-cell>
                        </pl-table-row>
                        {% /each %}
                    </pl-table-body>
                </pl-table>
            </pl-collapsible-content>
        </pl-collapsible>
        {% /if %}
    </pl-card-content>
</pl-card>
