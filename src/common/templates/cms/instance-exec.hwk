{#- Exec tab on an instance: run ONE arbitrary command inside the workload and read
    its exit code and output. Separate from the console tab on purpose -- the console
    reaches the workload's own primary process, this starts a new program, and the two
    answer to different capabilities. The form is the exec operation's PAGE form, posted
    through the hosting panel's one invoke route. -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare instanceId: Integer %}
{% declare running: Boolean = false %}
{% declare execOutput: String = "" %}
{% declare execExit: String = "" %}
{% declare document: PageFormState = null %}
{% declare recordTabs: List<RecordTabState> %}
{% declare consoleModes: List<ConsoleModeView> %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
    <section class="cms-resource-list-page">
        <header class="cms-resource-list-header">
            <h1>{{ instanceName }}</h1>
        </header>

        {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

        {% render "hohenheim:cms/console-modes" var:modes=consoleModes %}

        {% if running %}
            <pl-card>
                <pl-card-content>
                    {% if document != null %}
                        {% render "zenitcms:form/page-action" var:page=document %}
                    {% /if %}
                    {% if execExit != "" %}
                        <p class="instance-exec-exit">{{ t("exit_code", scope: "instance_exec", code: execExit) }}</p>
                        <pl-log-view class="instance-exec-output" text={% execOutput %}
                                     label={% t("title", scope: "instance_exec") %}></pl-log-view>
                    {% /if %}
                </pl-card-content>
            </pl-card>
        {% else %}
            <pl-empty-state icon="code">
                <pl-empty-state-title>{{ t("not_running", scope: "instance_exec") }}</pl-empty-state-title>
                <pl-empty-state-description>{{ t("not_running_description", scope: "instance_exec") }}</pl-empty-state-description>
            </pl-empty-state>
        {% /if %}
    </section>
{% /block %}
