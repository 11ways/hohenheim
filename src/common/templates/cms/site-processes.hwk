{#- Processes tab on a managed site: the live process table with
    start/kill/isolate forms, the interactive terminal, and the stored
    process-log history. -#}
{% declare title: String %}
{% declare siteId: Integer %}
{% declare siteName: String %}
{% declare isManaged: Boolean = false %}
{% declare processes: List %}
{% declare proclogs: List %}
{% declare selectedLogHtml: String = "" %}
{% declare selectedLogTitle: String = "" %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ siteName }}</h1>
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if isManaged %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("title", scope: "site_processes") }}</pl-card-title>
            <pl-card-description>{{ t("description", scope: "site_processes") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            {% if processes %}
            <pl-table>
                <pl-table-header><pl-table-row>
                    <pl-table-head>{{ t("pid", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("port", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("clients", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("cpu", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("memory", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("status", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head></pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body>
                    {% each processes as index, proc %}
                    <pl-table-row>
                        <pl-table-cell>{{ proc.get("pid") }}</pl-table-cell>
                        <pl-table-cell>{{ proc.get("port") }}</pl-table-cell>
                        <pl-table-cell>{{ proc.get("fingerprints") }}</pl-table-cell>
                        <pl-table-cell>{{ proc.get("cpu") }}%</pl-table-cell>
                        <pl-table-cell>{{ proc.get("memoryMb") }} MB</pl-table-cell>
                        <pl-table-cell>
                            {% if proc.get("isolated") == true %}
                            <pl-badge variant={% "destructive" %}>{{ t("isolated", scope: "site_processes") }}</pl-badge>
                            {% else %}
                                {% if proc.get("ready") == true %}
                                <pl-badge variant={% "default" %}>{{ t("ready", scope: "site_processes") }}</pl-badge>
                                {% else %}
                                <pl-badge variant={% "secondary" %}>{{ t("starting", scope: "site_processes") }}</pl-badge>
                                {% /if %}
                            {% /if %}
                        </pl-table-cell>
                        <pl-table-cell>
                            <form method="POST" action={% "/sites/" + siteId + "/processes/" + proc.get("pid") + "/isolate" %} style="display:inline">
                                {% csrf() %}
                                <pl-button variant={% "outline" %} size={% "sm" %} type={% "submit" %}>{% if proc.get("isolated") == true %}{{ t("unisolate", scope: "site_processes") }}{% else %}{{ t("isolate", scope: "site_processes") }}{% /if %}</pl-button>
                            </form>
                            <form method="POST" action={% "/sites/" + siteId + "/processes/" + proc.get("pid") + "/kill" %} style="display:inline" data-confirm={% t("kill_confirm", scope: "site_processes") %}>
                                {% csrf() %}
                                <pl-button variant={% "destructive" %} size={% "sm" %} type={% "submit" %}>{{ t("kill", scope: "site_processes") }}</pl-button>
                            </form>
                        </pl-table-cell>
                    </pl-table-row>
                    {% /each %}
                </pl-table-body>
            </pl-table>
            {% else %}
            <p>{{ t("none_running", scope: "site_processes") }}</p>
            {% /if %}
            <form method="POST" action={% "/sites/" + siteId + "/processes/start" %}>
                {% csrf() %}
                <pl-button variant={% "outline" %} type={% "submit" %}>{{ t("start", scope: "site_processes") }}</pl-button>
            </form>
        </pl-card-content>
    </pl-card>

    {% if processes %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("terminal", scope: "site_processes") }}</pl-card-title>
            <pl-card-description>{{ t("terminal_description", scope: "site_processes", pid: processes.get(0).get("pid")) }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <pl-terminal
                rows={% 24{:} %}
                cols={% 100{:} %}
                wsUrl={% "/ws/terminal/" + siteId + "/" + processes.get(0).get("pid") %}>
            </pl-terminal>
        </pl-card-content>
    </pl-card>
    {% /if %}
    {% else %}
    <pl-empty-state icon="microchip">
        <pl-empty-state-title>{{ t("unmanaged", scope: "site_processes") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("unmanaged_description", scope: "site_processes") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("stored_logs", scope: "site_processes") }}</pl-card-title>
        </pl-card-header>
        <pl-card-content>
            {% if proclogs %}
            <pl-table>
                <pl-table-header><pl-table-row>
                    <pl-table-head>{{ t("pid", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("lines", scope: "site_processes") }}</pl-table-head>
                    <pl-table-head>{{ t("captured", scope: "site_processes") }}</pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body>
                    {% each proclogs as index, log %}
                    <pl-table-row>
                        <pl-table-cell><a href={% "/admin/sites/" + siteId + "/page/processes?log=" + log.get("id") %}>PID {{ log.get("pid") }}</a></pl-table-cell>
                        <pl-table-cell>{{ log.get("lineCount") }}</pl-table-cell>
                        <pl-table-cell>{{ log.get("createdAt") }}</pl-table-cell>
                    </pl-table-row>
                    {% /each %}
                </pl-table-body>
            </pl-table>
            {% else %}
            <p>{{ t("no_logs", scope: "site_processes") }}</p>
            {% /if %}
        </pl-card-content>
    </pl-card>

    {% if selectedLogHtml != "" %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("stored_log", scope: "site_processes", title: selectedLogTitle) }}</pl-card-title>
        </pl-card-header>
        <pl-card-content>
            <div class="hh-proclog-content">{%= selectedLogHtml %}</div>
        </pl-card-content>
    </pl-card>
    {% /if %}
</section>
{% /block %}
