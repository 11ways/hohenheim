{#- Databases tab on a Docker-runtime instance: every attached managed database with
    the variable family it injects, linking into the (nav-hidden) attachment resource
    forms -- the page a detach happens on. -#}
{% declare title: String %}
{% declare instanceId: Integer %}
{% declare instanceName: String %}
{% declare attachments: List %}
{% declare attachTarget: RouteTarget = null %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ instanceName }}</h1>
        {% if attachTarget %}
        <pl-button variant="primary" use:Zenit.route={% attachTarget %} id="attach-database-link">{{ t("add", scope: "instance_database") }}</pl-button>
        {% /if %}
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    <p class="hh-tab-hint">{{ t("tab_hint", scope: "instance_database") }}</p>

    {% if attachments %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("singular", scope: "database") }}</pl-table-head>
            <pl-table-head>{{ t("engine", scope: "field") }}</pl-table-head>
            <pl-table-head>{{ t("env_prefix", scope: "field") }}</pl-table-head>
            <pl-table-head>{{ t("status", scope: "instance_database") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each attachments as index, attachment %}
            <pl-table-row>
                <pl-table-cell>
                    {% if attachTarget %}<a use:Zenit.route={% attachment.get("editTarget") %}>{{ attachment.get("databaseName") }}</a>{% else %}{{ attachment.get("databaseName") }}{% /if %}
                </pl-table-cell>
                <pl-table-cell>{{ attachment.get("engine") }}</pl-table-cell>
                <pl-table-cell><code>{{ attachment.get("prefix") }}_*</code></pl-table-cell>
                <pl-table-cell>
                    {% if attachment.get("databaseTarget") %}<a use:Zenit.route={% attachment.get("databaseTarget") %}>{{ attachment.get("status") }}</a>{% else %}{{ attachment.get("status") }}{% /if %}
                </pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="database">
        <pl-empty-state-title>{{ t("empty", scope: "instance_database") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "instance_database") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
