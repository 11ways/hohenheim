{#- The server's Traffic page (TrafficReportPage): its header with its "Download as a file" (the span's steps as a
    file), its tabs (Report, this page; Settings, the settings page opened on the Traffic group), then the one traffic
    screen (hh-traffic) of every site at once. -#}
{% declare title: String %}
{% declare lead: Microcopy %}
{% declare tabs: List<NavTab> %}
{% declare view: TrafficView %}
{% declare downloadUrl: String %}
{% extend "zenitcms:shell" var:title=title %}

{% snippet download() %}<pl-button href={% downloadUrl %} variant="outline" download data-hh-traffic-download>{{ t("traffic_download", scope: "traffic_screen") }}</pl-button>{% /snippet %}

{% block "main" %}
<section class="cms-resource-list-page" data-hh-traffic-report>
    {% render "zenitcms:page-header" var:title=title var:lead=lead var:actions=download %}
    <hh-traffic-tabs tabs={% tabs %}></hh-traffic-tabs>
    <hh-traffic view={% view %}></hh-traffic>
</section>
{% /block %}
