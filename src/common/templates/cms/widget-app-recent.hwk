{#- An app's recent activity: the framework's records list over the activity source (this widget's config is the
    records widget's own), inside the card. -#}
{% declare widget: WidgetInstance %}
{% let title = t("recent", scope: "app_overview") %}
<pl-card class="widget hh-app-card" data-app-card="recent">
    {% render "hohenheim:cms/app-card-header" var:title=title %}
    <pl-card-content>
        {% render "zenitwidget:widget-display/records" var:widget=widget %}
    </pl-card-content>
</pl-card>
