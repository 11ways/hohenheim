{#- Devices tab on an instance: its attached disks and extra NICs, linking into the
    (nav-hidden) device resource forms, and the install-media section (operator only): what is in the drive with
    its detach, or the ISO pick of the record's host with its attach on one line, and the host's media as a quiet
    link. -#}
{% declare title: String %}
{% declare instanceId: Integer %}
{% declare instanceName: String %}
{% declare devices: List %}
{% declare detailHeads: List %}
{% declare addDiskTarget: RouteTarget = null %}
{% declare addNicTarget: RouteTarget = null %}
{% declare mediaSection: Boolean = false %}
{% declare mediaForm: PageFormState = null %}
{% declare detachMediaForm: PageFormState = null %}
{% declare mediaLead: String = "" %}
{% declare mediaHostTarget: RouteTarget = null %}
{% declare mediaHostLabel: String = "" %}
{% declare canEdit: Boolean = true %}
{% declare head: RecordHeadState = null %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page">
    {% if head != null %}{% render "zenitcms:record-head" var:head=head %}{% /if %}
    {#- The devices table is its own section under its own heading, the attaches in that heading's actions, so it
        never reads as part of the install-media section beside it. -#}
    <section id="devices" class="mb-xl">
        <pl-section-header>
            <h2>{{ t("plural", scope: "instance_device") }}</h2>
            {% if canEdit %}
            <pl-section-header-actions>
                <pl-button variant="primary" use:Zenit.route={% addDiskTarget %} id="add-disk-link">{{ t("add_disk", scope: "instance_device") }}</pl-button>
                <pl-button use:Zenit.route={% addNicTarget %} id="add-nic-link">{{ t("add_nic", scope: "instance_device") }}</pl-button>
            </pl-section-header-actions>
            {% /if %}
        </pl-section-header>
    {% if devices %}
    {#- The generated list's scrollport (plumage's pl-scroll-area), so a phone scrolls the columns instead of
        clipping them at the screen's edge. -#}
    <pl-scroll-area class="cms-table-scroll">
    <pl-table class="cms-resource-list-table">
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("name", scope: "hohenheim_field") }}</pl-table-head>
            <pl-table-head>{{ t("type", scope: "instance_device") }}</pl-table-head>
            {% each detailHeads as headIndex, head %}<pl-table-head>{{ head }}</pl-table-head>{% /each %}
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each devices as index, device %}
            <pl-table-row>
                <pl-table-cell>{% if canEdit %}<a use:Zenit.route={% device.get("editTarget") %}>{{ device.get("name") }}</a>{% else %}{{ device.get("name") }}{% /if %}</pl-table-cell>
                <pl-table-cell><pl-badge variant={% device.get("typeVariant") %} colorSet={% device.get("typeColorSet") %}>{{ device.get("typeLabel") }}</pl-badge></pl-table-cell>
                {% each device.get("details") as detailIndex, detail %}<pl-table-cell>{{ detail }}</pl-table-cell>{% /each %}
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    </pl-scroll-area>
    {% else %}
    <pl-empty-state icon="hard-drive">
        <pl-empty-state-title>{{ t("empty", scope: "instance_device") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "instance_device") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
    </section>

    {% if mediaSection %}
    <section id="attach-media" class="mb-xl">
        <pl-section-header>
            <h2>{{ t("install_media", scope: "instance_device") }}</h2>
            <pl-section-header-actions>
                {% if mediaHostTarget %}<pl-button variant="text" use:Zenit.route={% mediaHostTarget %} id="media-host-link">{{ mediaHostLabel }}</pl-button>{% /if %}
                {% if detachMediaForm != null %}<div id="detach-media">{% render "zenitcms:form/page-action" var:page=detachMediaForm %}</div>{% /if %}
            </pl-section-header-actions>
            <pl-section-header-lead id="media-in-drive">{{ mediaLead }}</pl-section-header-lead>
        </pl-section-header>
        {% if mediaForm != null %}{% render "zenitcms:form/page-action" var:page=mediaForm var:inline=true %}{% /if %}
    </section>
    {% /if %}
</section>
{% /block %}
