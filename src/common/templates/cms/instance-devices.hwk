{#- Devices tab on an instance: its attached disks and extra NICs, linking into the
    (nav-hidden) device resource forms, and the install-media attach drawn in place. -#}
{% declare title: String %}
{% declare instanceId: Integer %}
{% declare instanceName: String %}
{% declare devices: List %}
{% declare addDiskTarget: RouteTarget = null %}
{% declare addNicTarget: RouteTarget = null %}
{% declare mediaForm: PageFormState = null %}
{% declare detachMediaForm: PageFormState = null %}
{% declare mediaHostTarget: RouteTarget = null %}
{% declare mediaHostLabel: String = "" %}
{% declare canEdit: Boolean = true %}
{% declare head: RecordHeadState = null %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page">
    {% if head != null %}{% render "zenitcms:record-head" var:head=head %}{% /if %}
    <div class="hh-tab-tools">
        {% if canEdit %}
        <pl-button variant="primary" use:Zenit.route={% addDiskTarget %} id="add-disk-link">{{ t("add_disk", scope: "instance_device") }}</pl-button>
        <pl-button use:Zenit.route={% addNicTarget %} id="add-nic-link">{{ t("add_nic", scope: "instance_device") }}</pl-button>
        {% /if %}
    </div>

    {% if mediaForm != null || detachMediaForm != null %}
    <div id="attach-media">
        {% if mediaForm != null %}{% render "zenitcms:form/page-action" var:page=mediaForm %}{% /if %}
        {% if detachMediaForm != null %}<div id="detach-media">{% render "zenitcms:form/page-action" var:page=detachMediaForm %}</div>{% /if %}
        {% if mediaHostTarget %}<a use:Zenit.route={% mediaHostTarget %} id="media-host-link">{{ mediaHostLabel }}</a>{% /if %}
    </div>
    {% /if %}

    {% if devices %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("name", scope: "hohenheim_field") }}</pl-table-head>
            <pl-table-head>{{ t("type", scope: "instance_device") }}</pl-table-head>
            <pl-table-head>{{ t("device_size_gb", scope: "hohenheim_field") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each devices as index, device %}
            <pl-table-row>
                <pl-table-cell>{% if canEdit %}<a use:Zenit.route={% device.get("editTarget") %}>{{ device.get("name") }}</a>{% else %}{{ device.get("name") }}{% /if %}</pl-table-cell>
                <pl-table-cell>
                    {% if device.get("disk") == true %}
                    <pl-badge variant="primary">{{ t("disk", scope: "instance_device") }}</pl-badge>
                    {% else %}{% if device.get("cdrom") == true %}
                    <pl-badge variant="primary">{{ t("cdrom", scope: "instance_device") }}</pl-badge>
                    {% else %}
                    <pl-badge variant={% "secondary" %}>{{ t("nic", scope: "instance_device") }}</pl-badge>
                    {% /if %}{% /if %}
                </pl-table-cell>
                <pl-table-cell>{% if device.get("disk") == true %}{{ device.get("sizeGb") }}{% else %}{% if device.get("cdrom") == true %}{{ device.get("sourceMedia") }}{% else %}-{% /if %}{% /if %}</pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="hard-drive">
        <pl-empty-state-title>{{ t("empty", scope: "instance_device") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "instance_device") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
