{#- The server's Traffic page, tab Activity (TrafficActivityPage): its header and its tabs, then the live picture of
    every site's requests and, under it, where the apps send data (hh-traffic-activity), then the TV page card: the
    links made, who made each and when, End link on each, and the form that makes one, whose address is shown here
    once. -#}
{% declare title: String %}
{#- Named apart from the page-action form's own `lead` (a snippet), which a rendered form would otherwise read. -#}
{% declare pageLead: Microcopy %}
{% declare tabs: List<NavTab> %}
{% declare view: ActivityView %}
{% declare apps: Live<AppsSendingView> %}
{% declare tv: TvLinksCard %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page" data-hh-traffic-activity>
    {% render "zenitcms:page-header" var:title=title var:lead=pageLead %}
    <hh-traffic-tabs tabs={% tabs %}></hh-traffic-tabs>
    <hh-traffic-activity view={% view %} apps={% apps %}></hh-traffic-activity>
    <pl-card id="tv-page" data-hh-tv-links>
        <pl-card-header>
            <pl-card-title>{{ t("tv_card", scope: "traffic_screen") }}</pl-card-title>
            <pl-card-description>{{ t("tv_card_lead", scope: "traffic_screen") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            {% if tv.disclosed %}
            <pl-one-time-secret heading={% t("tv_link_address", scope: "traffic_screen") %} value={% tv.disclosed %} data-hh-tv-address></pl-one-time-secret>
            {% /if %}
            {% if tv.links %}
            <pl-table>
                <pl-table-header><pl-table-row>
                    <pl-table-head>{{ t("tv_link_code_head", scope: "traffic_screen") }}</pl-table-head>
                    <pl-table-head>{{ t("tv_link_shows", scope: "traffic_screen") }}</pl-table-head>
                    <pl-table-head>{{ t("tv_link_made_head", scope: "traffic_screen") }}</pl-table-head>
                    <pl-table-head>{{ t("tv_link_action_head", scope: "traffic_screen") }}</pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body>
                    {% each tv.links as link key link.code %}
                    <pl-table-row data-hh-tv-link={% link.code %}>
                        <pl-table-cell>{{ link.code }}</pl-table-cell>
                        <pl-table-cell>{{ link.shows }}</pl-table-cell>
                        <pl-table-cell>{% if link.madeAt != null %}{{ t("tv_link_made_at", scope: "traffic_screen", at: link.madeAt) }} {% /if %}{{ link.madeBy }}</pl-table-cell>
                        <pl-table-cell>{% if link.end != null %}{% render "zenitcms:form/page-action" var:page=link.end %}{% /if %}</pl-table-cell>
                    </pl-table-row>
                    {% /each %}
                </pl-table-body>
            </pl-table>
            {% else %}
            <p data-hh-tv-none>{{ t("tv_link_none", scope: "traffic_screen") }}</p>
            {% /if %}
            {% if tv.make != null %}
            <div data-hh-tv-make>{% render "zenitcms:form/page-action" var:page=tv.make var:inline=true %}</div>
            {% /if %}
        </pl-card-content>
    </pl-card>
</section>
{% /block %}
