{#- The server's Traffic page, tab Activity (TrafficActivityPage): its header and its tabs, then the live picture of
    every site's requests (hh-traffic-activity). -#}
{% declare title: String %}
{% declare lead: Microcopy %}
{% declare tabs: List<NavTab> %}
{% declare view: ActivityView %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page" data-hh-traffic-activity>
    {% render "zenitcms:page-header" var:title=title var:lead=lead %}
    <hh-traffic-tabs tabs={% tabs %}></hh-traffic-tabs>
    <hh-traffic-activity view={% view %}></hh-traffic-activity>
</section>
{% /block %}
