{% tag HhTrafficActivity {
    /* The live Activity picture (TrafficActivity.watch over ActivityDriver): requests flying as dots from their
       visitors to their sites, coloured by status class, a site row glowing as one arrives with its path beside it,
       the legend naming the classes in words, a line saying when the picture last heard and what it left undrawn,
       Pause, and a screen reader told the last minute every ActivitySummary.SPEAK_EVERY seconds (politely, never per
       request). The line, the figures and the picture's own words (its accessible name, every row with its figure)
       all come from the summary the picture hands over after the draw that shows them, so they say what the picture
       shows. In its place the picture is as tall as its rows fit; inside pl-kiosk, whose Full screen stages it over
       the panel, it fills the screen. `tv` is the wall screen's look, staged in its look's dark answer (pl-kiosk
       tone): the server's name and the clock over the four figures, the bars of the last minute under the dots, the
       kiosk staged from the start, every size taken from the screen (its type grows with the shorter side, and the
       picture draws its rows and dots from that type), and the picture filling what the screen leaves under the
       figures. */
    public required view: ActivityView
    attribute tv: Boolean = false

    private summary: ActivitySummary
    private paused: Boolean = false
    private surfaceEl: DominoElement
    private regionEl: DominoElement

    style {
        @use 'plumage/mixins' as m;

        display: block;

        .hh-activity-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: var(--pl-space-sm) var(--pl-space-md);
            margin-block-end: var(--pl-space-sm);
        }

        .hh-activity-line {
            margin-inline-start: auto;
            color: var(--pl-color-text-muted);
            font-size: var(--pl-font-size-sm);
        }

        .hh-activity-swatch {
            display: inline-block;
            inline-size: 0.75rem;
            block-size: 0.75rem;
            /* The class's own colour, the one the picture draws it in (ActivityPalette), as a round mark. */
            @include m.picture(var(--hh-swatch), 50%);
        }

        /* The picture's box: the surface draws in it, its font is the labels' (TextStyle.of); in its place it is as
           tall as its rows fit (the driver's --hh-activity-fit), never under 14rem. */
        .hh-activity-surface {
            display: block;
            block-size: max(14rem, var(--hh-activity-fit, 28rem));
            font-size: var(--pl-font-size-sm);
            font-family: var(--pl-font-family);
        }

        /* A wall screen: the type grows with the screen's shorter side, so a 4K screen reads like a 1080p one. */
        &[tv] {
            font-size: max(var(--pl-font-size-md), 1.7vmin);
        }

        &[tv] .hh-activity-surface {
            font-size: 1em;
        }

        /* Staged, the picture takes every line the screen leaves under the bar, the figures and the legend. */
        pl-kiosk[data-staged] {
            display: flex;
            flex-direction: column;
        }

        pl-kiosk[data-staged] [data-hh-activity-picture],
        pl-kiosk[data-staged] [data-hh-activity-picture] pl-card-content {
            display: flex;
            flex: 1 1 auto;
            flex-direction: column;
            min-block-size: 0;
        }

        pl-kiosk[data-staged] .hh-activity-surface {
            flex: 1 1 auto;
            block-size: auto;
            min-block-size: 16rem;
        }

        .hh-activity-tv-top {
            display: flex;
            align-items: baseline;
            gap: 1.5em;
            margin-block-end: 0.6em;
        }

        .hh-activity-tv-name {
            margin: 0;
            font-size: 2.2em;
            font-weight: var(--pl-font-weight-bold);
        }

        .hh-activity-tv-sub {
            color: var(--pl-color-text-muted);
            font-size: 1.2em;
        }

        .hh-activity-tv-clock {
            margin-inline-start: auto;
            font-size: 3.4em;
            font-weight: var(--pl-font-weight-bold);
            font-variant-numeric: tabular-nums;
        }

        &[tv] .hh-activity-figure-value {
            font-size: 2.8em;
        }

        &[tv] .hh-activity-line {
            font-size: 1em;
        }

        /* Read across a room, the legend takes the screen's type too, its swatches with it. */
        &[tv] [data-hh-activity-legend] {
            font-size: 0.9em;
        }

        &[tv] .hh-activity-swatch {
            inline-size: 0.75em;
            block-size: 0.75em;
        }

        .hh-activity-figure-value {
            font-size: var(--pl-font-size-3xl);
            font-weight: var(--pl-font-weight-bold);
            font-variant-numeric: tabular-nums;
        }
    }

    attribute computed dataEnded: String = summary{:} != null && summary{:}.ended ? "" : null

    /* The classes the legend names now: the rare ones only while the minute holds one (ActivityPalette.legend). */
    private computed legend = summary{:} != null ? summary{:}.legend : view.legend

    @mount
    function watch() {
        TrafficActivity.watch(this, surfaceEl, view, (heard: ActivitySummary) => listen(heard))
    }

    function listen(heard: ActivitySummary) {
        summary = heard
        if heard.ended {
            LiveRegion.announce(regionEl, t("activity_ended", scope: "traffic_screen"))
        } else {
            if heard.speak {
                LiveRegion.announce(regionEl, t("activity_spoken", scope: "traffic_screen", count: heard.requests,
                    refused: heard.refused, failed: heard.failed))
            }
        }
    }

    function togglePause() {
        paused = !paused
        TrafficActivity.pause(this, paused)
    }

    template {
        <pl-kiosk always={% tv %} tone={% tv ? "dark" : "default" %}>
            {% if tv %}
            <header class="hh-activity-tv-top" data-hh-activity-tv-top>
                <h1 class="hh-activity-tv-name">{{ Brand.nameOrDefault() }}</h1>
                <span class="hh-activity-tv-sub">{{ t("tv_title", scope: "traffic_screen") }}</span>
                <span class="hh-activity-tv-clock" data-hh-activity-clock>{{ summary{:} != null && summary{:}.latest != null ? t("tv_clock", scope: "traffic_screen", at: summary{:}.latest) : "" }}</span>
            </header>
            <pl-grid size="sm" balanced data-hh-activity-figures>
                <pl-card data-hh-activity-figure="requests"><pl-card-content>
                    <div class="hh-activity-figure-value">{{ summary{:} != null ? t("activity_count", scope: "traffic_screen", count: summary{:}.requests) : "" }}</div>
                    <div>{{ t("activity_figure_requests", scope: "traffic_screen") }}</div>
                </pl-card-content></pl-card>
                <pl-card data-hh-activity-figure="sent"><pl-card-content>
                    <div class="hh-activity-figure-value">{{ summary{:} != null ? t("activity_bytes", scope: "traffic_screen", bytes: summary{:}.bytes) : "" }}</div>
                    <div>{{ t("activity_figure_sent", scope: "traffic_screen") }}</div>
                </pl-card-content></pl-card>
                <pl-card data-hh-activity-figure="visitors"><pl-card-content>
                    <div class="hh-activity-figure-value">{% if summary{:} != null && summary{:}.visitorsCut %}{{ t("activity_count_least", scope: "traffic_screen", count: summary{:}.visitors) }}{% elseif summary{:} != null %}{{ t("activity_count", scope: "traffic_screen", count: summary{:}.visitors) }}{% /if %}</div>
                    <div>{{ t("activity_figure_visitors", scope: "traffic_screen") }}</div>
                </pl-card-content></pl-card>
                <pl-card data-hh-activity-figure="refused"><pl-card-content>
                    <div class="hh-activity-figure-value">{{ summary{:} != null ? t("activity_count", scope: "traffic_screen", count: summary{:}.refused) : "" }}</div>
                    <div>{{ t("activity_figure_refused", scope: "traffic_screen") }}</div>
                </pl-card-content></pl-card>
            </pl-grid>
            {% /if %}
            <div class="hh-activity-bar">
                <pl-legend label={% t("activity_legend", scope: "traffic_screen") %} variant="line" data-hh-activity-legend>
                    {% each legend{:} as entry %}
                    <pl-legend-item><span slot="key" class="hh-activity-swatch" style={% "--hh-swatch:" + entry.colour %}></span>{{ entry.label }}</pl-legend-item>
                    {% /each %}
                </pl-legend>
                <span class="hh-activity-line" data-hh-activity-line>{{ summary{:} == null ? t("activity_waiting", scope: "traffic_screen")
                    : (summary{:}.ended ? (tv ? t("activity_tv_ended", scope: "traffic_screen") : t("activity_ended", scope: "traffic_screen"))
                    : t("activity_line", scope: "traffic_screen", at: summary{:}.latest, count: summary{:}.requests)) }}</span>
                {% if summary{:} != null && summary{:}.notDrawn > 0 %}
                <span class="hh-activity-line" data-hh-activity-not-drawn>{{ t("activity_not_drawn", scope: "traffic_screen", count: summary{:}.notDrawn) }}</span>
                {% /if %}
                {% if summary{:} != null && summary{:}.missed > 0 %}
                <span class="hh-activity-line" data-hh-activity-missed>{{ t("activity_missed", scope: "traffic_screen", count: summary{:}.missed) }}</span>
                {% /if %}
                {% if !tv %}
                <pl-button variant="outline" size="sm" type={% "button" %} event:click={% togglePause() %} data-hh-activity-pause>
                    {% if paused{:} %}{{ t("activity_resume", scope: "traffic_screen") }}{% else %}{{ t("activity_pause", scope: "traffic_screen") }}{% /if %}
                </pl-button>
                {% /if %}
            </div>
            <pl-card data-hh-activity-picture>
                {% if !tv %}
                <pl-card-header>
                    <pl-card-title>{{ t("activity_requests", scope: "traffic_screen") }}</pl-card-title>
                    <pl-card-description>{{ t("activity_requests_lead", scope: "traffic_screen") }}</pl-card-description>
                </pl-card-header>
                {% /if %}
                <pl-card-content>
                    <z3d-surface class="hh-activity-surface" :ref={% surfaceEl %} role="img"
                                 aria-label={% summary{:} != null && summary{:}.picture != null ? summary{:}.picture : t("activity_requests_lead", scope: "traffic_screen") %}
                                 data-hh-activity-surface></z3d-surface>
                </pl-card-content>
            </pl-card>
            <pl-live-region :ref={% regionEl %} data-hh-activity-spoken></pl-live-region>
        </pl-kiosk>
    }
} %}
