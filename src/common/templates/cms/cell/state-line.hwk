{#- THE state cell: the answer as a badge, and the lines that explain it underneath (an address's "Points here", a
    certificate's state, a ban, a site's HTTPS). Blank when the column has no answer for the row. -#}
{% declare value: StateLineCell %}
{% if value != null %}
<span class="hh-state-line" attr:data-state={% value.state %}>
    <pl-badge variant={% value.variant %}>{{ value.label }}</pl-badge>
    {% if value.detail != null %}<span class="hh-state-line-detail">{{ value.detail }}</span>{% /if %}
    {% if value.url != null %}
    <a class="hh-state-line-detail" href={% value.url %} data-state-link>{{ value.link }}</a>
    {% /if %}
    {% if value.note != null %}<span class="hh-state-line-detail">{{ value.note }}</span>{% /if %}
</span>
{% /if %}
