{#- How full one thing is (a host's resource, a volume): the bar, the amounts underneath. Without a reading against a
    limit there is no bar, only the sentence saying so, because an empty bar would read as an empty host. -#}
{% declare value: UsageCell %}
{% if value != null %}
<span class="hh-state-line hh-usage" attr:data-measured={% value.measured %}>
    {% if value.measured %}<pl-usage-bar value={% value.percent %} max={% 100 %} size="sm"></pl-usage-bar>{% /if %}
    <span class="hh-state-line-detail">{{ value.text }}</span>
</span>
{% /if %}
