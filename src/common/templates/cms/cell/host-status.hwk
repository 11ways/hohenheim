{#- Structured host-list status cell: a status dot, a short state word and a live
    relative time -- never a fully-resolved sentence. Quarantine wins and is LOUD.
    The dot and the wording are FACTS on HostState, so no state can render green by
    falling through a branch this template forgot. -#}
{% declare value: HostStatusCell %}
{% if value != null %}
<span class="hh-host-state" data-host-state={% value.stateToken %}>
    <pl-status-dot status={% value.dot %}></pl-status-dot>
    {% if value.stateToken == "quarantined" %}
    <strong class="hh-host-state-quarantined">{{ value.stateText }}</strong>
    {% elseif value.stateToken == "silent" %}
    <span>{{ value.daemon }} {{ value.stateText }}</span>
    {% elseif value.stateText != null %}
    <span>{{ value.stateText }}</span>
    {% else %}
    <span>{{ value.daemon }}</span>
    {% /if %}
    {% if value.lastSeenIso != null %}
    <pl-relative-time datetime={% value.lastSeenIso %} wording={% value.wording %} title={% value.lastSeenIso %}></pl-relative-time>
    {% /if %}
</span>
{% /if %}
