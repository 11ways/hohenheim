{#- Files tab on an instance: a browser over its OWN volumes, plus an inline editor.
    Every write control is rendered behind canWrite, which is an AFFORDANCE only --
    the action endpoint asks InstanceFiles for files.write no matter what was drawn. -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare instanceId: Integer %}
{% declare path: String = "" %}
{% declare parentPath: String = "" %}
{% declare volumes: List %}
{% declare crumbs: List %}
{% declare entries: List %}
{% declare canWrite: Boolean = false %}
{% declare supported: Boolean = true %}
{#- A refusal from InstanceFiles (no volumes, not found, not a directory, ...). It is
    RENDERED: the page used to stash it in a variable the template never declared, so
    every refusal drew an empty page with nothing but the tabs on it. -#}
{% declare error: String = "" %}
{% declare maxFileBytes: Long = 0 %}
{% declare editPath: String = "" %}
{% declare editContent: String = "" %}
{% declare actionTarget: RouteTarget %}
{% declare parentTarget: RouteTarget = null %}
{% declare returnUrl: String = "" %}
{#- ReturnTarget.PARAM, supplied by the page: ReturnTarget lives in zenit's SERVER
    source set, so a common template cannot reach the constant (nor its
    Zenit.Params.zenit.return_to identifier). Never spell "_return" here by hand. -#}
{% declare returnParam: String %}
{% declare head: RecordHeadState = null %}
{#- The "Connect with SFTP" card, drawn for a runtime with a file lane (InstanceFilesPage.putSftpCard). -#}
{% declare sftpShown: Boolean = false %}
{% declare sftpEnabled: Boolean = false %}
{% declare sftpRunning: Boolean = false %}
{% declare sftpOperator: Boolean = false %}
{% declare sftpHost: String = "" %}
{% declare sftpPort: String = "" %}
{% declare sftpUsername: String = "" %}
{% declare sftpFingerprint: String = "" %}
{% declare sftpKeys: String = "" %}
{% declare sftpPasswordScopes: String = "" %}
{% declare sftpPasswordTarget: RouteTarget = null %}
{% declare sftpKeysTarget: RouteTarget = null %}
{% declare sftpSettingsTarget: RouteTarget = null %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page">
    {% if head != null %}{% render "zenitcms:record-head" var:head=head %}{% /if %}

    {#- A runtime with no file lane states the absence; a broken browser would be worse
        than an honest "not here yet". Only the Docker driver implements the lane. -#}
    {% if !supported %}
    <pl-empty-state icon="folder-tree" data-files-unsupported="1">
        <pl-empty-state-title>{{ t("unsupported", scope: "instance_files") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("unsupported_hint", scope: "instance_files") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}

    {% if error != "" %}<pl-alert variant="destructive" data-files-error="1">{{ error }}</pl-alert>{% /if %}

    {% if volumes %}
        <pl-breadcrumb>
            {% each volumes as volumeIndex, volume %}
            <pl-breadcrumb-item>
                <pl-breadcrumb-link use:Zenit.route={% volume.get("target") %}>{{ volume.get("label") }}</pl-breadcrumb-link>
            </pl-breadcrumb-item>
            {% /each %}
        </pl-breadcrumb>
    {% /if %}

    {% if crumbs %}
        <pl-breadcrumb>
            {% each crumbs as crumbIndex, crumb %}
            <pl-breadcrumb-item>
                <pl-breadcrumb-link use:Zenit.route={% crumb.get("target") %}>{{ crumb.get("label") }}</pl-breadcrumb-link>
            </pl-breadcrumb-item>
            {% /each %}
        </pl-breadcrumb>
    {% /if %}

    {% if path != "" %}
    <pl-card>
        <pl-card-content>
            {% if parentPath != "" %}
                <pl-button variant="outline" use:Zenit.route={% parentTarget %}>{{ t("up", scope: "instance_files") }}</pl-button>
            {% /if %}

            {% if entries %}
            <pl-table striped={% true %}>
                <pl-table-header><pl-table-row>
                    <pl-table-head>{{ t("name", scope: "instance_files") }}</pl-table-head>
                    <pl-table-head>{{ t("size", scope: "instance_files") }}</pl-table-head>
                    <pl-table-head>{{ t("mode", scope: "instance_files") }}</pl-table-head>
                    <pl-table-head>{{ t("actions", scope: "instance_files") }}</pl-table-head>
                </pl-table-row></pl-table-header>
                <pl-table-body>
                    {% each entries as entryIndex, entry %}
                    <pl-table-row>
                        <pl-table-cell>
                            {% if entry.get("directory") %}
                                <a use:Zenit.route={% entry.get("browseTarget") %}><code>{{ entry.get("name") }}/</code></a>
                            {% else %}
                                <code>{{ entry.get("name") }}</code>
                            {% /if %}
                            {% if entry.get("symlink") %}
                                <pl-badge variant="warning">{{ t("symlink", scope: "instance_files") }}</pl-badge>
                            {% /if %}
                            {% if entry.get("managed") %}
                                <pl-badge variant="secondary">{{ t("managed", scope: "instance_files") }}</pl-badge>
                            {% /if %}
                        </pl-table-cell>
                        <pl-table-cell>{{ entry.get("size") }}</pl-table-cell>
                        <pl-table-cell><code>{{ entry.get("mode") }}</code></pl-table-cell>
                        <pl-table-cell>
                            {% if entry.get("editable") %}
                                <pl-button size="sm" variant="ghost" use:Zenit.route={% entry.get("editTarget") %}>{{ t("edit", scope: "instance_files") }}</pl-button>
                            {% /if %}
                            {% if entry.get("kind") == "FILE" %}
                                <pl-button size="sm" variant="ghost" use:Zenit.route={% entry.get("downloadTarget") %}>{{ t("download", scope: "instance_files") }}</pl-button>
                            {% /if %}
                            {% if canWrite %}
                            <form use:Zenit.form={% actionTarget %} class="instance-files-inline">
                                <input type="hidden" name={% returnParam %} value={% returnUrl %}>
                                <input type="hidden" name="action" value="delete">
                                <input type="hidden" name="directory" value={% path %}>
                                <input type="hidden" name="path" value={% entry.get("path") %}>
                                <pl-button size="sm" variant="destructive" type={% "submit" %}>{{ t("delete", scope: "instance_files") }}</pl-button>
                            </form>
                            {% /if %}
                        </pl-table-cell>
                    </pl-table-row>
                    {% /each %}
                </pl-table-body>
            </pl-table>
            {% else %}
            <pl-empty-state icon="folder-open">
                <pl-empty-state-title>{{ t("empty", scope: "instance_files") }}</pl-empty-state-title>
            </pl-empty-state>
            {% /if %}
        </pl-card-content>
    </pl-card>
    {% /if %}

    {#- Where to connect with an SFTP client and with what. It only draws: the SFTP server asks files.read and
        files.write itself on every request, and zenit-auth's mint refuses a password scope the viewer lacks. -#}
    {% if sftpShown %}
    <pl-card data-sftp-card="1">
        <pl-card-header>
            <pl-card-title>{{ t("sftp_title", scope: "instance_files") }}</pl-card-title>
            {% if sftpEnabled %}
            <pl-card-description>{{ t("sftp_intro", scope: "instance_files") }}</pl-card-description>
            <pl-card-description>{{ t("sftp_no_login_password", scope: "instance_files") }}</pl-card-description>
            <pl-card-description>{{ t("sftp_running_hint", scope: "instance_files") }}</pl-card-description>
            {% else %}
            <pl-card-description>{{ t("sftp_off", scope: "instance_files") }}</pl-card-description>
            {% if !sftpOperator %}
            <pl-card-description>{{ t("sftp_off_hint", scope: "instance_files") }}</pl-card-description>
            {% /if %}
            {% /if %}
        </pl-card-header>
        {% if sftpEnabled %}
        <pl-card-content>
            {% if !sftpRunning %}
            <pl-alert variant="warning" data-sftp-not-running="1">{{ t("sftp_not_running", scope: "instance_files") }}</pl-alert>
            {% /if %}
            <pl-table>
                <pl-table-body>
                    <pl-table-row>
                        <pl-table-cell>{{ t("sftp_address", scope: "instance_files") }}</pl-table-cell>
                        <pl-table-cell><code data-sftp-host="1">{{ sftpHost }}</code></pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("sftp_port", scope: "instance_files") }}</pl-table-cell>
                        <pl-table-cell><code data-sftp-port="1">{{ sftpPort }}</code></pl-table-cell>
                    </pl-table-row>
                    {% if sftpUsername != "" %}
                    <pl-table-row>
                        <pl-table-cell>{{ t("sftp_username", scope: "instance_files") }}</pl-table-cell>
                        <pl-table-cell>
                            <code data-sftp-username="1">{{ sftpUsername }}</code>
                            <pl-copy-button value={% sftpUsername %} ariaLabel={% t("sftp_copy_username", scope: "instance_files") %}></pl-copy-button>
                        </pl-table-cell>
                    </pl-table-row>
                    {% /if %}
                    <pl-table-row>
                        <pl-table-cell>{{ t("sftp_sign_in_with", scope: "instance_files") }}</pl-table-cell>
                        <pl-table-cell data-sftp-credentials="1">{% if sftpKeys != "" %}{{ t("sftp_with_keys", scope: "instance_files", keys: sftpKeys) }}{% else %}{{ t("sftp_with_password", scope: "instance_files") }}{% /if %}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("sftp_password_scopes", scope: "instance_files") }}</pl-table-cell>
                        <pl-table-cell>
                            <code data-sftp-scopes="1">{{ sftpPasswordScopes }}</code>
                            <pl-copy-button value={% sftpPasswordScopes %} ariaLabel={% t("sftp_copy_scopes", scope: "instance_files") %}></pl-copy-button>
                        </pl-table-cell>
                    </pl-table-row>
                    {% if sftpFingerprint != "" %}
                    <pl-table-row>
                        <pl-table-cell>{{ t("sftp_fingerprint", scope: "instance_files") }}</pl-table-cell>
                        <pl-table-cell><code data-sftp-fingerprint="1">{{ sftpFingerprint }}</code></pl-table-cell>
                    </pl-table-row>
                    {% /if %}
                </pl-table-body>
            </pl-table>
        </pl-card-content>
        {% /if %}
        <pl-card-footer>
            {% if sftpEnabled %}
            <pl-button variant="primary" use:Zenit.route={% sftpPasswordTarget %} data-sftp-password="1">{{ t("sftp_create_password", scope: "instance_files") }}</pl-button>
            <pl-button variant="outline" use:Zenit.route={% sftpKeysTarget %}>{{ t("sftp_add_key", scope: "instance_files") }}</pl-button>
            {% /if %}
            {% if sftpOperator && (!sftpEnabled || !sftpRunning) %}
            <pl-button variant="outline" use:Zenit.route={% sftpSettingsTarget %} data-sftp-settings="1">{{ t("sftp_open_settings", scope: "instance_files") }}</pl-button>
            {% /if %}
        </pl-card-footer>
    </pl-card>
    {% /if %}

    {% if editPath != "" %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ editPath }}</pl-card-title>
        </pl-card-header>
        <pl-card-content>
            <form use:Zenit.form={% actionTarget %}>
                <input type="hidden" name={% returnParam %} value={% returnUrl %}>
                <input type="hidden" name="action" value="save">
                <input type="hidden" name="directory" value={% path %}>
                <input type="hidden" name="path" value={% editPath %}>
                <pl-field>
                    <pl-textarea name="content" value={% editContent %} disabled={% !canWrite %}></pl-textarea>
                </pl-field>
                {% if canWrite %}
                    <pl-button variant="primary" type={% "submit" %}>{{ t("save", scope: "instance_files") }}</pl-button>
                {% else %}
                    <p>{{ t("read_only", scope: "instance_files") }}</p>
                {% /if %}
            </form>
        </pl-card-content>
    </pl-card>
    {% /if %}

    {% if canWrite %}
    {% if path != "" %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("add", scope: "instance_files") }}</pl-card-title>
            <pl-card-description>{{ t("upload_limit", scope: "instance_files", bytes: maxFileBytes) }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <form use:Zenit.form={% actionTarget %} enctype="multipart/form-data">
                <input type="hidden" name={% returnParam %} value={% returnUrl %}>
                <input type="hidden" name="action" value="upload">
                <input type="hidden" name="directory" value={% path %}>
                <pl-field>
                    <pl-label>{{ t("target_path", scope: "instance_files") }}</pl-label>
                    <pl-input name="path" value={% path + "/" %}></pl-input>
                </pl-field>
                <pl-file-upload name="file"></pl-file-upload>
                <pl-button variant="primary" type={% "submit" %}>{{ t("upload", scope: "instance_files") }}</pl-button>
            </form>

            <form use:Zenit.form={% actionTarget %}>
                <input type="hidden" name={% returnParam %} value={% returnUrl %}>
                <input type="hidden" name="action" value="mkdir">
                <input type="hidden" name="directory" value={% path %}>
                <pl-field>
                    <pl-label>{{ t("new_directory", scope: "instance_files") }}</pl-label>
                    <pl-input name="path" value={% path + "/" %}></pl-input>
                </pl-field>
                <pl-button variant="outline" type={% "submit" %}>{{ t("create", scope: "instance_files") }}</pl-button>
            </form>

            <form use:Zenit.form={% actionTarget %}>
                <input type="hidden" name={% returnParam %} value={% returnUrl %}>
                <input type="hidden" name="action" value="rename">
                <input type="hidden" name="directory" value={% path %}>
                <pl-field>
                    <pl-label>{{ t("rename_from", scope: "instance_files") }}</pl-label>
                    <pl-input name="path" value={% path + "/" %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-label>{{ t("rename_to", scope: "instance_files") }}</pl-label>
                    <pl-input name="target" value={% path + "/" %}></pl-input>
                </pl-field>
                <pl-button variant="outline" type={% "submit" %}>{{ t("rename", scope: "instance_files") }}</pl-button>
            </form>
        </pl-card-content>
    </pl-card>
    {% /if %}
    {% /if %}
</section>
{% /block %}
