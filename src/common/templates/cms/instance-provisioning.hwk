{#- Provisioning tab on an instance: template, install state, the variables child list section (secret VALUES
    never rendered) and config files. -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare templateName: String = "" %}
{% declare installState: String %}
{% declare installStateLabel: Microcopy %}
{% declare installError: String = "" %}
{% declare sections: List<ChildListSectionState> %}
{% declare panelSlug: String = "" %}
{% declare files: List %}
{% declare addFileTarget: RouteTarget = null %}
{% declare canAddFile: Boolean = false %}
{% declare recordTabs: List<RecordTabState> %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ instanceName }}</h1>
        {% if canAddFile %}
        <pl-button variant="secondary" use:Zenit.route={% addFileTarget %} id="add-file-link">{{ t("add_file", scope: "template_contents") }}</pl-button>
        {% /if %}
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    <pl-card>
        <pl-card-content>
            <p>
                {{ t("template", scope: "instance_provisioning") }}:
                {% if templateName != "" %}<strong>{{ templateName }}</strong>{% else %}{{ t("no_template", scope: "instance_provisioning") }}{% /if %}
            </p>
            <p>{{ t("install_state", scope: "instance_provisioning") }}: <pl-badge variant="secondary">{{ installStateLabel }}</pl-badge></p>
            {% if installError != "" %}
            <pl-alert variant="destructive"><pl-code value={% installError %} wrap="wrap" size="sm"></pl-code></pl-alert>
            {% /if %}
        </pl-card-content>
    </pl-card>

    {#- The variables: the framework's child list section over the instance-owned values, read-only. -#}
    {% each sections as section key section.resourceSlug %}
    {% render "zenitcms:child-list-section" var:section=section var:panelSlug=panelSlug %}
    {% /each %}

    <h2>{{ t("files", scope: "template_contents") }}</h2>
    {% if files %}
    <pl-table striped={% true %}>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("path", scope: "template_contents") }}</pl-table-head>
            <pl-table-head>{{ t("mode", scope: "template_contents") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each files as index, file %}
            <pl-table-row>
                <pl-table-cell>
                    {% if file.get("editTarget") != null %}
                    <a use:Zenit.route={% file.get("editTarget") %}><code>{{ file.get("path") }}</code></a>
                    {% else %}
                    <code>{{ file.get("path") }}</code>
                    {% /if %}
                </pl-table-cell>
                <pl-table-cell><code>{{ file.get("mode") }}</code></pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <p>{{ t("no_files", scope: "template_contents") }}</p>
    {% /if %}
</section>
{% /block %}
