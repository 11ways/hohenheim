{% tag HhAccessLog {
    /* A site's Access log tab (SiteAccessLogPage): the filter row, the switch that follows new lines, the download
       of the filtered lines, then one page of lines in nine columns, newest first, with what the read could say of
       the rest. The lines are the live part (AccessLogView): while following, each new line of the site re-reads
       this part alone, the filters standing as the reader set them. The filters are a GET form, so the tab's address
       always says what it shows. The path takes the width the other columns leave, on one line, cut with an
       ellipsis; the referrer and the browser are cut likewise past a cap; both show their whole value on hover. A
       visitor's address always shows whole (the owner's ruling): an IPv4 address on one line in its column, a longer
       IPv6 one breaking inside it. The referrer is the host the visitor came from, a common one whole; the browser
       its name, version and platform, a common one whole. Time, method, status, size and time taken are as wide as
       their words, "Time taken" on two lines as the board draws it; the cells stand closer at their sides as the
       board draws them, so the path has at least 350 px beside the panel's rail at 1280 px
       (SiteAccessLogJourneyTest measures it). */
    public required part: Live<AccessLogView>
    public required filters: AccessLogFilters
    /* The time choice, then the range's two ends, as the reader edits them before the tab reads them. */
    public when: String = ""
    public from: String = ""
    public to: String = ""
    /* The picked range once both its ends hold a value, "" until then: the tab reads it at each change. */
    private computed range: String = when{:} == "range" and from{:} != "" and to{:} != "" ? from{:} + " " + to{:} : ""
    private computed view: AccessLogView = part{:}.value
    private following: Boolean = false
    private watch: LiveWatchHandle = null

    style {
        display: block;

        .hh-access-log-filters {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: var(--pl-space-sm) var(--pl-space-md);
        }

        .hh-access-log-path {
            inline-size: 16em;
        }

        .hh-access-log-visitor {
            inline-size: 14em;
        }

        .hh-access-log-tools {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: var(--pl-space-sm) var(--pl-space-md);
            margin-block: var(--pl-space-md);
        }

        .hh-access-log-muted {
            color: var(--pl-color-text-muted);
        }

        .hh-access-log-mono {
            font-family: var(--pl-font-family-mono);
        }

        /* A visitor's column is one IPv4 address wide in its own face, so one stands on one line and an IPv6 one
           breaks inside it. */
        .hh-access-log-address {
            display: inline-block;
            min-inline-size: 15ch;
        }

        /* The board's reading rows stand closer at their sides than a snug table's own. */
        pl-table[data-hh-access-log-lines] {
            --pl-table-snug-cell-inline: 0.25rem;
        }

        /* The referrer's and the browser's cut: as wide as their words up to their cap, then cut where it ends. */
        .hh-access-log-capped {
            display: inline-block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: bottom;
        }

        /* A common referrer host (shop.example.com) reads whole. */
        .hh-access-log-referrer {
            max-inline-size: 10em;
        }

        /* A common browser with its version and platform (Firefox 133, Windows) reads whole. */
        .hh-access-log-browser {
            max-inline-size: 11em;
        }

        .hh-access-log-foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: var(--pl-space-sm) var(--pl-space-md);
            margin-block: var(--pl-space-md);
        }
    }

    @mount
    function start() {
        following = filters.following
        if following {
            watch = Live.follow(this, &part)
        }
    }

    /* The switch: on follows the site's new lines, off ends the follow and leaves the page as it stands. */
    @watch(following, skipInitial: true)
    function followingChanged() {
        if following {
            watch = Live.follow(this, &part)
        } else {
            Live.stop(watch)
            watch = null
        }
    }

    function apply(edit: DominoEvent) {
        CmsFilterForm.apply("hh-access-log-filters", edit)
    }

    /* A time choice reads at once, except a range: its two ends appear, and it is read once both hold a value. */
    function whenPicked(edit: DominoCustomEvent) {
        match edit.detail {
            when String chosen {
                if chosen != "range" {
                    apply(edit)
                }
            }
        }
    }

    /* A range is read once both its ends hold a value, and again at each later edit of either. */
    @watch(range, skipInitial: true)
    function rangeChanged() {
        if range != "" {
            CmsFilterForm.apply("hh-access-log-filters")
        }
    }

    template {
        <form method="get" action={% filters.listUrl %} id="hh-access-log-filters" class="hh-access-log-filters"
              data-hawkeye-navigation="replace" data-hh-access-log-filters>
            <pl-select name="status" value={% filters.status %} clearable
                       placeholder={% t("access_log_status_all", scope: "access_log") %}
                       ariaLabel={% t("access_log_status_label", scope: "access_log") %}
                       event:change={% (e) => apply(e) %}>
                {% each filters.statuses as choice %}
                <pl-select-item value={% choice.value %} label={% choice.label %}></pl-select-item>
                {% /each %}
            </pl-select>
            <pl-input class="hh-access-log-path" name="path" value={% filters.path %}
                      placeholder={% t("access_log_path_placeholder", scope: "access_log") %}
                      ariaLabel={% t("access_log_path_placeholder", scope: "access_log") %}
                      event:input(debounce: 300)={% (e) => apply(e) %}></pl-input>
            <pl-select name="when" value={% &when %}
                       ariaLabel={% t("access_log_when_label", scope: "access_log") %}
                       event:change={% (e) => whenPicked(e) %}>
                {% each filters.times as choice %}
                <pl-select-item value={% choice.value %} label={% choice.label %}></pl-select-item>
                {% /each %}
            </pl-select>
            {% if when{:} == "range" %}
            <pl-input type="datetime-local" name="from" bind:value={% from %}
                      ariaLabel={% t("access_log_from_label", scope: "access_log") %}></pl-input>
            <pl-input type="datetime-local" name="to" bind:value={% to %}
                      ariaLabel={% t("access_log_to_label", scope: "access_log") %}></pl-input>
            {% /if %}
            <pl-input class="hh-access-log-visitor" name="visitor" value={% filters.visitor %}
                      placeholder={% t("access_log_visitor_placeholder", scope: "access_log") %}
                      ariaLabel={% t("access_log_visitor_placeholder", scope: "access_log") %}
                      event:input(debounce: 300)={% (e) => apply(e) %}></pl-input>
        </form>

        <div class="hh-access-log-tools">
            <span class="hh-access-log-muted" id="hh-access-log-follow">{{ t("access_log_follow", scope: "access_log") }}</span>
            <pl-switch bind:checked={% following %} data-hh-access-log-follow
                       ariaLabel={% t("access_log_follow", scope: "access_log") %}></pl-switch>
            <pl-button href={% filters.downloadUrl %} variant="outline" download data-hh-access-log-download>{{ t("access_log_download", scope: "access_log") }}</pl-button>
        </div>

        {% if view{:}.lines %}
        <pl-table textSize="small" density="snug" data-hh-access-log-lines>
            <pl-table-header><pl-table-row>
                <pl-table-head columnWidth="fit">{{ t("access_log_column_time", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit">{{ t("access_log_column_visitor", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit">{{ t("access_log_column_method", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fill">{{ t("access_log_column_path", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit">{{ t("access_log_column_status", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit" data-alignment="right">{{ t("access_log_column_size", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit" data-alignment="right" data-hh-access-log-took-head>{{ t("access_log_column_took", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit">{{ t("access_log_column_referrer", scope: "access_log") }}</pl-table-head>
                <pl-table-head columnWidth="fit">{{ t("access_log_column_browser", scope: "access_log") }}</pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                {% each view{:}.lines as line key line.key %}
                <pl-table-row data-hh-access-log-line={% line{:}.status %}>
                    <pl-table-cell nowrap>{{ line{:}.time }}</pl-table-cell>
                    <pl-table-cell breakAnywhere data-hh-access-log-visitor><span class="hh-access-log-mono hh-access-log-address">{{ line{:}.visitor }}</span></pl-table-cell>
                    <pl-table-cell nowrap>{{ line{:}.method }}</pl-table-cell>
                    <pl-table-cell truncate title={% line{:}.path %} data-hh-access-log-path><span class="hh-access-log-mono">{{ line{:}.path }}</span></pl-table-cell>
                    <pl-table-cell nowrap>{% if line{:}.variant != null %}<pl-badge variant={% line{:}.variant %}>{{ line{:}.status }}</pl-badge>{% else %}{{ line{:}.status }}{% /if %}</pl-table-cell>
                    <pl-table-cell nowrap data-alignment="right">{{ line{:}.size }}</pl-table-cell>
                    <pl-table-cell nowrap data-alignment="right" data-hh-access-log-took>{% if line{:}.took != null %}{{ line{:}.took }}{% else %}<span class="hh-access-log-muted">-</span>{% /if %}</pl-table-cell>
                    <pl-table-cell nowrap data-hh-access-log-referrer>{% if line{:}.referrer != "" %}<span class="hh-access-log-capped hh-access-log-referrer" title={% line{:}.referrer %}>{{ line{:}.referrer }}</span>{% else %}<span class="hh-access-log-muted">-</span>{% /if %}</pl-table-cell>
                    <pl-table-cell nowrap title={% line{:}.userAgent %} data-hh-access-log-browser><span class="hh-access-log-capped hh-access-log-browser">{{ line{:}.browser }}</span></pl-table-cell>
                </pl-table-row>
                {% /each %}
            </pl-table-body>
        </pl-table>
        {% else %}
        <pl-empty-state icon="list-ul" data-hh-access-log-empty>
            <pl-empty-state-title>{{ view{:}.summary }}</pl-empty-state-title>
        </pl-empty-state>
        {% /if %}

        <div class="hh-access-log-foot">
            {% if view{:}.lines %}<span class="hh-access-log-muted" data-hh-access-log-summary>{{ view{:}.summary }}</span>{% /if %}
            {% if view{:}.pager != null %}
            <pl-pager pager={% view{:}.pager %} variant="steps" label={% t("pagination", scope: "cms") %}></pl-pager>
            {% /if %}
        </div>
        {% if view{:}.stopped != null %}
        <p class="hh-access-log-muted" data-hh-access-log-stopped>{{ view{:}.stopped }}</p>
        {% /if %}
        <p class="hh-access-log-muted" data-hh-access-log-keeping>{{ filters.keeping }}</p>
    }
} %}
