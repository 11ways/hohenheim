{#- Zone-file tab on a DNS zone: master-file export text plus paste-to-import.
    Import REPLACES all operator-managed records; ACME-managed rows survive. -#}
{% declare title: String %}
{% declare zoneId: Integer %}
{% declare origin: String %}
{% declare zoneText: String %}
{% declare dsRecord: String = "" %}
{% declare importTarget: RouteTarget %}
{% declare importable: Boolean = true %}
{% declare primaryPeer: String = "" %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ origin }}</h1>
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}


    {% if dsRecord != "" %}
    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("ds_title", scope: "dns_zone") }}</pl-card-title>
            <pl-card-description>{{ t("ds_description", scope: "dns_zone") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <pre class="hh-zone-file"><code>{{ dsRecord }}</code></pre>
        </pl-card-content>
    </pl-card>
    {% /if %}

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("zone_file", scope: "dns_zone") }}</pl-card-title>
            <pl-card-description>{{ t("zone_file_description", scope: "dns_zone") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <pre class="hh-zone-file"><code>{{ zoneText }}</code></pre>
        </pl-card-content>
    </pl-card>

    {#- The import REPLACES every operator-managed record of the zone, so it is a
        destructive submit and confirms like one.

        AIDEV-NOTE: VALIDATION PRECEDES CONFIRMATION. The confirm directive is bound to
        the form's SUBMIT event, and a form whose constraints fail never fires one -- so
        marking the textarea required is what keeps an empty paste from opening a
        destructive dialog that would then be refused server-side anyway. The reactive
        pl-field error carries our own copy (the same key the server refusal uses) once
        the operator has interacted with the control. -#}
    {#- A REPLICA holds nobody's records but its primary's, and DnsZoneFiles.importText
        refuses one outright, so the form is not offered here at all: a destructive button
        whose only outcome is a refusal is worse than no button. -#}
    {% if !importable %}
    <pl-alert variant="info">
        <pl-alert-title>{{ t("import_replica_title", scope: "dns_zone") }}</pl-alert-title>
        {{ primaryPeer != "" ? t("import_replica_named", scope: "dns_zone", peer: primaryPeer)
            : t("import_replica", scope: "dns_zone") }}
    </pl-alert>
    {% else %}
    {% let zoneTextValue = "" %}
    <form use:Zenit.form={% importTarget %}
          use:CmsConfirm.destructive={% t("import_confirm", scope: "dns_zone") %}>
        <pl-card>
            <pl-card-header>
                <pl-card-title>{{ t("import_zone_file", scope: "dns_zone") }}</pl-card-title>
                <pl-card-description>{{ t("import_description", scope: "dns_zone") }}</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-field required
                          attr:invalid={% String.trim(zoneTextValue{:}) == "" %}
                          showErrors="interacted">
                    <pl-label target="zone_text">{{ t("zone_file_text", scope: "dns_zone") }}</pl-label>
                    <pl-textarea inputId="zone_text" name="zone_text" rows={% 12 %}
                                 bind:value={% zoneTextValue %}></pl-textarea>
                    <pl-field-description>{{ t("import_replaces", scope: "dns_zone") }}</pl-field-description>
                    {#- Empty content rather than a reactive {% if %}: pl-field-error hides
                        itself when it holds nothing, and a branch here would re-create its
                        siblings inside the field. -#}
                    <pl-field-error>{{ String.trim(zoneTextValue{:}) == ""
                        ? t("import_empty", scope: "dns_zone") : "" }}</pl-field-error>
                </pl-field>
                {#- Unchecked (the migration default) the file's apex NS rows are replaced by
                    the controller's declared nameservers (dns.nameservers); the checkbox
                    submits "on" only when checked, which is the whole keep_ns protocol. -#}
                <pl-field>
                    <pl-checkbox name="keep_ns">{{ t("import_keep_nameservers", scope: "dns_zone") }}</pl-checkbox>
                    <pl-field-description>{{ t("import_keep_nameservers_hint", scope: "dns_zone") }}</pl-field-description>
                </pl-field>
            </pl-card-content>
        </pl-card>
        <div class="cms-form-actions">
            <pl-button variant="destructive" type="submit">{{ t("import_action", scope: "dns_zone") }}</pl-button>
        </div>
    </form>
    {% /if %}
</section>
{% /block %}
