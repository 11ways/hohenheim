{#- Put something online: without a choice, what to put online (a stepper over grouped cards and
    Continue); with one, the stepped wizard the framework draws for that PAGE action, submitted once to its run page.
    Its sections stand in plumage's page frame (pl-page), which spaces them; the shell does not frame a module page.
    Before a choice the stepper reads only the steps every flow shares (PutOnline.sharedSteps): how what is put
    online is reached, and so whether HTTPS or Ports follows, is not known yet. -#}
{% declare title: String %}
{% declare lead: Microcopy %}
{% declare document: PageFormState = null %}
{% declare what: String = "" %}
{% declare whatIcon: String = "" %}
{% declare whatDescription: String = "" %}
{% declare versions: List = null %}
{% declare groups: List = null %}
{% declare steps: List = null %}
{% declare chooseAction: String = "" %}
{% declare cancelTarget: RouteTarget %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<pl-page data-hh-put-online>
{% render "zenitcms:page-header" var:title=title var:lead=lead %}
{% if document != null %}
<pl-list variant="card" data-hh-put-online-what>
    <pl-list-item>
        {% if whatIcon != "" %}<pl-icon slot="leading" name={% whatIcon %} data-hh-put-online-what-icon></pl-icon>{% /if %}
        <pl-list-item-title>{{ what }}</pl-list-item-title>
        {#- ONE meta line: the row's grid has a single second row, so a second meta line would overlap the first. -#}
        {% if whatDescription != "" || (versions != null && versions.size() > 0) %}
        <pl-list-item-meta class="pl-facts">
            {% if whatDescription != "" %}<span>{{ whatDescription }}</span>{% /if %}
            {% if versions != null && versions.size() > 0 %}
            <span data-hh-put-online-versions>
                {{ t("versions", scope: "put_online") }}
                {% each versions as index, version %}<a use:Zenit.route={% version.get("target") %}>{{ version.get("name") }}</a>{% if index < versions.size() - 1 %}, {% /if %}{% /each %}
            </span>
            {% /if %}
        </pl-list-item-meta>
        {% /if %}
    </pl-list-item>
</pl-list>
{% render "zenitcms:form/page-action" var:page=document %}
{% else %}
<pl-stepper totalSteps={% steps.size() %} data-hh-put-online-steps>
    <pl-stepper-indicator totalSteps={% steps.size() %} labels={% steps %}></pl-stepper-indicator>
</pl-stepper>
<form method="get" action={% chooseAction %} data-hh-put-online-chooser>
    <pl-field required={% true %}>
        <pl-label>{{ t("what_question", scope: "put_online") }}</pl-label>
        <pl-choice-group name="choice" required={% true %}>
            {% each groups as group %}
            <pl-choice-section attr:id={% group.get("anchor") %} label={% group.get("heading") %} data-hh-put-online-group={% group.get("token") %}>
                {% each group.get("choices") as choice %}
                <pl-choice-card value={% choice.get("value") %} icon={% choice.get("icon") %}
                                label={% choice.get("label") %} description={% choice.get("description") %}></pl-choice-card>
                {% /each %}
            </pl-choice-section>
            {% /each %}
        </pl-choice-group>
    </pl-field>
    <pl-form-actions>
        <pl-button type="submit" variant="primary" data-hh-put-online-continue>
            <pl-icon name="arrow-right"></pl-icon>
            {{ t("continue", scope: "put_online") }}
        </pl-button>
        <pl-button variant="ghost" use:Zenit.route={% cancelTarget %}>{{ t("cancel", scope: "put_online") }}</pl-button>
    </pl-form-actions>
</form>
{% /if %}
</pl-page>
{% /block %}
