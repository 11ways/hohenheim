{#- Domains tab on a site: hostnames routed to it, linking into the
    (nav-hidden) domain resource forms. -#}
{% declare title: String %}
{% declare siteId: Integer %}
{% declare siteName: String %}
{% declare domains: List %}
{% declare addDomainTarget: RouteTarget = null %}
{% declare requestCertTarget: RouteTarget = null %}
{#- Row affordances are per ROW (domain.canEdit / domain.deleteTarget): the domain
    resource answers write authority record by record, and this page renders exactly
    what it answers. hasRowActions only decides whether the column exists at all. -#}
{% declare hasRowActions: Boolean = true %}
{% declare canAddDomain: Boolean = true %}
{% declare canRequestCert: Boolean = true %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ siteName }}</h1>
        {% if canRequestCert %}
        <pl-button variant="outline" use:Zenit.route={% requestCertTarget %} id="request-cert-link">{{ t("request_certificate", scope: "site_domains") }}</pl-button>
        {% /if %}
        {% if canAddDomain %}<pl-button variant="primary" use:Zenit.route={% addDomainTarget %} id="add-domain-link">{{ t("add_domain", scope: "site_domains") }}</pl-button>{% /if %}
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if domains %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("hostname", scope: "site_domains") }}</pl-table-head>
            <pl-table-head>{{ t("match_type", scope: "site_domains") }}</pl-table-head>
            <pl-table-head>{{ t("ssl", scope: "site_domains") }}</pl-table-head>
            <pl-table-head>{{ t("certificate", scope: "site_domains") }}</pl-table-head>
            {% if hasRowActions %}<pl-table-head></pl-table-head>{% /if %}
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each domains as index, domain %}
            <pl-table-row>
                <pl-table-cell>{% if domain.get("canEdit") == true %}<a use:Zenit.route={% domain.get("editTarget") %}>{{ domain.get("hostname") }}</a>{% else %}{{ domain.get("hostname") }}{% /if %}</pl-table-cell>
                <pl-table-cell><pl-badge variant={% "secondary" %}>{{ domain.get("matchType") }}</pl-badge></pl-table-cell>
                <pl-table-cell>
                    {% if domain.get("forceSsl") == true %}
                    <pl-badge variant={% "default" %}>{{ t("forced", scope: "site_domains") }}</pl-badge>
                    {% else %}
                    <pl-badge variant={% "secondary" %}>{{ t("off", scope: "site_domains") }}</pl-badge>
                    {% /if %}
                </pl-table-cell>
                {#- The certificate's NAME (and its link) render only for a reader who may
                    OPEN it (domain.canOpenCert, the walk's view answer); everyone else
                    reads the coverage state and the expiry, never the operator's
                    certificate name. -#}
                <pl-table-cell data-cert-status={% domain.get("certStatus") %}>
                    {% if domain.get("certStatus") == "active" %}
                    {% if domain.get("canOpenCert") == true %}<a use:Zenit.route={% domain.get("certTarget") %}><pl-badge variant={% "success" %}>{{ domain.get("certName") }}</pl-badge></a>{% else %}<pl-badge variant={% "success" %}>{{ t("covered", scope: "site_domains") }}</pl-badge>{% /if %}
                    {% elseif domain.get("certStatus") == "error" %}
                    {% if domain.get("canOpenCert") == true %}<a use:Zenit.route={% domain.get("certTarget") %}><pl-badge variant={% "destructive" %}>{{ domain.get("certName") }}</pl-badge></a>{% else %}<pl-badge variant={% "destructive" %}>{{ t("not_covered", scope: "site_domains") }}</pl-badge>{% /if %}
                    {% elseif domain.get("certStatus") == "pending" %}
                    {% if domain.get("canOpenCert") == true %}<a use:Zenit.route={% domain.get("certTarget") %}><pl-badge variant={% "warning" %}>{{ domain.get("certName") }}</pl-badge></a>{% else %}<pl-badge variant={% "warning" %}>{{ t("coverage_pending", scope: "site_domains") }}</pl-badge>{% /if %}
                    {% elseif domain.get("certStatus") == "none" %}
                    <pl-badge variant={% "outline" %}>{{ t("none", scope: "site_domains") }}</pl-badge>
                    {% /if %}
                    {% if domain.get("certHasExpiry") == true %}
                    <span class="hh-cert-expiry">{{ t("expires", scope: "site_domains") }} <pl-relative-time datetime={% domain.get("certExpiresIso") %} title={% domain.get("certExpiresIso") %}></pl-relative-time></span>
                    {% /if %}
                </pl-table-cell>
                {#- Row actions: the hostname link opens the form, but a row an operator
                    can add must also be one they can edit and detach from HERE. Remove is
                    a real destructive POST behind the shell's confirm dialog, never a
                    bare link. Each half renders only where the resource said yes, so the
                    cell can hold one, both or neither. -#}
                {% if hasRowActions %}
                <pl-table-cell class="hh-domain-row-actions">
                    {% if domain.get("canEdit") == true %}
                    <a class="hh-domain-edit" use:Zenit.route={% domain.get("editTarget") %}>
                        <pl-icon name="pen" size="sm"></pl-icon>
                        {{ t("edit", scope: "site_domains") }}
                    </a>
                    {% /if %}
                    {% if domain.get("canRemove") == true %}
                    <form use:Zenit.form={% domain.get("deleteTarget") %}
                          use:CmsConfirm.destructive={% t("remove_confirm", scope: "site_domains", hostname: domain.get("hostname")) %}>
                        <pl-button variant={% "ghost" %} type={% "submit" %} size="sm" class="hh-domain-remove">
                            <pl-icon name="trash-can" size="sm"></pl-icon>
                            {{ t("remove", scope: "site_domains") }}
                        </pl-button>
                    </form>
                    {% /if %}
                </pl-table-cell>
                {% /if %}
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="at">
        <pl-empty-state-title>{{ t("empty", scope: "site_domains") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "site_domains") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
