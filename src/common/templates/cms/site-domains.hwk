{#- Domains tab on a site: the framework's child list section over the site's hostnames (rows, edit, remove, add,
    certificate coverage and the certificate request link), inside the tab's own wrapper. -#}
{% declare title: String %}
{% declare siteName: String %}
{% declare sections: List<ChildListSectionState> %}
{% declare panelSlug: String = "" %}
{% declare hostless: Boolean = false %}
{% declare recordTabs: List<RecordTabState> %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ siteName }}</h1>
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {#- A site without a hostname routes nothing: say what this tab is for. -#}
    {% if hostless %}
    <p class="hh-domains-hint">{{ t("empty_description", scope: "site_domains") }}</p>
    {% /if %}

    {% each sections as section key section.resourceSlug %}
    {% render "zenitcms:child-list-section" var:section=section var:panelSlug=panelSlug %}
    {% /each %}
</section>
{% /block %}
