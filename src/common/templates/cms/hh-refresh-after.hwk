{% tag HhRefreshAfter {
    /* Reloads the page at url once, delayMs after it mounts, through the soft-navigation
       runtime. A page renders it only while something it shows is still in flight (the
       Install media tab while a fetch runs), so every reload decides afresh whether
       another one is needed and a settled page never polls.
       The pending tick lives on the ELEMENT, never in a template let (the relative-time
       lesson), and the mount-time Cleanup cancels it when the element disconnects, so a
       navigation away never fires a stale reload. */
    public required url: String
    public delayMs: Integer = 5000

    private timerId: Integer = 0

    style {
        display: none;
    }

    @mount
    function arm() {
        Cleanup.on(this, "refresh-after", () => Timer.clearTimeout(timerId))
        Timer.clearTimeout(timerId)
        timerId = Timer.setTimeout(reload, delayMs)
    }

    function reload() {
        timerId = 0
        Browser.navigateTo(url)
    }

    template {
    }
} %}
