{#- The /manage landing's usage card (board Manage-Home): every budget the operator capped for this tenant, its bar and
    how much of the cap is held. Uncapped budgets are left out, so an installation without caps draws no card. -#}
{% declare widget: WidgetInstance %}
{% declare data: List<UsageLine> = null %}
{% if data != null and data %}
<pl-card data-hh-tenant-usage>
    <pl-card-header>
        <pl-card-title>{{ t("title", scope: "tenant_usage") }}</pl-card-title>
        <pl-card-description>{{ t("lead", scope: "tenant_usage") }}</pl-card-description>
    </pl-card-header>
    <pl-card-content>
        {% each data as line %}
        <div class="hh-tenant-usage-line" data-hh-usage={% line.label %}>
            <span class="hh-tenant-usage-label">{{ line.label }}</span>
            <span class="hh-tenant-usage-amount">{% if line.bytes %}{{ t("of_size", scope: "tenant_usage", used: ByteText.human(line.used), limit: ByteText.human(line.limit)) }}{% else %}{{ t("of_count", scope: "tenant_usage", used: line.used, limit: line.limit) }}{% /if %}</span>
            <pl-usage-bar value={% line.percent %} max={% 100 %} size="sm" ariaLabel={% line.label %}></pl-usage-bar>
        </div>
        {% /each %}
        <p class="hh-tenant-usage-more">{{ t("need_more", scope: "tenant_usage") }}</p>
    </pl-card-content>
</pl-card>
{% /if %}
