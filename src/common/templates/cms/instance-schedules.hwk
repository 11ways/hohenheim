{#- Schedules tab on an instance: its record schedules, linking into the
    (nav-hidden) schedule resource forms. -#}
{% declare title: String %}
{% declare instanceId: Integer %}
{% declare instanceName: String %}
{% declare schedules: List %}
{% declare addScheduleTarget: RouteTarget %}
{% declare canEdit: Boolean = true %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ instanceName }}</h1>
        {% if canEdit %}<pl-button variant="primary" use:Zenit.route={% addScheduleTarget %} id="add-schedule-link">{{ t("add", scope: "instance_schedule") }}</pl-button>{% /if %}
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if schedules %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("name", scope: "instance_schedule") }}</pl-table-head>
            <pl-table-head>{{ t("cron", scope: "instance_schedule") }}</pl-table-head>
            <pl-table-head>{{ t("timezone", scope: "instance_schedule") }}</pl-table-head>
            <pl-table-head>{{ t("state", scope: "instance_schedule") }}</pl-table-head>
            <pl-table-head>{{ t("steps", scope: "instance_schedule") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each schedules as index, schedule %}
            <pl-table-row>
                <pl-table-cell>{% if canEdit %}<a use:Zenit.route={% schedule.get("editTarget") %}>{{ schedule.get("name") }}</a>{% else %}{{ schedule.get("name") }}{% /if %}</pl-table-cell>
                <pl-table-cell><code>{{ schedule.get("cron") }}</code></pl-table-cell>
                <pl-table-cell>{{ schedule.get("timezone") }}</pl-table-cell>
                <pl-table-cell>
                    {% if schedule.get("enabled") == true %}
                    <pl-badge variant={% "success" %}>{{ t("enabled", scope: "instance_schedule") }}</pl-badge>
                    {% else %}
                    <pl-badge variant={% "destructive" %}>{{ t("disabled", scope: "instance_schedule") }}</pl-badge>
                    {% if schedule.get("disabledReason") %} {{ schedule.get("disabledReason") }}{% /if %}
                    {% /if %}
                </pl-table-cell>
                <pl-table-cell><a use:Zenit.route={% schedule.get("stepsTarget") %}>{{ t("steps", scope: "instance_schedule") }}</a></pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="clock">
        <pl-empty-state-title>{{ t("empty", scope: "instance_schedule") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "instance_schedule") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
