{#- Records tab on a DNS zone: the zone's resource records, linking into the
    (nav-hidden) record resource forms. -#}
{% declare title: String %}
{% declare zoneId: Integer %}
{% declare origin: String %}
{% declare records: List<DnsRecordView> %}
{% declare addRecordTarget: RouteTarget %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ origin }}</h1>
        <pl-button variant="primary" use:Zenit.route={% addRecordTarget %} id="add-record-link">{{ t("add_record", scope: "dns_zone") }}</pl-button>
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if records %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("record_name_column", scope: "dns_zone") }}</pl-table-head>
            <pl-table-head>{{ t("record_type_column", scope: "dns_zone") }}</pl-table-head>
            <pl-table-head>{{ t("record_ttl_column", scope: "dns_zone") }}</pl-table-head>
            <pl-table-head>{{ t("record_value_column", scope: "dns_zone") }}</pl-table-head>
            <pl-table-head>{{ t("record_status_column", scope: "dns_zone") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each records as index, record %}
            <pl-table-row>
                <pl-table-cell><a use:Zenit.route={% record.editTarget %}><code>{{ record.name }}</code></a></pl-table-cell>
                <pl-table-cell><pl-badge variant={% "secondary" %}>{{ record.type }}</pl-badge></pl-table-cell>
                <pl-table-cell>{{ record.ttl }}</pl-table-cell>
                <pl-table-cell><code>{{ record.value }}</code></pl-table-cell>
                <pl-table-cell>
                    {% if record.enabled == true %}
                    <pl-badge variant={% "success" %}>{{ t("record_enabled_badge", scope: "dns_zone") }}</pl-badge>
                    {% else %}
                    <pl-badge variant={% "outline" %}>{{ t("record_disabled_badge", scope: "dns_zone") }}</pl-badge>
                    {% /if %}
                    {% if record.managed == true %}
                    <pl-badge variant={% "secondary" %}>{{ t("record_managed_badge", scope: "dns_zone") }}</pl-badge>
                    {% /if %}
                </pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="list-ul">
        <pl-empty-state-title>{{ t("records_empty", scope: "dns_zone") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("records_empty_description", scope: "dns_zone") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
