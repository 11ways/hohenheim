{#- The connection card of a managed database, ONE partial for the admin Restore tab and the tenant Credentials tab:
    the engine and what the database does as badges, where it runs, the database and user, and the password behind its
    reveal (pl-secret-reveal: fetched per press, recorded, never in this page), plus the rows a caller has (the
    instances using the database, the live container host and port). The reveal's server gate decides who reads the
    password; this only draws the control. Its facts are a property list, so a long value (where it runs, a revealed
    password) wraps under its label on a phone instead of widening the page. -#}
{% declare engine: EnumBadgeState = null %}
{% declare status: EnumBadgeState %}
{% declare runsOn: Microcopy = null %}
{% declare dbUser: String %}
{% declare dbName: String %}
{#- The password's reveal, naming the record and the secret (HohenheimSecrets.DATABASE_PASSWORD). -#}
{% declare passwordSecret: SecretRef %}
{% declare containerHost: String = "" %}
{% declare port: String = "" %}
{% declare usedBy: List = null %}
<pl-card data-hh-database-connection>
    <pl-card-header>
        <pl-card-title>{{ t("connection", scope: "database_tab") }}</pl-card-title>
    </pl-card-header>
    <pl-card-content>
        <pl-property-list>
            <pl-property label={% t("engine", scope: "database_tab") %} data-hh-database-engine>{% render "zenitcms:cell/enum-badge" var:value=engine %}</pl-property>
            <pl-property label={% t("state", scope: "database_tab") %} data-hh-database-state>{% render "zenitcms:cell/enum-badge" var:value=status %}</pl-property>
            {% if runsOn != null %}
            <pl-property label={% t("runs_on", scope: "database_overview") %}>{{ runsOn }}</pl-property>
            {% /if %}
            <pl-property label={% t("database", scope: "database_tab") %}>{{ dbName }}</pl-property>
            <pl-property label={% t("user", scope: "database_tab") %}>{{ dbUser }}</pl-property>
            <pl-property label={% t("password", scope: "database_tab") %} data-hh-database-password>
                <pl-secret-reveal secret={% passwordSecret %}
                                  copyLabel={% t("copy_password", scope: "database_tab") %}></pl-secret-reveal>
            </pl-property>
            {% if usedBy %}
            <pl-property label={% t("used_by", scope: "database_tab") %}>
                {% each usedBy as index, site %}
                <a use:Zenit.route={% site.get("target") %}><pl-badge variant={% "secondary" %}>{{ site.get("name") }}</pl-badge></a>
                {% /each %}
            </pl-property>
            {% /if %}
            {% if containerHost != "" %}
            <pl-property label={% t("container_host", scope: "database_tab") %}><code>{{ containerHost }}</code></pl-property>
            {% /if %}
            {% if port != "" %}
            <pl-property label={% t("port", scope: "database_tab") %}><code>{{ port }}</code></pl-property>
            {% /if %}
        </pl-property-list>
    </pl-card-content>
</pl-card>
