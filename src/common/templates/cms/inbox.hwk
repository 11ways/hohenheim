{#- The operator's own notification inbox: zenit-notifications' inbox screen (znt-inbox-page: Unread / All, one card
    per record, its pager) under the panel's page header, "Mark all read" in the header's actions. This page owns only
    the route and the heading (zenitcms:page-header, so a cluster landing has one h1). -#}
{% declare title: String %}
{% declare page: NotificationInboxPageView %}
{% declare lead: Microcopy %}
{#- True on the Activity cluster's landing, headed by its cluster (CmsClusterDecorator): the page header draws no h1. -#}
{% declare headedByCluster: Boolean = false %}
{% extend "zenitcms:shell" var:title=title %}

{% snippet markAll() %}<znt-inbox-mark-all target={% page.markAllTarget %}></znt-inbox-mark-all>{% /snippet %}

{% block "main" %}
<section class="cms-resource-form-page" data-admin-inbox>
    {% render "zenitcms:page-header" var:title=title var:lead=lead var:actions=markAll %}

    <znt-inbox-page page={% page %}></znt-inbox-page>
</section>
{% /block %}
