{#- Shell tab on an instance: an interactive pseudo-terminal inside the workload,
    running as the workload's own non-root uid. Unlike the console tab this
    terminal is WRITABLE -- a PTY echoes, so keystrokes ride the socket. -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare instanceId: Integer %}
{% declare running: Boolean = false %}
{% declare available: Boolean = false %}
{% declare unsupportedRuntime: Boolean = false %}
{% declare runsAsRoot: Boolean = false %}
{% declare maxSessions: Integer = 0 %}
{% declare idleMinutes: Integer = 0 %}
{% declare shellWsUrl: String %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
    <section class="cms-resource-list-page">
        <header class="cms-resource-list-header">
            <h1>{{ instanceName }}</h1>
        </header>

        {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
        {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

        {% if unsupportedRuntime %}
            <pl-empty-state icon="terminal" attr:data-shell-unsupported={% true %}>
                <pl-empty-state-title>{{ t("unsupported_runtime", scope: "instance_shell") }}</pl-empty-state-title>
                <pl-empty-state-description>{{ t("unsupported_runtime_description", scope: "instance_shell") }}</pl-empty-state-description>
            </pl-empty-state>
        {% elseif runsAsRoot %}
            <pl-empty-state icon="shield-halved" attr:data-shell-runs-as-root={% true %}>
                <pl-empty-state-title>{{ t("runs_as_root", scope: "instance_shell") }}</pl-empty-state-title>
                <pl-empty-state-description>{{ t("runs_as_root_description", scope: "instance_shell") }}</pl-empty-state-description>
            </pl-empty-state>
        {% elseif !running %}
            <pl-empty-state icon="terminal" attr:data-shell-not-running={% true %}>
                <pl-empty-state-title>{{ t("not_running", scope: "instance_shell") }}</pl-empty-state-title>
                <pl-empty-state-description>{{ t("not_running_description", scope: "instance_shell") }}</pl-empty-state-description>
            </pl-empty-state>
        {% else %}
            <pl-card attr:data-shell-available={% true %}>
                <pl-card-header>
                    <pl-card-title>{{ t("title", scope: "instance_shell") }}</pl-card-title>
                    <pl-card-description>{{ t("description", scope: "instance_shell") }}</pl-card-description>
                </pl-card-header>
                <pl-card-content>
                    {#- readOnly is FALSE here (the console tab's terminal is read-only):
                        this socket carries keystrokes up and the pseudo-terminal echoes
                        them back, and pl-terminal already forwards its own resize. -#}
                    <pl-terminal
                        rows={% 30{:} %}
                        cols={% 100{:} %}
                        readOnly={% false %}
                        wsUrl={% shellWsUrl %}>
                    </pl-terminal>
                    <p class="instance-console-hint">{{ t("limits_hint", scope: "instance_shell", sessions: maxSessions, minutes: idleMinutes) }}</p>
                    <p class="instance-console-hint">{{ t("audit_hint", scope: "instance_shell") }}</p>
                </pl-card-content>
            </pl-card>
        {% /if %}
    </section>
{% /block %}
