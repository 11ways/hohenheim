{#- Runtime settings editor: applies to the live context and persists into
    settings/local.dry through the host-declared POST /admin/settings. -#}
{% declare title: String %}
{% declare saved: String = "" %}
{% declare error: String = "" %}
{% declare proxyHttpPort: Integer %}
{% declare proxyHttpsPort: Integer %}
{% declare proxyFallback: String = "" %}
{% declare proxyForceHttps: Boolean %}
{% declare proxyIpv6Address: String = "" %}
{% declare adminPort: Integer %}
{% declare dbPath: String %}
{% declare logAccessToDb: Boolean %}
{% declare logAccessToFile: Boolean %}
{% declare logAccessPath: String %}
{% declare secLogDomainMisses: Boolean %}
{% declare secDomainMissThreshold: Integer %}
{% declare sslLeEnabled: Boolean %}
{% declare sslLeEmail: String = "" %}
{% declare sslLeStaging: Boolean %}
{% declare flashMessage: Microcopy = null %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-form-page">
    <header class="cms-resource-list-header">
        <h1>{{ title }}</h1>
    </header>

    {% if saved != "" %}
    <pl-alert variant="success">Settings saved to settings/local.dry.</pl-alert>
    {% /if %}
    {% if error != "" %}
    <pl-alert variant="destructive">{{ error }}</pl-alert>
    {% /if %}

    <form method="POST" action="/admin/settings">
        {% csrf() %}

        <pl-card>
            <pl-card-header><pl-card-title>Proxy</pl-card-title></pl-card-header>
            <pl-card-content>
                <pl-field>
                    <pl-label target="proxy_http_port">HTTP port</pl-label>
                    <pl-input inputId="proxy_http_port" type={% "number" %} name={% "proxy_http_port" %} value={% "" + proxyHttpPort %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-label target="proxy_https_port">HTTPS port</pl-label>
                    <pl-input inputId="proxy_https_port" type={% "number" %} name={% "proxy_https_port" %} value={% "" + proxyHttpsPort %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-label target="proxy_fallback">Fallback address</pl-label>
                    <pl-input inputId="proxy_fallback" type={% "text" %} name={% "proxy_fallback" %} value={% proxyFallback %} placeholder={% "http://127.0.0.1:8080" %}></pl-input>
                    <pl-field-description>Requests that match no site are forwarded here.</pl-field-description>
                </pl-field>
                <pl-field>
                    <pl-label target="proxy_ipv6_address">IPv6 address</pl-label>
                    <pl-input inputId="proxy_ipv6_address" type={% "text" %} name={% "proxy_ipv6_address" %} value={% proxyIpv6Address %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-checkbox inputId="proxy_force_https" name="proxy_force_https" checked={% proxyForceHttps %}></pl-checkbox>
                    <pl-label target="proxy_force_https">Redirect HTTP to HTTPS globally</pl-label>
                </pl-field>
                <pl-field>
                    <pl-label target="admin_port">Admin port (read-only)</pl-label>
                    <pl-input inputId="admin_port" type={% "text" %} value={% "" + adminPort %} disabled={% true %}></pl-input>
                    <pl-field-description>The admin UI listens on Zenit's network.port setting.</pl-field-description>
                </pl-field>
            </pl-card-content>
        </pl-card>

        <pl-card>
            <pl-card-header><pl-card-title>Logging</pl-card-title></pl-card-header>
            <pl-card-content>
                <pl-field>
                    <pl-checkbox inputId="log_access_to_db" name="log_access_to_db" checked={% logAccessToDb %}></pl-checkbox>
                    <pl-label target="log_access_to_db">Log access requests to database</pl-label>
                </pl-field>
                <pl-field>
                    <pl-checkbox inputId="log_access_to_file" name="log_access_to_file" checked={% logAccessToFile %}></pl-checkbox>
                    <pl-label target="log_access_to_file">Log access requests to file</pl-label>
                </pl-field>
                <pl-field>
                    <pl-label target="log_access_path">Access log path</pl-label>
                    <pl-input inputId="log_access_path" type={% "text" %} name={% "log_access_path" %} value={% logAccessPath %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-label target="db_path">Database file (read-only)</pl-label>
                    <pl-input inputId="db_path" type={% "text" %} value={% dbPath %} disabled={% true %}></pl-input>
                </pl-field>
            </pl-card-content>
        </pl-card>

        <pl-card>
            <pl-card-header><pl-card-title>Security</pl-card-title></pl-card-header>
            <pl-card-content>
                <pl-field>
                    <pl-checkbox inputId="sec_log_domain_misses" name="sec_log_domain_misses" checked={% secLogDomainMisses %}></pl-checkbox>
                    <pl-label target="sec_log_domain_misses">Log unmatched domains for fail2ban</pl-label>
                </pl-field>
                <pl-field>
                    <pl-label target="sec_domain_miss_threshold">Domain-miss ban threshold</pl-label>
                    <pl-input inputId="sec_domain_miss_threshold" type={% "number" %} name={% "sec_domain_miss_threshold" %} value={% "" + secDomainMissThreshold %}></pl-input>
                </pl-field>
            </pl-card-content>
        </pl-card>

        <pl-card>
            <pl-card-header><pl-card-title>TLS / Let's Encrypt</pl-card-title></pl-card-header>
            <pl-card-content>
                <pl-field>
                    <pl-checkbox inputId="ssl_le_enabled" name="ssl_le_enabled" checked={% sslLeEnabled %}></pl-checkbox>
                    <pl-label target="ssl_le_enabled">Enable automatic Let's Encrypt certificates</pl-label>
                </pl-field>
                <pl-field>
                    <pl-label target="ssl_le_email">Account email</pl-label>
                    <pl-input inputId="ssl_le_email" type={% "email" %} name={% "ssl_le_email" %} value={% sslLeEmail %}></pl-input>
                </pl-field>
                <pl-field>
                    <pl-checkbox inputId="ssl_le_staging" name="ssl_le_staging" checked={% sslLeStaging %}></pl-checkbox>
                    <pl-label target="ssl_le_staging">Use the Let's Encrypt staging server</pl-label>
                </pl-field>
            </pl-card-content>
        </pl-card>

        <div class="cms-form-actions">
            <pl-button variant={% "primary" %} type={% "submit" %}>Save Settings</pl-button>
        </div>
    </form>
</section>
{% /block %}
