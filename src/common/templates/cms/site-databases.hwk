{#- Databases tab on a site: attached managed databases whose connection
    details are injected into the site's processes as env variables. -#}
{% declare title: String %}
{% declare siteId: Integer %}
{% declare siteName: String %}
{% declare links: List<SiteDatabaseLinkView> %}
{% declare attachDatabaseTarget: RouteTarget %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ siteName }}</h1>
        <pl-button variant="primary" use:Zenit.route={% attachDatabaseTarget %} id="attach-database-link">{{ t("attach", scope: "site_databases") }}</pl-button>
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if links %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("database", scope: "site_databases") }}</pl-table-head>
            <pl-table-head>{{ t("engine", scope: "site_databases") }}</pl-table-head>
            <pl-table-head>{{ t("status", scope: "site_databases") }}</pl-table-head>
            <pl-table-head>{{ t("env_prefix", scope: "site_databases") }}</pl-table-head>
            <pl-table-head>{{ t("variables", scope: "site_databases") }}</pl-table-head>
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each links as index, link %}
            <pl-table-row>
                <pl-table-cell>
                    <a use:Zenit.route={% link.editTarget %}>{% if link.missing %}{{ t("deleted_database", scope: "site_databases") }}{% else %}{{ link.dbName }}{% /if %}</a>
                    {% if link.primary %}
                    <pl-badge variant={% "outline" %}>{{ t("primary", scope: "site_databases") }}</pl-badge>
                    {% /if %}
                </pl-table-cell>
                <pl-table-cell>{{ link.engine }}</pl-table-cell>
                {#- The badge is the model's own EnumField state, so every declared status
                    keeps its label/icon/colour. "missing" is the ONE synthetic case and is
                    rendered on its own, never as a status token. -#}
                <pl-table-cell data-db-status={% link.missing ? "missing" : (link.status != null ? link.status.key : "") %}>
                    {% if link.missing %}
                    <pl-badge variant={% "destructive" %}>{{ t("missing_database", scope: "site_databases") }}</pl-badge>
                    {% elseif link.dbTarget != null %}
                    <a use:Zenit.route={% link.dbTarget %}>{% render "zenitcms:cell/enum-badge" var:value=link.status %}</a>
                    {% else %}
                    {% render "zenitcms:cell/enum-badge" var:value=link.status %}
                    {% /if %}
                </pl-table-cell>
                <pl-table-cell><code>{{ link.prefix }}</code></pl-table-cell>
                <pl-table-cell><code>{{ link.varNames }}</code></pl-table-cell>
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="database">
        <pl-empty-state-title>{{ t("empty", scope: "site_databases") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "site_databases") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
