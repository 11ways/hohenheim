{#- Protected paths tab on a site: guarded folder prefixes and the access list each one
    demands, linking into the (nav-hidden) protected-path resource forms. -#}
{% declare title: String %}
{% declare siteId: Integer %}
{% declare siteName: String %}
{% declare paths: List %}
{% declare addTarget: RouteTarget = null %}
{#- Row affordances are per ROW (entry.canEdit / entry.deleteTarget): the resource
    answers write authority record by record, and this page renders exactly what it
    answers. hasRowActions only decides whether the column exists at all. -#}
{% declare hasRowActions: Boolean = true %}
{% declare canAdd: Boolean = true %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% declare flashVariant: String = "default" %}
{% declare flashDuration: Integer = 0 %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-list-page">
    <header class="cms-resource-list-header">
        <h1>{{ siteName }}</h1>
        {% if canAdd %}<pl-button variant="primary" use:Zenit.route={% addTarget %} id="add-protected-path-link">{{ t("add_protected_path", scope: "site_protected_paths") }}</pl-button>{% /if %}
    </header>

    {% render "zenitcms:flash-toast" var:flashMessage=flashMessage var:flashVariant=flashVariant var:flashDuration=flashDuration %}
    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if paths %}
    <pl-table>
        <pl-table-header><pl-table-row>
            <pl-table-head>{{ t("path", scope: "site_protected_paths") }}</pl-table-head>
            <pl-table-head>{{ t("access_list", scope: "site_protected_paths") }}</pl-table-head>
            {% if hasRowActions %}<pl-table-head></pl-table-head>{% /if %}
        </pl-table-row></pl-table-header>
        <pl-table-body>
            {% each paths as index, entry %}
            <pl-table-row>
                <pl-table-cell>{% if entry.get("canEdit") == true %}<a use:Zenit.route={% entry.get("editTarget") %}>{{ entry.get("path") }}</a>{% else %}{{ entry.get("path") }}{% /if %}</pl-table-cell>
                <pl-table-cell><pl-badge variant={% "secondary" %}>{{ entry.get("listName") }}</pl-badge></pl-table-cell>
                {% if hasRowActions %}
                <pl-table-cell class="hh-protected-path-row-actions">
                    {% if entry.get("canEdit") == true %}
                    <a class="hh-protected-path-edit" use:Zenit.route={% entry.get("editTarget") %}>
                        <pl-icon name="pen" size="sm"></pl-icon>
                        {{ t("edit", scope: "site_protected_paths") }}
                    </a>
                    {% /if %}
                    {% if entry.get("canRemove") == true %}
                    <form use:Zenit.form={% entry.get("deleteTarget") %}
                          use:CmsConfirm.destructive={% t("remove_confirm", scope: "site_protected_paths", path: entry.get("path")) %}>
                        <pl-button variant={% "ghost" %} type={% "submit" %} size="sm" class="hh-protected-path-remove">
                            <pl-icon name="trash-can" size="sm"></pl-icon>
                            {{ t("remove", scope: "site_protected_paths") }}
                        </pl-button>
                    </form>
                    {% /if %}
                </pl-table-cell>
                {% /if %}
            </pl-table-row>
            {% /each %}
        </pl-table-body>
    </pl-table>
    {% else %}
    <pl-empty-state icon="lock">
        <pl-empty-state-title>{{ t("empty", scope: "site_protected_paths") }}</pl-empty-state-title>
        <pl-empty-state-description>{{ t("empty_description", scope: "site_protected_paths") }}</pl-empty-state-description>
    </pl-empty-state>
    {% /if %}
</section>
{% /block %}
