{% tag HhSecretReveal {
    /* One record's stored secret, fetched PER PRESS and never rendered into the page: a value that ships with the page
       is in the HTML, the hydration payload and every cache between here and the browser whether or not anyone
       pressed anything. The server (SecretReveals) re-asks the secret's gate, records the reveal and answers no-store;
       this control is an affordance, not the boundary. Hiding DROPS the value, so a second look is a second recorded
       reveal, and the copy button copies what the press fetched. */
    public required secret: String
    public required recordId: Integer
    /* The copy button's accessible name ("Copy password"). */
    attribute copyLabel: String = ""

    private value: String = null
    private failed: Boolean = false

    style {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--pl-space-2xs);

        .hh-secret-value {
            font-family: var(--pl-font-family-mono);
            font-size: var(--pl-font-size-sm);
            word-break: break-all;
        }

        .hh-secret-error {
            color: var(--pl-color-destructive-strong);
            font-size: var(--pl-font-size-sm);
        }
    }

    function toggle() {
        if value != null {
            value = null
            failed = false
            return
        }
        let revealed: String = SecretReveal.reveal(secret, recordId)
        if revealed == null {
            failed = true
            return
        }
        failed = false
        value = revealed
    }

    template {
        <pl-button type="button" variant="ghost" size="sm" data-hh-secret-reveal event:click={% toggle() %}>
            <pl-icon name={% value{:} != null ? "eye-slash" : "eye" %} size="xs"></pl-icon>
            {% if value{:} != null %}{{ t("hide_secret", scope: "cms") }}{% else %}{{ t("reveal_secret", scope: "cms") }}{% /if %}
        </pl-button>
        {% if value{:} != null %}
        <code class="hh-secret-value" data-hh-secret-value>{{ value{:} }}</code>
        <pl-copy-button value={% value{:} %} ariaLabel={% copyLabel{:} %} data-hh-secret-copy></pl-copy-button>
        {% /if %}
        {% if failed{:} %}
        <span class="hh-secret-error" data-hh-secret-failed>{{ t("reveal_failed", scope: "cms") }}</span>
        {% /if %}
    }
} %}
