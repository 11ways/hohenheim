{#- Console tab on an instance: the live output terminal (instance-console
    WebSocket) and the command form (POST; a non-TTY container echoes nothing,
    so input never rides raw terminal keystrokes). -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare instanceId: Integer %}
{% declare status: String %}
{% declare running: Boolean = false %}
{% declare stopCommand: String = "" %}
{% declare commandError: String = "" %}
{% declare returnUrl: String = "" %}
{#- ReturnTarget.PARAM, supplied by the page: ReturnTarget lives in zenit's SERVER
    source set, so a common template cannot reach the constant (nor its
    Zenit.Params.zenit.return_to identifier). Never spell "_return" here by hand. -#}
{% declare returnParam: String %}
{% declare storedLogs: List %}
{% declare selectedLogText: String = "" %}
{% declare selectedLogTitle: String = "" %}
{% declare commandTarget: RouteTarget %}
{% declare consoleWsUrl: String %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
    <section class="cms-resource-list-page">
        <header class="cms-resource-list-header">
            <h1>{{ instanceName }}</h1>
        </header>

        {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

        {% if commandError != "" %}
            <pl-alert variant="destructive">{{ commandError }}</pl-alert>
        {% /if %}

        {% if running %}
            <pl-card>
                <pl-card-header>
                    <pl-card-title>{{ t("title", scope: "instance_console") }}</pl-card-title>
                    <pl-card-description>{{ t("description", scope: "instance_console") }}</pl-card-description>
                </pl-card-header>
                <pl-card-content>
                    <pl-terminal
                        rows={% 24{:} %}
                        cols={% 100{:} %}
                        readOnly={% true %}
                        wsUrl={% consoleWsUrl %}>
                    </pl-terminal>
                    <form use:Zenit.form={% commandTarget %} class="instance-console-command">
                        <input type="hidden" name={% returnParam %} value={% returnUrl %}>
                        <pl-input name="command" placeholder={% t("command_placeholder", scope: "instance_console") %}></pl-input>
                        <pl-button variant="outline" type={% "submit" %}>{{ t("send", scope: "instance_console") }}</pl-button>
                    </form>
                    {% if stopCommand != "" %}
                        <p class="instance-console-hint">{{ t("stop_hint", scope: "instance_console", command: stopCommand) }}</p>
                    {% /if %}
                </pl-card-content>
            </pl-card>
        {% else %}
            <pl-empty-state icon="terminal">
                <pl-empty-state-title>{{ t("not_running", scope: "instance_console") }}</pl-empty-state-title>
                <pl-empty-state-description>{{ t("not_running_description", scope: "instance_console") }}</pl-empty-state-description>
            </pl-empty-state>
        {% /if %}

        <pl-card>
            <pl-card-header>
                <pl-card-title>{{ t("stored_logs", scope: "instance_console") }}</pl-card-title>
                <pl-card-description>{{ t("stored_logs_description", scope: "instance_console") }}</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                {% if storedLogs %}
                <pl-table>
                    <pl-table-header><pl-table-row>
                        <pl-table-head>{{ t("captured", scope: "instance_console") }}</pl-table-head>
                        <pl-table-head>{{ t("lines", scope: "instance_console") }}</pl-table-head>
                        <pl-table-head>{{ t("workload", scope: "instance_console") }}</pl-table-head>
                    </pl-table-row></pl-table-header>
                    <pl-table-body>
                        {% each storedLogs as index, log %}
                        <pl-table-row>
                            <pl-table-cell><a use:Zenit.route={% log.get("target") %}>{{ log.get("createdAt") }}</a></pl-table-cell>
                            <pl-table-cell>{{ log.get("lineCount") }}</pl-table-cell>
                            <pl-table-cell>{{ log.get("handle") }}</pl-table-cell>
                        </pl-table-row>
                        {% /each %}
                    </pl-table-body>
                </pl-table>
                {% else %}
                <p>{{ t("no_logs", scope: "instance_console") }}</p>
                {% /if %}
            </pl-card-content>
        </pl-card>

        {% if selectedLogText != "" %}
        <pl-card>
            <pl-card-header>
                <pl-card-title>{{ t("stored_log", scope: "instance_console", title: selectedLogTitle) }}</pl-card-title>
            </pl-card-header>
            <pl-card-content>
                {#- Redacted at ingest, but still the workload's stdout VERBATIM, and a
                    tenant dictates what a workload prints. It is TEXT: {{ }} builds a
                    text node, so nothing in it can ever become markup. Never render it
                    as HTML. -#}
                <div class="hh-proclog-content">{{ selectedLogText }}</div>
            </pl-card-content>
        </pl-card>
        {% /if %}
    </section>
{% /block %}
