{#- Restore tab on a managed database: connection info plus the dump-upload
    form posting to the host-declared restore endpoint. -#}
{% declare title: String %}
{% declare name: String %}
{% declare engine: String %}
{% declare status: String %}
{% declare dbUser: String %}
{% declare dbPassword: String %}
{% declare dbName: String %}
{% declare restoreUrl: String %}
{% declare usedBy: List = null %}
{% declare recordTabs: List<RecordTabState> %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
<section class="cms-resource-form-page">
    <header class="cms-resource-list-header">
        <h1>{{ title }}</h1>
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% render "hohenheim:cms/database-connection" var:engine=engine var:status=status var:dbName=dbName var:dbUser=dbUser
        var:dbPassword=dbPassword var:usedBy=usedBy %}

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("restore_dump", scope: "database_tab") }}</pl-card-title>
            <pl-card-description>{{ t("restore_description", scope: "database_tab") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <form method="POST" action={% restoreUrl %} enctype="multipart/form-data">
                {% csrf() %}
                <pl-field>
                    <pl-label target="dump">{{ t("dump_file", scope: "database_tab") }}</pl-label>
                    <input id="dump" type="file" name="dump" required>
                </pl-field>
                <div class="cms-form-actions">
                    <pl-button variant={% "destructive" %} type={% "submit" %}>{{ t("restore", scope: "database_tab") }}</pl-button>
                </div>
            </form>
        </pl-card-content>
    </pl-card>
</section>
{% /block %}
