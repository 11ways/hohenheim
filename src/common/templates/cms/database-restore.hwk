{#- Restore tab on a managed database: connection info plus the dump-upload
    form posting to the host-declared restore endpoint. -#}
{% declare title: String %}
{% declare name: String %}
{% declare engine: String %}
{% declare status: String %}
{% declare dbUser: String %}
{% declare dbPassword: String %}
{% declare dbName: String %}
{% declare restoreUrl: String %}
{% declare error: String = "" %}
{% declare restored: Boolean = false %}
{% declare usedBy: List = null %}
{% declare recordTabs: List<RecordTabState> %}
{% declare flashMessage: Microcopy = null %}
{% extend "zenitcms:shell" var:title=title var:flashMessage=flashMessage %}

{% block "main" %}
<section class="cms-resource-form-page">
    <header class="cms-resource-list-header">
        <h1>{{ title }}</h1>
    </header>

    {% render "zenitcms:record-tabs" var:tabs=recordTabs %}

    {% if restored %}
    <pl-alert variant="success">{{ t("restored", scope: "database_tab", name: dbName) }}</pl-alert>
    {% /if %}
    {% if error != "" %}
    <pl-alert variant="destructive">{{ error }}</pl-alert>
    {% /if %}

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("connection", scope: "database_tab") }}</pl-card-title>
            <pl-card-description>{{ t("status", scope: "database_tab", status: status) }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <pl-table>
                <pl-table-body>
                    <pl-table-row>
                        <pl-table-cell>{{ t("engine", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>{{ engine }}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("database", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>{{ dbName }}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("user", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>{{ dbUser }}</pl-table-cell>
                    </pl-table-row>
                    <pl-table-row>
                        <pl-table-cell>{{ t("password", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>
                            <code>{{ dbPassword }}</code>
                            <pl-copy-button value={% dbPassword %} ariaLabel={% t("copy_password", scope: "database_tab") %}></pl-copy-button>
                        </pl-table-cell>
                    </pl-table-row>
                    {% if usedBy %}
                    <pl-table-row>
                        <pl-table-cell>{{ t("used_by", scope: "database_tab") }}</pl-table-cell>
                        <pl-table-cell>
                            {% each usedBy as index, site %}
                            <a use:Zenit.route={% site.get("target") %}><pl-badge variant={% "secondary" %}>{{ site.get("name") }}</pl-badge></a>
                            {% /each %}
                        </pl-table-cell>
                    </pl-table-row>
                    {% /if %}
                </pl-table-body>
            </pl-table>
        </pl-card-content>
    </pl-card>

    <pl-card>
        <pl-card-header>
            <pl-card-title>{{ t("restore_dump", scope: "database_tab") }}</pl-card-title>
            <pl-card-description>{{ t("restore_description", scope: "database_tab") }}</pl-card-description>
        </pl-card-header>
        <pl-card-content>
            <form method="POST" action={% restoreUrl %} enctype="multipart/form-data">
                {% csrf() %}
                <pl-field>
                    <pl-label target="dump">{{ t("dump_file", scope: "database_tab") }}</pl-label>
                    <input id="dump" type="file" name="dump" required>
                </pl-field>
                <div class="cms-form-actions">
                    <pl-button variant={% "destructive" %} type={% "submit" %}>{{ t("restore", scope: "database_tab") }}</pl-button>
                </div>
            </form>
        </pl-card-content>
    </pl-card>
</section>
{% /block %}
