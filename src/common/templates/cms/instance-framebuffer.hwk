{#- Framebuffer rescue console for a VM instance: server-captured VGA snapshots
    stream down as binary frames, keyboard input rides back up. VM kinds only
    (the tab hides on containers). -#}
{% declare title: String %}
{% declare instanceName: String %}
{% declare instanceId: Integer %}
{% declare running: Boolean = false %}
{% declare framebufferWsUrl: String %}
{% declare head: RecordHeadState = null %}
{% declare consoleModes: List<ConsoleModeView> %}
{% extend "zenitcms:shell" var:title=title %}

{% block "main" %}
    <section class="cms-resource-list-page">
        {% if head != null %}{% render "zenitcms:record-head" var:head=head %}{% /if %}

        {% render "hohenheim:cms/console-modes" var:modes=consoleModes %}

        {% if running %}
            <pl-card>
                <pl-card-header>
                    <pl-card-title>{{ t("title", scope: "instance_framebuffer") }}</pl-card-title>
                    <pl-card-description>{{ t("description", scope: "instance_framebuffer") }}</pl-card-description>
                </pl-card-header>
                <pl-card-content>
                    <pl-framebuffer
                        interactive={% true %}
                        wsUrl={% framebufferWsUrl %}>
                    </pl-framebuffer>
                    <p class="instance-console-hint">{{ t("hint", scope: "instance_framebuffer") }}</p>
                </pl-card-content>
            </pl-card>
        {% else %}
            <pl-empty-state icon="display">
                <pl-empty-state-title>{{ t("not_running", scope: "instance_framebuffer") }}</pl-empty-state-title>
                <pl-empty-state-description>{{ t("not_running_description", scope: "instance_framebuffer") }}</pl-empty-state-description>
            </pl-empty-state>
        {% /if %}
    </section>
{% /block %}
