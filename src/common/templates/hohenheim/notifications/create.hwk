{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}

    <header class="hh-header">
        <h1 class="hh-header__title">Add Channel</h1>
    </header>
    <main class="hh-content">

        {% if error != "" %}
            <pl-alert variant={% "destructive" %} class="hh-form-error">
                <pl-alert-title>Error</pl-alert-title>
                <pl-alert-description>{{ error }}</pl-alert-description>
            </pl-alert>
        {% /if %}

        <form method="POST" action="/notifications/create">
            <pl-card class="hh-form-card">
                <pl-card-header>
                    <pl-card-title>Webhook Channel</pl-card-title>
                    <pl-card-description>POSTs a JSON body to the given URL.</pl-card-description>
                </pl-card-header>
                <pl-card-content>
                    <div class="hh-form-stack">
                        <div class="hh-form-group">
                            <pl-label target="name">Name</pl-label>
                            <pl-input id="name" type={% "text" %} name={% "name" %} placeholder={% "ops-alerts" %} required={% true %}></pl-input>
                            <p class="hh-form-hint">Lowercase letters, digits, and dashes.</p>
                        </div>
                        <div class="hh-form-group">
                            <pl-label target="format">Format</pl-label>
                            <pl-select name="format" value="slack">
                                <pl-select-trigger placeholder="Format"></pl-select-trigger>
                                <pl-select-content>
                                    <pl-select-item value="slack" label="Slack">Slack</pl-select-item>
                                    <pl-select-item value="discord" label="Discord">Discord</pl-select-item>
                                    <pl-select-item value="generic" label="Generic JSON">Generic JSON</pl-select-item>
                                </pl-select-content>
                            </pl-select>
                            <p class="hh-form-hint">Slack and Discord shape the JSON body for those services; generic sends a subject+message envelope.</p>
                        </div>
                        <div class="hh-form-group">
                            <pl-label target="url">URL</pl-label>
                            <pl-input id="url" type={% "text" %} name={% "url" %} placeholder={% "https://hooks.example.com/..." %} required={% true %}></pl-input>
                        </div>
                    </div>
                </pl-card-content>
            </pl-card>

            <div class="hh-form-actions">
                <pl-button variant={% "primary" %} type={% "submit" %}>Add Channel</pl-button>
                <a href="/notifications" class="hh-button-link"><pl-button variant={% "outline" %} type={% "button" %}>Cancel</pl-button></a>
            </div>
        </form>

    </main>
{% /block %}
