{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}
    {% declare values: Map = null %}
    {% let v = values != null ? values : Map.create() %}

    <hh-page title={% "Add Channel" %}>
        <hh-form-shell
            action={% "/notifications/create" %}
            title={% "Webhook Channel" %}
            description={% "POSTs a JSON body to the given URL." %}
            submitLabel={% "Add Channel" %}
            cancelHref={% "/notifications" %}
            error={% error %}>
            <div class="hh-form-group">
                <pl-label target="name">Name</pl-label>
                <pl-input id="name" type={% "text" %} name={% "name" %} value={% v.getString("name", "") %} placeholder={% "ops-alerts" %} required={% true %}></pl-input>
                <p class="hh-form-hint">Lowercase letters, digits, and dashes.</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="format">Format</pl-label>
                <pl-select id="format" name="format" value={% v.getString("format", "slack") %}>
                    <pl-select-trigger placeholder="Format"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="slack" label="Slack">Slack</pl-select-item>
                        <pl-select-item value="discord" label="Discord">Discord</pl-select-item>
                        <pl-select-item value="generic" label="Generic JSON">Generic JSON</pl-select-item>
                    </pl-select-content>
                </pl-select>
                <p class="hh-form-hint">Slack and Discord shape the JSON body for those services; generic sends a subject+message envelope.</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="url">URL</pl-label>
                <pl-input id="url" type={% "text" %} name={% "url" %} value={% v.getString("url", "") %} placeholder={% "https://hooks.example.com/..." %} required={% true %}></pl-input>
            </div>
        </hh-form-shell>
    </hh-page>
{% /block %}
