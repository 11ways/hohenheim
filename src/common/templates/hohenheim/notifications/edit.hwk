{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}
    {% declare name: String %}
    {% declare format: String %}
    {% declare url: String %}

    <hh-page title={% "Edit Channel" %}>
        <hh-form-shell
            action={% "/notifications/" + name %}
            title={% name %}
            description={% "Update the webhook format or URL for this channel." %}
            submitLabel={% "Save Channel" %}
            cancelHref={% "/notifications" %}
            error={% error %}>
            <div class="hh-form-group">
                <pl-label>Name</pl-label>
                <pl-input type={% "text" %} value={% name %} disabled={% true %}></pl-input>
                <p class="hh-form-hint">The name identifies the channel and cannot be changed.</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="format">Format</pl-label>
                <pl-select id="format" name="format" value={% format %}>
                    <pl-select-trigger placeholder="Format"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="slack" label="Slack">Slack</pl-select-item>
                        <pl-select-item value="discord" label="Discord">Discord</pl-select-item>
                        <pl-select-item value="generic" label="Generic JSON">Generic JSON</pl-select-item>
                    </pl-select-content>
                </pl-select>
            </div>
            <div class="hh-form-group">
                <pl-label target="url">URL</pl-label>
                <pl-input id="url" type={% "text" %} name={% "url" %} value={% url %} placeholder={% "https://hooks.example.com/..." %} required={% true %}></pl-input>
            </div>
        </hh-form-shell>
    </hh-page>
{% /block %}
