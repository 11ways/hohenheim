{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare channels: List %}
    {% declare testResult: String = "" %}
    {% declare testChannel: String = "" %}

    <hh-page title={% "Notifications" %}>
        {% if testResult == "ok" %}
            <pl-alert variant={% "default" %} class="hh-form-success">
                <pl-alert-description>Test message delivered to {{ testChannel }}.</pl-alert-description>
            </pl-alert>
        {% elseif testResult == "failed" %}
            <pl-alert variant={% "destructive" %} class="hh-form-error">
                <pl-alert-title>Test failed</pl-alert-title>
                <pl-alert-description>Delivery to {{ testChannel }} failed. The webhook did not return a 2xx response; check the URL and the server log.</pl-alert-description>
            </pl-alert>
        {% /if %}

        <hh-page-actions description={% "Webhook delivery for platform events (Slack, Discord, or a generic JSON receiver)." %}>
            <a href="/notifications/create" class="hh-button-link"><pl-button variant={% "primary" %}>Add Channel</pl-button></a>
        </hh-page-actions>

        <hh-table-card>
            <pl-table-header><pl-table-row>
                <pl-table-head>Name</pl-table-head>
                <pl-table-head>Format</pl-table-head>
                <pl-table-head>URL</pl-table-head>
                <pl-table-head></pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                <hh-empty-row count={% channels |> Array.length %} colspan={% "4" %} message={% "No channels yet." %}></hh-empty-row>
                {% each channels as index, item %}
                <pl-table-row>
                    <pl-table-cell>{{ item.get("name") }}</pl-table-cell>
                    <pl-table-cell>
                        <pl-badge variant={% "secondary" %}>{{ item.get("format") }}</pl-badge>
                    </pl-table-cell>
                    <pl-table-cell>{{ item.get("url") }}</pl-table-cell>
                    <pl-table-cell>
                        <div class="hh-table-actions">
                            <hh-post-action action={% "/notifications/" + item.get("name") + "/test" %} label={% "Send Test" %}></hh-post-action>
                            <hh-post-action action={% "/notifications/" + item.get("name") + "/delete" %} label={% "Delete" %} confirm={% "Alerts will no longer be delivered to this channel." %}></hh-post-action>
                        </div>
                    </pl-table-cell>
                </pl-table-row>
                {% /each %}
            </pl-table-body>
        </hh-table-card>
    </hh-page>
{% /block %}
