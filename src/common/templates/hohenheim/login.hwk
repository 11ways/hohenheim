<!DOCTYPE html>
<html data-theme="dark">
<head>
    <meta charset="UTF-8">
    <title>Login - Hohenheim</title>
    {% style(href: "/plumage.css") %}
    {% style(href: "/hohenheim.css") %}
</head>
<body onload="main()" class="hh-auth-body">
    {% script(src: "/hohenheim.js") %}

    {% declare error: String %}

    <div class="hh-auth-container">
        <div class="hh-auth-logo">Hohenheim</div>

        {% if error != "" %}
            <pl-alert variant={% "destructive" %} class="hh-form-error">
                <pl-alert-description>{{ error }}</pl-alert-description>
            </pl-alert>
        {% /if %}

        <pl-card>
            <pl-card-header>
                <pl-card-title>Sign In</pl-card-title>
                <pl-card-description>Enter your credentials to access the admin panel.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <form method="POST" action="/login">
                    <div class="hh-form-stack">
                        <div class="hh-form-group">
                            <pl-label target="email">Email</pl-label>
                            <pl-input id="email" type={% "email" %} name={% "email" %} placeholder={% "admin@example.com" %} required={% true %}></pl-input>
                        </div>
                        <div class="hh-form-group">
                            <pl-label target="password">Password</pl-label>
                            <pl-input id="password" type={% "password" %} name={% "password" %} required={% true %}></pl-input>
                        </div>
                    </div>
                    <div class="hh-form-actions">
                        <pl-button variant={% "primary" %} type={% "submit" %}>Sign In</pl-button>
                    </div>
                </form>
            </pl-card-content>
        </pl-card>
    </div>
</body>
</html>
