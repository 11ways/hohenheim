{% tag HhSiteCreate {

    public error: String = ""
    public selectedType: String = "hohenheim:proxy"
    public source: String = ""
    public sourceSettings: Map = null
    public siteTypes: List = null
    public settings: Map = null
    public nodeVersions: List = null
    public systemUsers: List = null
    public environmentVariables: List = null
    public apiKeys: List = null
    public servers: List = null

    template {
        <hh-form-shell
            action={% "/sites/create" %}
            title={% "New Site" %}
            description={% "Configure a new site for the reverse proxy." %}
            submitLabel={% "Create Site" %}
            cancelHref={% "/sites" %}
            error={% error{:} %}>
            <hh-site-form-fields
                siteName={% "" %}
                selectedType={% &selectedType{:} %}
                source={% &source{:} %}
                siteTypes={% siteTypes %}
                settings={% settings %}
                sourceSettings={% sourceSettings %}
                nodeVersions={% nodeVersions %}
                systemUsers={% systemUsers %}
                environmentVariables={% environmentVariables %}
                apiKeys={% apiKeys %}
                servers={% servers %}
                siteSlug={% "" %}></hh-site-form-fields>

            <pl-separator></pl-separator>

            <div class="hh-form-group">
                <pl-label target="hostname">Domain (optional)</pl-label>
                <pl-input id="hostname" type={% "text" %} name={% "hostname" %} placeholder={% "example.com" %}></pl-input>
            </div>
        </hh-form-shell>
    }
} %}

{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}
    {% declare siteTypes: List %}
    {% declare settings: Map %}
    {% declare source: String = "" %}
    {% declare sourceSettings: Map = null %}
    {% declare nodeVersions: List %}
    {% declare systemUsers: List %}
    {% declare environmentVariables: List %}
    {% declare apiKeys: List %}
    {% declare servers: List %}

    <hh-page title={% "Create Site" %}>
        <hh-site-create error={% error{:} %} siteTypes={% siteTypes %} settings={% settings %} source={% source %} sourceSettings={% sourceSettings %} nodeVersions={% nodeVersions %} systemUsers={% systemUsers %} environmentVariables={% environmentVariables %} apiKeys={% apiKeys %} servers={% servers %}></hh-site-create>
    </hh-page>
{% /block %}
