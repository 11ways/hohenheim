{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare siteId: Integer %}
    {% declare siteName: String %}
    {% declare domainId: Integer %}
    {% declare hostname: String %}
    {% declare matchType: String %}
    {% declare forceSsl: Boolean %}
    {% declare hstsEnabled: Boolean %}
    {% declare hstsSubdomains: Boolean %}
    {% declare path: String %}
    {% declare stripPath: Boolean %}
    {% declare listenOn: String %}
    {% declare port: String %}
    {% declare http2Support: Boolean %}
    {% declare excludeFromLetsencrypt: Boolean %}
    {% declare certificateId: String %}
    {% declare certificates: List %}
    {% declare customHeaders: List %}
    {% declare error: String %}

    <hh-page title={% "Edit Domain" %} subtitle={% hostname + " on " + siteName %}>
        <hh-form-shell
            action={% "/sites/" + siteId + "/domains/" + domainId %}
            title={% "Domain Settings" %}
            submitLabel={% "Save Domain" %}
            cancelHref={% "/sites/" + siteId %}
            error={% error %}>
            <div class="hh-form-group">
                <pl-label target="hostname">Hostname</pl-label>
                <pl-input id="hostname" type={% "text" %} name={% "hostname" %} value={% hostname %} required={% true %}></pl-input>
            </div>

            <div class="hh-form-group">
                <pl-label target="match-type">Match Type</pl-label>
                <hh-match-type-select value={% matchType %}></hh-match-type-select>
            </div>

            <pl-separator></pl-separator>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="force_ssl" name="force_ssl" checked={% forceSsl %}></pl-checkbox>
                <pl-label target="force_ssl">Force SSL</pl-label>
                <p class="hh-form-hint">Redirect HTTP requests to HTTPS.</p>
            </div>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="hsts_enabled" name="hsts_enabled" checked={% hstsEnabled %}></pl-checkbox>
                <pl-label target="hsts_enabled">HSTS</pl-label>
                <p class="hh-form-hint">Send Strict-Transport-Security header.</p>
            </div>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="hsts_subdomains" name="hsts_subdomains" checked={% hstsSubdomains %}></pl-checkbox>
                <pl-label target="hsts_subdomains">HSTS Include Subdomains</pl-label>
                <p class="hh-form-hint">Apply HSTS to all subdomains.</p>
            </div>

            <pl-separator></pl-separator>

            <div class="hh-form-group">
                <pl-label target="certificate-id">TLS Certificate</pl-label>
                <pl-select id="certificate-id" name="certificate_id" value={% certificateId %}>
                    <pl-select-trigger placeholder="Auto / None"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="" label="Auto / None">Auto / None</pl-select-item>
                        {% each certificates as index, cert %}
                            <pl-select-item value={% cert.get("id") %} label={% cert.get("name") %}>{{ cert.get("name") }}</pl-select-item>
                        {% /each %}
                    </pl-select-content>
                </pl-select>
                <p class="hh-form-hint">Specific certificate for this domain. Leave on Auto to use SNI matching.</p>
            </div>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="http2_support" name="http2_support" checked={% http2Support %}></pl-checkbox>
                <pl-label target="http2_support">HTTP/2</pl-label>
                <p class="hh-form-hint">Enable HTTP/2 protocol support.</p>
            </div>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="exclude_from_letsencrypt" name="exclude_from_letsencrypt" checked={% excludeFromLetsencrypt %}></pl-checkbox>
                <pl-label target="exclude_from_letsencrypt">Exclude from Let's Encrypt</pl-label>
                <p class="hh-form-hint">Do not automatically issue a certificate for this domain.</p>
            </div>

            <pl-collapsible class="hh-advanced-section">
                <pl-collapsible-trigger class="hh-advanced-trigger">Advanced Settings</pl-collapsible-trigger>
                <pl-collapsible-content>
                    <div class="hh-form-group">
                        <pl-label target="path">Path Prefix</pl-label>
                        <pl-input id="path" type={% "text" %} name={% "path" %} value={% path %} placeholder={% "/api" %}></pl-input>
                        <p class="hh-form-hint">Only route requests matching this path prefix.</p>
                    </div>

                    <div class="hh-form-group hh-checkbox-field">
                        <pl-checkbox inputId="strip_path" name="strip_path" checked={% stripPath %}></pl-checkbox>
                        <pl-label target="strip_path">Strip Path Prefix</pl-label>
                        <p class="hh-form-hint">Remove the path prefix before forwarding to upstream.</p>
                    </div>

                    <pl-separator></pl-separator>

                    <div class="hh-form-group">
                        <pl-label target="listen-on">Listen Address</pl-label>
                        <pl-input id="listen-on" type={% "text" %} name={% "listen_on" %} value={% listenOn %} placeholder={% "0.0.0.0" %}></pl-input>
                        <p class="hh-form-hint">Bind address override. Leave empty for default.</p>
                    </div>

                    <div class="hh-form-group">
                        <pl-label target="port">Port</pl-label>
                        <pl-input id="port" type={% "text" %} name={% "port" %} value={% port %} placeholder={% "Default" %}></pl-input>
                        <p class="hh-form-hint">Port override. Leave empty for default.</p>
                    </div>

                    <div class="hh-form-group">
                        <pl-label>Upstream Header Overrides</pl-label>
                        <hh-key-value-editor initialPairs={% customHeaders %} namePrefix={% "header" %} namePlaceholder={% "Header-Name" %} valuePlaceholder={% "value" %}></hh-key-value-editor>
                        <p class="hh-form-hint">Leave the value empty to remove a header from upstream requests.</p>
                    </div>
                </pl-collapsible-content>
            </pl-collapsible>
        </hh-form-shell>
    </hh-page>
{% /block %}
