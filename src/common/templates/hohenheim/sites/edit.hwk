{% tag HhSiteEdit {

    public siteId: Integer = 0
    public siteName: String = ""
    public siteType: String = "hohenheim:proxy"
    public siteEnabled: Boolean = true
    public siteTypes: List = null
    public source: String = ""
    public sourceSettings: Map = null
    public settings: Map = null
    public environmentVariables: List = null
    public apiKeys: List = null
    public nodeVersions: List = null
    public systemUsers: List = null
    public error: String = ""

    template {
        {% if error{:} != "" %}
            <pl-alert variant={% "destructive" %} class="hh-form-error">
                <pl-alert-title>Error</pl-alert-title>
                <pl-alert-description>{{ error{:} }}</pl-alert-description>
            </pl-alert>
        {% /if %}

        <pl-card class="hh-form-card">
            <pl-card-header>
                <pl-card-title>Site Settings</pl-card-title>
                <pl-card-description>Update the configuration for this site.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <form method="POST" action={% "/sites/" + siteId %}>
                    <div class="hh-form-stack">

                        <div class="hh-form-group">
                            <pl-label target="site-name">Site Name</pl-label>
                            <pl-input id="site-name" type={% "text" %} name={% "name" %} value={% siteName %} required={% true %}></pl-input>
                        </div>

                        <div class="hh-form-group">
                            <pl-label target="site-type">Site Type</pl-label>
                            <pl-select name="site_type" bind:value={% siteType{:} %}>
                                <pl-select-trigger placeholder="Select type"></pl-select-trigger>
                                <pl-select-content>
                                    {% each siteTypes{:} as index, st %}
                                        <pl-select-item value={% st.get("value") %} label={% st.get("label") %}>{{ st.get("label") }}{% if st.get("description") != null %} - {{ st.get("description") }}{% /if %}</pl-select-item>
                                    {% /each %}
                                </pl-select-content>
                            </pl-select>
                        </div>

                        <div class="hh-form-group">
                            <pl-label target="source">Source</pl-label>
                            <pl-select name="source" bind:value={% source{:} %}>
                                <pl-select-trigger placeholder="Local"></pl-select-trigger>
                                <pl-select-content>
                                    <pl-select-item value="" label="Local">Local - files on disk</pl-select-item>
                                    <pl-select-item value="git" label="Git">Git - clone from repository</pl-select-item>
                                </pl-select-content>
                            </pl-select>
                        </div>

                        <div class="hh-form-group">
                            <label class="hh-checkbox-label">
                                <input type="checkbox" name="enabled" checked={% siteEnabled %}>
                                <span>Enabled</span>
                            </label>
                        </div>

                        {% if source{:} == "git" %}
                            <pl-separator></pl-separator>
                            <hh-git-source-settings sourceSettings={% sourceSettings %}></hh-git-source-settings>
                        {% /if %}

                        <pl-separator></pl-separator>

                        <hh-site-type-fields
                            selectedType={% siteType{:} %}
                            settings={% settings %}
                            environmentVariables={% environmentVariables %}
                            apiKeys={% apiKeys %}
                            nodeVersions={% nodeVersions %}
                            systemUsers={% systemUsers %}
                        ></hh-site-type-fields>
                    </div>

                    <div class="hh-form-actions">
                        <pl-button variant={% "primary" %} type={% "submit" %}>Save Changes</pl-button>
                        <a href="/sites" class="hh-button-link"><pl-button variant={% "outline" %} type={% "button" %}>Cancel</pl-button></a>
                    </div>
                </form>
            </pl-card-content>
        </pl-card>
    }
} %}

{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare site: Map %}
    {% declare settings: Map %}
    {% declare source: String = "" %}
    {% declare sourceSettings: Map = null %}
    {% declare domains: List %}
    {% declare siteTypes: List %}
    {% declare environmentVariables: List %}
    {% declare apiKeys: List %}
    {% declare nodeVersions: List %}
    {% declare systemUsers: List %}
    {% declare error: String %}
    {% declare processes: List = null %}
    {% declare isManaged: Boolean = false %}

    <header class="hh-header">
        <h1 class="hh-header__title">{{ site.get("name") }}</h1>
    </header>
    <main class="hh-content">

        <hh-site-edit
            siteId={% site.get("id") %}
            siteName={% site.get("name") %}
            siteType={% site.get("siteType") != null ? site.get("siteType") : "hohenheim:proxy" %}
            siteEnabled={% site.get("enabled") != null ? site.get("enabled") : true %}
            source={% source != null ? source : "" %}
            sourceSettings={% sourceSettings %}
            siteTypes={% siteTypes %}
            settings={% settings %}
            environmentVariables={% environmentVariables %}
            apiKeys={% apiKeys %}
            nodeVersions={% nodeVersions %}
            systemUsers={% systemUsers %}
            error={% error %}
        ></hh-site-edit>

        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Domains</pl-card-title>
                <pl-card-description>Hostnames that route to this site.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-table>
                    <pl-table-header><pl-table-row>
                        <pl-table-head>Hostname</pl-table-head>
                        <pl-table-head>Match Type</pl-table-head>
                        <pl-table-head>SSL</pl-table-head>
                        <pl-table-head></pl-table-head>
                    </pl-table-row></pl-table-header>
                    <pl-table-body>
                        {% each domains as index, domain %}
                        <pl-table-row>
                            <pl-table-cell><a href={% "/sites/" + site.get("id") + "/domains/" + domain.get("id") %}>{{ domain.get("hostname") }}</a></pl-table-cell>
                            <pl-table-cell>
                                <pl-badge variant={% "secondary" %}>{{ domain.get("matchType") }}</pl-badge>
                            </pl-table-cell>
                            <pl-table-cell>
                                {% if domain.get("forceSsl") == true %}
                                    <pl-badge variant={% "default" %}>Forced</pl-badge>
                                {% else %}
                                    <pl-badge variant={% "outline" %}>Off</pl-badge>
                                {% /if %}
                            </pl-table-cell>
                            <pl-table-cell>
                                <form method="POST" action={% "/sites/" + site.get("id") + "/domains/" + domain.get("id") + "/delete" %}>
                                    <pl-button variant={% "ghost" %} size={% "sm" %} type={% "submit" %}>Remove</pl-button>
                                </form>
                            </pl-table-cell>
                        </pl-table-row>
                        {% /each %}
                        {% if domains |> Array.length == 0 %}
                        <pl-table-row>
                            <pl-table-cell colspan="4" class="hh-empty-state">No domains configured.</pl-table-cell>
                        </pl-table-row>
                        {% /if %}
                    </pl-table-body>
                </pl-table>

                <form method="POST" action={% "/sites/" + site.get("id") + "/domains" %} class="hh-add-domain-form">
                    <div class="hh-form-row">
                        <div class="hh-form-group hh-form-group--grow">
                            <pl-input type={% "text" %} name={% "hostname" %} placeholder={% "example.com" %} required={% true %}></pl-input>
                        </div>
                        <div class="hh-form-group">
                            <pl-select name="match_type" value="exact">
                                <pl-select-trigger placeholder="Match type"></pl-select-trigger>
                                <pl-select-content>
                                    <pl-select-item value="exact" label="Exact">Exact</pl-select-item>
                                    <pl-select-item value="wildcard" label="Wildcard">Wildcard</pl-select-item>
                                    <pl-select-item value="regex" label="Regex">Regex</pl-select-item>
                                </pl-select-content>
                            </pl-select>
                        </div>
                        <pl-button variant={% "outline" %} type={% "submit" %}>Add Domain</pl-button>
                    </div>
                </form>
            </pl-card-content>
        </pl-card>

        {% if isManaged %}
        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Processes</pl-card-title>
                <pl-card-description>Running child processes for this site.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-table>
                    <pl-table-header><pl-table-row>
                        <pl-table-head>PID</pl-table-head>
                        <pl-table-head>Port</pl-table-head>
                        <pl-table-head>CPU</pl-table-head>
                        <pl-table-head>Memory</pl-table-head>
                        <pl-table-head>Status</pl-table-head>
                        <pl-table-head></pl-table-head>
                    </pl-table-row></pl-table-header>
                    <pl-table-body>
                        {% each processes as index, proc %}
                        <pl-table-row>
                            <pl-table-cell>{{ proc.get("pid") }}</pl-table-cell>
                            <pl-table-cell>{{ proc.get("port") }}</pl-table-cell>
                            <pl-table-cell>{{ proc.get("cpu") }}%</pl-table-cell>
                            <pl-table-cell>{{ proc.get("memoryMb") }} MB</pl-table-cell>
                            <pl-table-cell>
                                {% if proc.get("isolated") == true %}
                                    <pl-badge variant={% "destructive" %}>Isolated</pl-badge>
                                {% else %}
                                    {% if proc.get("ready") == true %}
                                        <pl-badge variant={% "default" %}>Ready</pl-badge>
                                    {% else %}
                                        <pl-badge variant={% "secondary" %}>Starting</pl-badge>
                                    {% /if %}
                                {% /if %}
                            </pl-table-cell>
                            <pl-table-cell>
                                <div class="hh-form-row">
                                    <form method="POST" action={% "/sites/" + site.get("id") + "/processes/" + proc.get("pid") + "/isolate" %}>
                                        <pl-button variant={% "outline" %} size={% "sm" %} type={% "submit" %}>
                                            {% if proc.get("isolated") == true %}Unisolate{% else %}Isolate{% /if %}
                                        </pl-button>
                                    </form>
                                    <form method="POST" action={% "/sites/" + site.get("id") + "/processes/" + proc.get("pid") + "/kill" %}>
                                        <pl-button variant={% "destructive" %} size={% "sm" %} type={% "submit" %}>Kill</pl-button>
                                    </form>
                                </div>
                            </pl-table-cell>
                        </pl-table-row>
                        {% /each %}
                        {% if processes |> Array.length == 0 %}
                        <pl-table-row>
                            <pl-table-cell colspan="6" class="hh-empty-state">No processes running.</pl-table-cell>
                        </pl-table-row>
                        {% /if %}
                    </pl-table-body>
                </pl-table>

                <div class="hh-form-actions">
                    <form method="POST" action={% "/sites/" + site.get("id") + "/processes/start" %}>
                        <pl-button variant={% "outline" %} type={% "submit" %}>Start Process</pl-button>
                    </form>
                </div>
            </pl-card-content>
        </pl-card>
        {% /if %}

        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Actions</pl-card-title>
            </pl-card-header>
            <pl-card-content>
                <div class="hh-danger-action">
                    <div>
                        <strong>Clone this site</strong>
                        <p class="hh-danger-description">Create a copy with the same settings and domains (disabled by default).</p>
                    </div>
                    <form method="POST" action={% "/sites/" + site.get("id") + "/clone" %}>
                        <pl-button variant={% "outline" %} type={% "submit" %}>Clone Site</pl-button>
                    </form>
                </div>
            </pl-card-content>
        </pl-card>

        <div class="hh-danger-zone">
            <pl-card>
                <pl-card-header>
                    <pl-card-title>Danger Zone</pl-card-title>
                </pl-card-header>
                <pl-card-content>
                    <div class="hh-danger-action">
                        <div>
                            <strong>Delete this site</strong>
                            <p class="hh-danger-description">This will soft-delete the site and remove it from the proxy.</p>
                        </div>
                        <form method="POST" action={% "/sites/" + site.get("id") + "/delete" %}>
                            <pl-button variant={% "destructive" %} type={% "submit" %}>Delete Site</pl-button>
                        </form>
                    </div>
                </pl-card-content>
            </pl-card>
        </div>

    </main>
{% /block %}
