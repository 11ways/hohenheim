{% tag HhSiteEdit {

    public siteId: Integer = 0
    public siteName: String = ""
    public siteType: String = "hohenheim:proxy"
    public siteEnabled: Boolean = true
    public siteTypes: List = null
    public source: String = ""
    public sourceSettings: Map = null
    public settings: Map = null
    public environmentVariables: List = null
    public apiKeys: List = null
    public nodeVersions: List = null
    public systemUsers: List = null
    public servers: List = null
    public authProviders: List = null
    public authProviderId: String = ""
    public siteSlug: String = ""
    public error: String = ""

    template {
        <hh-form-shell
            action={% "/sites/" + siteId %}
            title={% "Site Settings" %}
            description={% "Update the configuration for this site." %}
            submitLabel={% "Save Changes" %}
            cancelHref={% "/sites" %}
            error={% error{:} %}>
            <hh-site-form-fields
                siteName={% siteName %}
                selectedType={% &siteType{:} %}
                source={% &source{:} %}
                siteTypes={% siteTypes %}
                settings={% settings %}
                sourceSettings={% sourceSettings %}
                nodeVersions={% nodeVersions %}
                systemUsers={% systemUsers %}
                environmentVariables={% environmentVariables %}
                apiKeys={% apiKeys %}
                servers={% servers %}
                authProviders={% authProviders %}
                authProviderId={% authProviderId %}
                siteSlug={% siteSlug %}></hh-site-form-fields>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="enabled" name="enabled" checked={% siteEnabled %}></pl-checkbox>
                <pl-label target="enabled">Enabled</pl-label>
            </div>
        </hh-form-shell>
    }
} %}

{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare site: Map %}
    {% declare settings: Map %}
    {% declare source: String = "" %}
    {% declare sourceSettings: Map = null %}
    {% declare domains: List %}
    {% declare siteTypes: List %}
    {% declare environmentVariables: List %}
    {% declare apiKeys: List %}
    {% declare nodeVersions: List %}
    {% declare systemUsers: List %}
    {% declare servers: List %}
    {% declare authProviders: List %}
    {% declare authProviderId: String = "" %}
    {% declare error: String %}
    {% declare processes: List = null %}
    {% declare isManaged: Boolean = false %}

    <hh-page title={% site.get("name") %}>
        <hh-site-edit
            siteId={% site.get("id") %}
            siteName={% site.get("name") %}
            siteType={% site.get("siteType") != null ? site.get("siteType") : "hohenheim:proxy" %}
            siteEnabled={% site.get("enabled") != null ? site.get("enabled") : true %}
            source={% source != null ? source : "" %}
            sourceSettings={% sourceSettings %}
            siteTypes={% siteTypes %}
            settings={% settings %}
            environmentVariables={% environmentVariables %}
            apiKeys={% apiKeys %}
            nodeVersions={% nodeVersions %}
            systemUsers={% systemUsers %}
            servers={% servers %}
            authProviders={% authProviders %}
            authProviderId={% authProviderId %}
            siteSlug={% site.get("slug") != null ? site.get("slug") : "" %}
            error={% error %}
        ></hh-site-edit>

        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Domains</pl-card-title>
                <pl-card-description>Hostnames that route to this site.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-table>
                    <pl-table-header><pl-table-row>
                        <pl-table-head>Hostname</pl-table-head>
                        <pl-table-head>Match Type</pl-table-head>
                        <pl-table-head>SSL</pl-table-head>
                        <pl-table-head></pl-table-head>
                    </pl-table-row></pl-table-header>
                    <pl-table-body>
                        <hh-empty-row count={% domains |> Array.length %} colspan={% "4" %} message={% "No domains configured." %}></hh-empty-row>
                        {% each domains as index, domain %}
                        <pl-table-row>
                            <pl-table-cell><a href={% "/sites/" + site.get("id") + "/domains/" + domain.get("id") %}>{{ domain.get("hostname") }}</a></pl-table-cell>
                            <pl-table-cell>
                                <pl-badge variant={% "secondary" %}>{{ domain.get("matchType") }}</pl-badge>
                            </pl-table-cell>
                            <pl-table-cell>
                                <hh-bool-badge value={% domain.get("forceSsl") %} onLabel={% "Forced" %} offLabel={% "Off" %}></hh-bool-badge>
                            </pl-table-cell>
                            <pl-table-cell>
                                <hh-post-action action={% "/sites/" + site.get("id") + "/domains/" + domain.get("id") + "/delete" %} label={% "Remove" %} variant={% "ghost" %} size={% "sm" %}></hh-post-action>
                            </pl-table-cell>
                        </pl-table-row>
                        {% /each %}
                    </pl-table-body>
                </pl-table>

                <form method="POST" action={% "/sites/" + site.get("id") + "/domains" %} class="hh-add-domain-form">
                    {% csrf() %}
                    <div class="hh-form-row">
                        <div class="hh-form-group hh-form-group--grow">
                            <pl-input type={% "text" %} name={% "hostname" %} placeholder={% "example.com" %} required={% true %}></pl-input>
                        </div>
                        <div class="hh-form-group">
                            <hh-match-type-select></hh-match-type-select>
                        </div>
                        <pl-button variant={% "outline" %} type={% "submit" %}>Add Domain</pl-button>
                    </div>
                </form>
            </pl-card-content>
        </pl-card>

        {% if isManaged %}
        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Processes</pl-card-title>
                <pl-card-description>Running child processes for this site.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-table>
                    <pl-table-header><pl-table-row>
                        <pl-table-head>PID</pl-table-head>
                        <pl-table-head>Port</pl-table-head>
                        <pl-table-head>CPU</pl-table-head>
                        <pl-table-head>Memory</pl-table-head>
                        <pl-table-head>Status</pl-table-head>
                        <pl-table-head></pl-table-head>
                    </pl-table-row></pl-table-header>
                    <pl-table-body>
                        <hh-empty-row count={% processes |> Array.length %} colspan={% "6" %} message={% "No processes running." %}></hh-empty-row>
                        {% each processes as index, proc %}
                        <pl-table-row>
                            <pl-table-cell>{{ proc.get("pid") }}</pl-table-cell>
                            <pl-table-cell>{{ proc.get("port") }}</pl-table-cell>
                            <pl-table-cell>{{ proc.get("cpu") }}%</pl-table-cell>
                            <pl-table-cell>{{ proc.get("memoryMb") }} MB</pl-table-cell>
                            <pl-table-cell>
                                {% if proc.get("isolated") == true %}
                                    <pl-badge variant={% "destructive" %}>Isolated</pl-badge>
                                {% else %}
                                    {% if proc.get("ready") == true %}
                                        <pl-badge variant={% "default" %}>Ready</pl-badge>
                                    {% else %}
                                        <pl-badge variant={% "secondary" %}>Starting</pl-badge>
                                    {% /if %}
                                {% /if %}
                            </pl-table-cell>
                            <pl-table-cell>
                                <div class="hh-form-row">
                                    <hh-post-action action={% "/sites/" + site.get("id") + "/processes/" + proc.get("pid") + "/isolate" %} label={% proc.get("isolated") == true ? "Unisolate" : "Isolate" %} variant={% "outline" %} size={% "sm" %}></hh-post-action>
                                    <hh-post-action action={% "/sites/" + site.get("id") + "/processes/" + proc.get("pid") + "/kill" %} label={% "Kill" %} variant={% "destructive" %} size={% "sm" %}></hh-post-action>
                                </div>
                            </pl-table-cell>
                        </pl-table-row>
                        {% /each %}
                    </pl-table-body>
                </pl-table>

                <div class="hh-form-actions">
                    <hh-post-action action={% "/sites/" + site.get("id") + "/processes/start" %} label={% "Start Process" %} variant={% "outline" %} size={% "md" %}></hh-post-action>
                </div>
            </pl-card-content>
        </pl-card>

        {% if processes |> Array.length > 0 %}
        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Terminal</pl-card-title>
                <pl-card-description>Live stdout/stderr for pid {{ processes.get(0).get("pid") }}. Keystrokes are sent to the process's stdin.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-terminal
                    rows={% 24{:} %}
                    cols={% 100{:} %}
                    wsUrl={% "/ws/terminal/" + site.get("id") + "/" + processes.get(0).get("pid") %}>
                </pl-terminal>
            </pl-card-content>
        </pl-card>
        {% /if %}
        {% /if %}

        <pl-card class="hh-domains-card">
            <pl-card-header>
                <pl-card-title>Actions</pl-card-title>
            </pl-card-header>
            <pl-card-content>
                <div class="hh-danger-action">
                    <div>
                        <strong>Clone this site</strong>
                        <p class="hh-danger-description">Create a copy with the same settings and domains (disabled by default).</p>
                    </div>
                    <hh-post-action action={% "/sites/" + site.get("id") + "/clone" %} label={% "Clone Site" %} variant={% "outline" %} size={% "md" %}></hh-post-action>
                </div>
            </pl-card-content>
        </pl-card>

        <div class="hh-danger-zone">
            <pl-card>
                <pl-card-header>
                    <pl-card-title>Danger Zone</pl-card-title>
                </pl-card-header>
                <pl-card-content>
                    <div class="hh-danger-action">
                        <div>
                            <strong>Delete this site</strong>
                            <p class="hh-danger-description">This will soft-delete the site and remove it from the proxy.</p>
                        </div>
                        <hh-post-action action={% "/sites/" + site.get("id") + "/delete" %} label={% "Delete Site" %} variant={% "destructive" %} size={% "md" %}></hh-post-action>
                    </div>
                </pl-card-content>
            </pl-card>
        </div>
    </hh-page>
{% /block %}
