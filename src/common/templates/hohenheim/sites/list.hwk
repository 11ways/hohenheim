{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare sites: List %}

    <hh-page title={% "Sites" %}>
        <hh-page-actions description={% "Manage your proxy sites and their domains." %}>
            <a href="/sites/create" class="hh-button-link"><pl-button variant={% "primary" %}>Create Site</pl-button></a>
        </hh-page-actions>

        <hh-table-card>
            <pl-table-header><pl-table-row>
                <pl-table-head>Name</pl-table-head>
                <pl-table-head>Type</pl-table-head>
                <pl-table-head>Status</pl-table-head>
                <pl-table-head>Domains</pl-table-head>
                <pl-table-head></pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                <hh-empty-row count={% sites |> Array.length %} colspan={% "5" %} message={% "No sites configured yet." %}></hh-empty-row>
                {% each sites as index, site %}
                <pl-table-row>
                    <pl-table-cell>
                        <a href={% "/sites/" + site.get("id") %} class="hh-site-link">{{ site.get("name") }}</a>
                    </pl-table-cell>
                    <pl-table-cell>
                        <pl-badge variant={% "secondary" %}>{{ site.get("siteType") }}</pl-badge>
                    </pl-table-cell>
                    <pl-table-cell>
                        <hh-bool-badge value={% site.get("enabled") %} onLabel={% "Active" %} offLabel={% "Disabled" %}></hh-bool-badge>
                    </pl-table-cell>
                    <pl-table-cell>{{ site.get("domainCount") }}</pl-table-cell>
                    <pl-table-cell>
                        <div class="hh-table-actions">
                            <hh-post-action action={% "/sites/" + site.get("id") + "/toggle" %} label={% site.get("enabled") == true ? "Disable" : "Enable" %} variant={% "ghost" %} size={% "sm" %}></hh-post-action>
                            <a href={% "/sites/" + site.get("id") %} class="hh-button-link">
                                <pl-button variant={% "ghost" %} size={% "sm" %}>Edit</pl-button>
                            </a>
                        </div>
                    </pl-table-cell>
                </pl-table-row>
                {% /each %}
            </pl-table-body>
        </hh-table-card>
    </hh-page>
{% /block %}
