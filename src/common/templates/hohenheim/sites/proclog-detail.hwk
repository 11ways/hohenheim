{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare siteId: Integer %}
    {% declare siteName: String %}
    {% declare pid: Integer %}
    {% declare createdAt: String %}
    {% declare savedAt: String %}
    {% declare content: String %}

    <hh-page title={% "Process Log — PID " + pid %} subtitle={% siteName %}>
        <hh-page-actions description={% "Started " + createdAt + ", last flushed " + savedAt + "." %}>
            <a href={% "/sites/" + siteId + "/proclogs" %} class="hh-button-link"><pl-button variant={% "outline" %}>All Logs</pl-button></a>
        </hh-page-actions>

        <pl-card>
            <pl-card-content>
                <pl-terminal
                    rows={% 32 %}
                    cols={% 120 %}
                    readOnly={% true %}
                    content={% content %}>
                </pl-terminal>
            </pl-card-content>
        </pl-card>
    </hh-page>
{% /block %}
