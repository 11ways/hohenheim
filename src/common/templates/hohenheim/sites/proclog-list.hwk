{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare siteId: Integer %}
    {% declare siteName: String %}
    {% declare proclogs: List %}

    <hh-page title={% "Process Logs" %} subtitle={% siteName %}>
        <hh-page-actions description={% "Captured stdout/stderr of this site's child processes, flushed every 30 seconds and on exit." %}>
            <a href={% "/sites/" + siteId %} class="hh-button-link"><pl-button variant={% "outline" %}>Back to Site</pl-button></a>
        </hh-page-actions>

        <hh-table-card>
            <pl-table-header><pl-table-row>
                <pl-table-head>PID</pl-table-head>
                <pl-table-head>Started</pl-table-head>
                <pl-table-head>Last Flush</pl-table-head>
                <pl-table-head>Lines</pl-table-head>
                <pl-table-head></pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                <hh-empty-row count={% proclogs |> Array.length %} colspan={% "5" %} message={% "No process logs captured yet." %}></hh-empty-row>
                {% each proclogs as index, item %}
                <pl-table-row>
                    <pl-table-cell>
                        <a href={% "/sites/" + siteId + "/proclogs/" + item.get("id") %} class="hh-site-link">{{ item.get("pid") }}</a>
                    </pl-table-cell>
                    <pl-table-cell>{{ item.get("createdAt") }}</pl-table-cell>
                    <pl-table-cell>{{ item.get("savedAt") }}</pl-table-cell>
                    <pl-table-cell>{{ item.get("lineCount") }}</pl-table-cell>
                    <pl-table-cell>
                        <a href={% "/sites/" + siteId + "/proclogs/" + item.get("id") %} class="hh-button-link">
                            <pl-button variant={% "ghost" %} size={% "sm" %}>View</pl-button>
                        </a>
                    </pl-table-cell>
                </pl-table-row>
                {% /each %}
            </pl-table-body>
        </hh-table-card>
    </hh-page>
{% /block %}
