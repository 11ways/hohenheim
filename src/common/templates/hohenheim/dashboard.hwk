{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare siteCount: Integer %}
    {% declare certCount: Integer %}
    {% declare httpStatus: String %}
    {% declare httpsStatus: String %}
    {% declare routeCount: Integer %}
    {% declare activity: List %}

    <hh-page title={% "Dashboard" %}>
        <div class="hh-stat-grid">
            <pl-card>
                <pl-card-header><pl-card-title>Sites</pl-card-title><pl-card-description>Managed proxy sites</pl-card-description></pl-card-header>
                <pl-card-content><p class="hh-stat-value">{{ siteCount }}</p></pl-card-content>
            </pl-card>
            <pl-card>
                <pl-card-header><pl-card-title>Certificates</pl-card-title><pl-card-description>SSL/TLS certificates</pl-card-description></pl-card-header>
                <pl-card-content><p class="hh-stat-value">{{ certCount }}</p></pl-card-content>
            </pl-card>
            <pl-card>
                <pl-card-header><pl-card-title>HTTP Proxy</pl-card-title><pl-card-description>{{ routeCount }} active routes</pl-card-description></pl-card-header>
                <pl-card-content>
                    {% if httpStatus |> String.startsWith("Failed") %}
                        <pl-badge variant={% "destructive" %}>{{ httpStatus }}</pl-badge>
                    {% elseif httpStatus == "Running" %}
                        <pl-badge variant={% "default" %}>{{ httpStatus }}</pl-badge>
                    {% else %}
                        <pl-badge variant={% "outline" %}>{{ httpStatus }}</pl-badge>
                    {% /if %}
                </pl-card-content>
            </pl-card>
            <pl-card>
                <pl-card-header><pl-card-title>HTTPS Proxy</pl-card-title><pl-card-description>TLS termination</pl-card-description></pl-card-header>
                <pl-card-content>
                    {% if httpsStatus |> String.startsWith("Failed") %}
                        <pl-badge variant={% "destructive" %}>{{ httpsStatus }}</pl-badge>
                    {% elseif httpsStatus |> String.startsWith("Running") %}
                        <pl-badge variant={% "default" %}>{{ httpsStatus }}</pl-badge>
                    {% else %}
                        <pl-badge variant={% "outline" %}>{{ httpsStatus }}</pl-badge>
                    {% /if %}
                </pl-card-content>
            </pl-card>
        </div>

        <div class="hh-dashboard-actions">
            <a href="/sites/create" class="hh-button-link"><pl-button variant={% "outline" %}>Create Site</pl-button></a>
            <a href="/settings" class="hh-button-link"><pl-button variant={% "outline" %}>Settings</pl-button></a>
        </div>

        <pl-card class="hh-activity-card">
            <pl-card-header>
                <pl-card-title>Recent Activity</pl-card-title>
                <pl-card-description>
                    <a href="/audit" class="hh-site-link">View all</a>
                </pl-card-description>
            </pl-card-header>
            <pl-card-content>
                {% if activity |> Array.length == 0 %}
                    <p class="hh-empty-state">No recent activity.</p>
                {% /if %}
                {% each activity as index, entry %}
                    <div class="hh-activity-item">
                        <hh-action-badge action={% entry.get("action") %}></hh-action-badge>
                        <span class="hh-activity-text">{{ entry.get("resourceType") }}: {{ entry.get("resourceName") }}</span>
                    </div>
                {% /each %}
            </pl-card-content>
        </pl-card>
    </hh-page>
{% /block %}
