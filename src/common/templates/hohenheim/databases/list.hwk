{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare databases: List %}

    <hh-page title={% "Databases" %}>
        <hh-page-actions description={% "Managed database engines running as containers." %}>
            <a href="/databases/create" class="hh-button-link"><pl-button variant={% "primary" %}>Create Database</pl-button></a>
        </hh-page-actions>

        <hh-table-card>
            <pl-table-header><pl-table-row>
                <pl-table-head>Name</pl-table-head>
                <pl-table-head>Engine</pl-table-head>
                <pl-table-head>Database</pl-table-head>
                <pl-table-head>Server</pl-table-head>
                <pl-table-head>Status</pl-table-head>
                <pl-table-head>Storage</pl-table-head>
                <pl-table-head></pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                <hh-empty-row count={% databases |> Array.length %} colspan={% "7" %} message={% "No databases yet." %}></hh-empty-row>
                {% each databases as index, item %}
                <pl-table-row>
                    <pl-table-cell>
                        <a href={% "/databases/" + item.get("name") %} class="hh-site-link">{{ item.get("name") }}</a>
                    </pl-table-cell>
                    <pl-table-cell>
                        <pl-badge variant={% "secondary" %}>{{ item.get("engine") }}</pl-badge>
                    </pl-table-cell>
                    <pl-table-cell>{{ item.get("database") }}</pl-table-cell>
                    <pl-table-cell>{{ item.get("server") }}</pl-table-cell>
                    <pl-table-cell>
                        <hh-database-status-badge status={% item.get("status") %} running={% item.get("running") %} port={% item.get("port") %}></hh-database-status-badge>
                    </pl-table-cell>
                    <pl-table-cell>
                        <hh-storage-badge ephemeral={% item.get("ephemeral") %}></hh-storage-badge>
                    </pl-table-cell>
                    <pl-table-cell>
                        <div class="hh-table-actions">
                            <hh-post-action action={% "/databases/" + item.get("name") + "/backup" %} label={% "Backup" %}></hh-post-action>
                            <hh-post-action action={% "/databases/" + item.get("name") + "/delete" %} label={% "Delete" %}></hh-post-action>
                        </div>
                    </pl-table-cell>
                </pl-table-row>
                {% /each %}
            </pl-table-body>
        </hh-table-card>
    </hh-page>
{% /block %}
