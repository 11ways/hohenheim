{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare name: String %}
    {% declare engine: String %}
    {% declare image: String %}
    {% declare database: String %}
    {% declare user: String %}
    {% declare password: String %}
    {% declare server: String %}
    {% declare status: String %}
    {% declare port: Integer %}
    {% declare running: Boolean %}
    {% declare ephemeral: Boolean %}
    {% declare notice: String %}
    {% declare error: String %}

    <hh-page title={% name %}>
        <hh-page-actions>
            <div slot="description">
                <pl-badge variant={% "secondary" %}>{{ engine }}</pl-badge>
                <hh-database-status-badge status={% status %} running={% running %} port={% port %}></hh-database-status-badge>
                <hh-storage-badge ephemeral={% ephemeral %}></hh-storage-badge>
            </div>
            <a href="/databases" class="hh-button-link"><pl-button variant={% "outline" %}>Back</pl-button></a>
        </hh-page-actions>

        {% if notice != "" %}
            <pl-alert>
                <pl-alert-description>{{ notice }}</pl-alert-description>
            </pl-alert>
        {% /if %}
        <hh-form-error error={% error %}></hh-form-error>

        <pl-card>
            <pl-card-header>
                <pl-card-title>Connection</pl-card-title>
                <pl-card-description>Reachable on the host loopback once the container is running.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <pl-table>
                    <pl-table-body>
                        <pl-table-row>
                            <pl-table-head>Host</pl-table-head>
                            <pl-table-cell>127.0.0.1</pl-table-cell>
                        </pl-table-row>
                        <pl-table-row>
                            <pl-table-head>Port</pl-table-head>
                            <pl-table-cell>
                                {% if running == true %}{{ port }}{% else %}(not running){% /if %}
                            </pl-table-cell>
                        </pl-table-row>
                        <pl-table-row>
                            <pl-table-head>Database</pl-table-head>
                            <pl-table-cell>{{ database }}</pl-table-cell>
                        </pl-table-row>
                        <pl-table-row>
                            <pl-table-head>User</pl-table-head>
                            <pl-table-cell>{{ user }}</pl-table-cell>
                        </pl-table-row>
                        <pl-table-row>
                            <pl-table-head>Password</pl-table-head>
                            <pl-table-cell>{{ password }}</pl-table-cell>
                        </pl-table-row>
                        <pl-table-row>
                            <pl-table-head>Server</pl-table-head>
                            <pl-table-cell>{{ server }}</pl-table-cell>
                        </pl-table-row>
                        <pl-table-row>
                            <pl-table-head>Image</pl-table-head>
                            <pl-table-cell>{{ image }}</pl-table-cell>
                        </pl-table-row>
                    </pl-table-body>
                </pl-table>
            </pl-card-content>
        </pl-card>

        <pl-card>
            <pl-card-header>
                <pl-card-title>Restore</pl-card-title>
                <pl-card-description>Load a previously downloaded backup into this database. Existing data may be replaced.</pl-card-description>
            </pl-card-header>
            <pl-card-content>
                <form method="POST" action={% "/databases/" + name + "/restore" %} enctype="multipart/form-data" class="hh-restore-form">
                    {% csrf() %}
                    <input type="file" name="dump" required>
                    <pl-button variant={% "outline" %} size={% "md" %} type={% "submit" %}>Restore Backup</pl-button>
                </form>
            </pl-card-content>
        </pl-card>

        <div class="hh-form-actions">
            <hh-post-action action={% "/databases/" + name + "/backup" %} label={% "Download Backup" %} variant={% "outline" %} size={% "md" %}></hh-post-action>
            <hh-post-action action={% "/databases/" + name + "/delete" %} label={% "Delete" %} variant={% "destructive" %} size={% "md" %}></hh-post-action>
        </div>
    </hh-page>
{% /block %}
