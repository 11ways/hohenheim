{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}
    {% declare servers: List %}

    <hh-page title={% "Create Database" %}>
        <hh-form-shell
            action={% "/databases/create" %}
            title={% "Database" %}
            description={% "Provision a database engine as a managed container." %}
            submitLabel={% "Create Database" %}
            cancelHref={% "/databases" %}
            error={% error %}>
            <div class="hh-form-group">
                <pl-label target="name">Name</pl-label>
                <pl-input id="name" type={% "text" %} name={% "name" %} placeholder={% "blog-db" %} required={% true %}></pl-input>
                <p class="hh-form-hint">Lowercase letters, digits, and dashes; used for the container name.</p>
            </div>

            <div class="hh-form-group">
                <pl-label target="engine">Engine</pl-label>
                <pl-select id="engine" name="engine" value="postgres">
                    <pl-select-trigger placeholder="Engine"></pl-select-trigger>
                    <pl-select-content>
                        <pl-select-item value="postgres" label="PostgreSQL">PostgreSQL</pl-select-item>
                        <pl-select-item value="mysql" label="MySQL">MySQL</pl-select-item>
                        <pl-select-item value="redis" label="Redis">Redis</pl-select-item>
                        <pl-select-item value="mongo" label="MongoDB">MongoDB</pl-select-item>
                    </pl-select-content>
                </pl-select>
            </div>

            <div class="hh-form-group">
                <pl-label target="server">Server</pl-label>
                <pl-select id="server" name="server" value="local">
                    <pl-select-trigger placeholder="Server"></pl-select-trigger>
                    <pl-select-content>
                        {% each servers as serverIndex, serverName %}
                        <pl-select-item value={% serverName %} label={% serverName %}>{{ serverName }}</pl-select-item>
                        {% /each %}
                    </pl-select-content>
                </pl-select>
                <p class="hh-form-hint">The Docker host to run this database on.</p>
            </div>

            <div class="hh-form-group">
                <pl-label target="image">Image</pl-label>
                <pl-input id="image" type={% "text" %} name={% "image" %} placeholder={% "(engine default)" %}></pl-input>
                <p class="hh-form-hint">Override the default image, or leave empty.</p>
            </div>

            <pl-separator></pl-separator>

            <div class="hh-form-group">
                <pl-label target="database">Database Name</pl-label>
                <pl-input id="database" type={% "text" %} name={% "database" %} placeholder={% "appdb" %} required={% true %}></pl-input>
            </div>

            <div class="hh-form-group">
                <pl-label target="db-user">User</pl-label>
                <pl-input id="db-user" type={% "text" %} name={% "db_user" %} placeholder={% "appuser" %}></pl-input>
                <p class="hh-form-hint">Leave blank to use appuser.</p>
            </div>

            <div class="hh-form-group">
                <pl-label target="db-pass">Password</pl-label>
                <pl-input id="db-pass" type={% "password" %} name={% "db_password" %}></pl-input>
                <p class="hh-form-hint">Leave blank to auto-generate a strong password (shown after creation).</p>
            </div>

            <pl-separator></pl-separator>

            <div class="hh-form-group hh-checkbox-field">
                <pl-checkbox inputId="ephemeral" name="ephemeral"></pl-checkbox>
                <pl-label target="ephemeral">Ephemeral Storage</pl-label>
                <p class="hh-form-hint">Data lives in RAM and is lost when the container is removed (previews/CI). Unchecked keeps a persistent volume.</p>
            </div>
        </hh-form-shell>
    </hh-page>
{% /block %}
