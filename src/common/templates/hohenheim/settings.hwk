{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare proxyHttpPort: Integer %}
    {% declare proxyHttpsPort: Integer %}
    {% declare proxyFallback: String %}
    {% declare proxyForceHttps: Boolean %}
    {% declare proxyIpv6Address: String %}
    {% declare adminPort: Integer %}
    {% declare dbPath: String %}
    {% declare logAccessToDb: Boolean %}
    {% declare logAccessToFile: Boolean %}
    {% declare logAccessPath: String %}
    {% declare logCollectStats: Boolean %}
    {% declare secLogDomainMisses: Boolean %}
    {% declare secDomainMissThreshold: Integer %}
    {% declare sslLeEnabled: Boolean %}
    {% declare sslLeEmail: String %}
    {% declare sslLeStaging: Boolean %}
    {% declare saved: String = "" %}

    <hh-page title={% "Settings" %}>

        {% if saved == "true" %}
            <pl-alert variant={% "default" %} class="hh-form-success">
                <pl-alert-description>Settings saved. Some changes require a restart to take effect.</pl-alert-description>
            </pl-alert>
        {% /if %}

        <form method="POST" action="/settings">
            {% csrf() %}
            <div class="hh-settings-grid">

                <pl-card>
                    <pl-card-header>
                        <pl-card-title>Proxy</pl-card-title>
                        <pl-card-description>Reverse proxy listener configuration.</pl-card-description>
                    </pl-card-header>
                    <pl-card-content>
                        <div class="hh-form-stack">
                            <div class="hh-form-row">
                                <div class="hh-form-group hh-form-group--grow">
                                    <pl-label target="proxy-http-port">HTTP Port</pl-label>
                                    <pl-input id="proxy-http-port" type={% "number" %} name={% "proxy_http_port" %} value={% proxyHttpPort + "" %}></pl-input>
                                </div>
                                <div class="hh-form-group hh-form-group--grow">
                                    <pl-label target="proxy-https-port">HTTPS Port</pl-label>
                                    <pl-input id="proxy-https-port" type={% "number" %} name={% "proxy_https_port" %} value={% proxyHttpsPort + "" %}></pl-input>
                                </div>
                            </div>
                            <div class="hh-form-group">
                                <pl-label target="proxy-fallback">Fallback Address</pl-label>
                                <pl-input id="proxy-fallback" type={% "text" %} name={% "proxy_fallback" %} value={% proxyFallback %} placeholder={% "https://example.com" %}></pl-input>
                            </div>
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="proxy_force_https" name="proxy_force_https" checked={% proxyForceHttps %}></pl-checkbox>
                                <pl-label target="proxy_force_https">Force HTTPS globally</pl-label>
                            </div>
                            <div class="hh-form-group">
                                <pl-label target="proxy-ipv6-address">IPv6 Listen Address</pl-label>
                                <pl-input id="proxy-ipv6-address" type={% "text" %} name={% "proxy_ipv6_address" %} value={% proxyIpv6Address %} placeholder={% "::" %}></pl-input>
                            </div>
                        </div>
                    </pl-card-content>
                </pl-card>

                <pl-card>
                    <pl-card-header>
                        <pl-card-title>SSL / TLS</pl-card-title>
                        <pl-card-description>Let's Encrypt and certificate settings.</pl-card-description>
                    </pl-card-header>
                    <pl-card-content>
                        <div class="hh-form-stack">
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="ssl_le_enabled" name="ssl_le_enabled" checked={% sslLeEnabled %}></pl-checkbox>
                                <pl-label target="ssl_le_enabled">Enable Let's Encrypt</pl-label>
                                <p class="hh-form-hint">Automatic certificate issuance and renewal.</p>
                            </div>
                            <div class="hh-form-group">
                                <pl-label target="ssl-le-email">Account Email</pl-label>
                                <pl-input id="ssl-le-email" type={% "email" %} name={% "ssl_le_email" %} value={% sslLeEmail %} placeholder={% "admin@example.com" %}></pl-input>
                                <p class="hh-form-hint">Required for Let's Encrypt registration.</p>
                            </div>
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="ssl_le_staging" name="ssl_le_staging" checked={% sslLeStaging %}></pl-checkbox>
                                <pl-label target="ssl_le_staging">Use staging server</pl-label>
                                <p class="hh-form-hint">Test with fake certificates to avoid rate limits.</p>
                            </div>
                        </div>
                    </pl-card-content>
                </pl-card>

                <pl-card>
                    <pl-card-header>
                        <pl-card-title>Logging</pl-card-title>
                        <pl-card-description>Access logging and statistics.</pl-card-description>
                    </pl-card-header>
                    <pl-card-content>
                        <div class="hh-form-stack">
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="log_access_to_db" name="log_access_to_db" checked={% logAccessToDb %}></pl-checkbox>
                                <pl-label target="log_access_to_db">Log to database</pl-label>
                            </div>
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="log_access_to_file" name="log_access_to_file" checked={% logAccessToFile %}></pl-checkbox>
                                <pl-label target="log_access_to_file">Log to file</pl-label>
                            </div>
                            <div class="hh-form-group">
                                <pl-label target="log-path">Log File Path</pl-label>
                                <pl-input id="log-path" type={% "text" %} name={% "log_access_path" %} value={% logAccessPath %}></pl-input>
                            </div>
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="log_collect_stats" name="log_collect_stats" checked={% logCollectStats %}></pl-checkbox>
                                <pl-label target="log_collect_stats">Collect statistics</pl-label>
                            </div>
                        </div>
                    </pl-card-content>
                </pl-card>

                <pl-card>
                    <pl-card-header>
                        <pl-card-title>Security</pl-card-title>
                        <pl-card-description>Domain miss logging and IP reputation.</pl-card-description>
                    </pl-card-header>
                    <pl-card-content>
                        <div class="hh-form-stack">
                            <div class="hh-form-group hh-checkbox-field">
                                <pl-checkbox inputId="sec_log_domain_misses" name="sec_log_domain_misses" checked={% secLogDomainMisses %}></pl-checkbox>
                                <pl-label target="sec_log_domain_misses">Log domain misses</pl-label>
                            </div>
                            <div class="hh-form-group">
                                <pl-label target="sec-threshold">Miss Threshold</pl-label>
                                <pl-input id="sec-threshold" type={% "number" %} name={% "sec_domain_miss_threshold" %} value={% secDomainMissThreshold + "" %}></pl-input>
                            </div>
                        </div>
                    </pl-card-content>
                </pl-card>

                <pl-card>
                    <pl-card-header>
                        <pl-card-title>Admin</pl-card-title>
                        <pl-card-description>Admin interface and database.</pl-card-description>
                    </pl-card-header>
                    <pl-card-content>
                        <div class="hh-settings-list">
                            <div class="hh-settings-item">
                                <div class="hh-settings-label">Admin Port</div>
                                <div class="hh-settings-value">{{ adminPort }}</div>
                            </div>
                            <div class="hh-settings-item">
                                <div class="hh-settings-label">Database Path</div>
                                <div class="hh-settings-value">{{ dbPath }}</div>
                            </div>
                        </div>
                    </pl-card-content>
                </pl-card>

            </div>

            <div class="hh-form-actions hh-settings-actions">
                <pl-button variant={% "primary" %} type={% "submit" %}>Save Settings</pl-button>
            </div>
        </form>

    </hh-page>
{% /block %}
