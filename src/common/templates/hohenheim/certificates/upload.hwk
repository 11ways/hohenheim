{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}

    <hh-page title={% "Upload Certificate" %}>
        <hh-form-shell
            action={% "/certificates/upload" %}
            title={% "Custom Certificate" %}
            description={% "Upload a PEM-encoded certificate and private key." %}
            submitLabel={% "Upload Certificate" %}
            cancelHref={% "/certificates" %}
            error={% error %}>
            <div class="hh-form-group">
                <pl-label target="nice-name">Certificate Name</pl-label>
                <pl-input id="nice-name" type={% "text" %} name={% "nice_name" %} placeholder={% "example.com wildcard" %} required={% true %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="cert-pem">Certificate (PEM)</pl-label>
                <pl-textarea id="cert-pem" name={% "certificate_pem" %} placeholder={% "-----BEGIN CERTIFICATE-----" %} required={% true %}></pl-textarea>
            </div>
            <div class="hh-form-group">
                <pl-label target="key-pem">Private Key (PEM)</pl-label>
                <pl-textarea id="key-pem" name={% "private_key_pem" %} placeholder={% "-----BEGIN PRIVATE KEY-----" %} required={% true %}></pl-textarea>
            </div>
        </hh-form-shell>
    </hh-page>
{% /block %}
