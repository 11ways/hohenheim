{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}

    <hh-page title={% "Request Certificate" %}>
        <hh-form-shell
            action={% "/certificates/request" %}
            title={% "Let's Encrypt Certificate" %}
            description={% "Request a free TLS certificate via Let's Encrypt. The domains must resolve to this server and port 80 must be accessible." %}
            submitLabel={% "Request Certificate" %}
            cancelHref={% "/certificates" %}
            error={% error %}>
            <div class="hh-form-group">
                <pl-label target="nice-name">Certificate Name (optional)</pl-label>
                <pl-input id="nice-name" type={% "text" %} name={% "nice_name" %} placeholder={% "example.com wildcard" %}></pl-input>
            </div>
            <div class="hh-form-group">
                <pl-label target="domains">Domains</pl-label>
                <pl-textarea id="domains" name={% "domains" %} placeholder={% "example.com\nwww.example.com" %} required={% true %}></pl-textarea>
                <p class="hh-form-hint">One domain per line. All domains must point to this server.</p>
            </div>
            <div class="hh-form-group">
                <pl-label target="letsencrypt-email">Account Email (optional)</pl-label>
                <pl-input id="letsencrypt-email" type={% "email" %} name={% "letsencrypt_email" %} placeholder={% "certs@example.com" %}></pl-input>
                <p class="hh-form-hint">Overrides the global Let's Encrypt account email for this certificate.</p>
            </div>
        </hh-form-shell>
    </hh-page>
{% /block %}
