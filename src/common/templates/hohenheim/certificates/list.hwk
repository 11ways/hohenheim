{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare certificates: List %}

    <hh-page title={% "Certificates" %}>
        <hh-page-actions description={% "SSL/TLS certificates for your sites." %}>
            <a href="/certificates/request" class="hh-button-link"><pl-button variant={% "primary" %}>Request (Let's Encrypt)</pl-button></a>
            <a href="/certificates/upload" class="hh-button-link"><pl-button variant={% "outline" %}>Upload Custom</pl-button></a>
        </hh-page-actions>

        <hh-table-card>
            <pl-table-header><pl-table-row>
                <pl-table-head>Name</pl-table-head>
                <pl-table-head>Provider</pl-table-head>
                <pl-table-head>Domains</pl-table-head>
                <pl-table-head>Status</pl-table-head>
                <pl-table-head>Expires</pl-table-head>
                <pl-table-head></pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                <hh-empty-row count={% certificates |> Array.length %} colspan={% "6" %} message={% "No certificates yet." %}></hh-empty-row>
                {% each certificates as index, cert %}
                <pl-table-row>
                    <pl-table-cell>{{ cert.get("niceName") }}</pl-table-cell>
                    <pl-table-cell>
                        {% if cert.get("provider") == "letsencrypt" %}
                            <pl-badge variant={% "default" %}>Let's Encrypt</pl-badge>
                        {% else %}
                            <pl-badge variant={% "secondary" %}>{{ cert.get("provider") }}</pl-badge>
                        {% /if %}
                    </pl-table-cell>
                    <pl-table-cell>
                        {% if cert.get("domains") != null %}
                            <span class="hh-text-muted">{{ cert.get("domains") }}</span>
                        {% /if %}
                    </pl-table-cell>
                    <pl-table-cell>
                        <hh-cert-status-badge status={% cert.get("status") + "" %}></hh-cert-status-badge>
                    </pl-table-cell>
                    <pl-table-cell>
                        <hh-cert-expiry-badge status={% cert.get("expiryStatus") + "" %} daysLeft={% cert.get("daysLeft") + "" %} hasExpiry={% cert.get("expiresOn") != null %}></hh-cert-expiry-badge>
                    </pl-table-cell>
                    <pl-table-cell>
                        <div class="hh-table-actions">
                            <a href={% "/certificates/" + cert.get("id") + "/download" %} class="hh-button-link">
                                <pl-button variant={% "ghost" %} size={% "sm" %}>Download</pl-button>
                            </a>
                            <hh-post-action action={% "/certificates/" + cert.get("id") + "/delete" %} label={% "Delete" %} confirm={% "This permanently deletes the certificate and its private key." %}></hh-post-action>
                        </div>
                    </pl-table-cell>
                </pl-table-row>
                {% if cert.get("renewalError") != null %}
                <pl-table-row>
                    <pl-table-cell colspan="6">
                        <pl-alert variant={% "destructive" %}>
                            <pl-alert-description>{{ cert.get("renewalError") }}</pl-alert-description>
                        </pl-alert>
                    </pl-table-cell>
                </pl-table-row>
                {% /if %}
                {% /each %}
            </pl-table-body>
        </hh-table-card>
    </hh-page>
{% /block %}
