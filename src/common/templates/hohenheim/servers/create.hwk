{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}

    <header class="hh-header">
        <h1 class="hh-header__title">Add Server</h1>
    </header>
    <main class="hh-content">

        {% if error != "" %}
            <pl-alert variant={% "destructive" %} class="hh-form-error">
                <pl-alert-title>Error</pl-alert-title>
                <pl-alert-description>{{ error }}</pl-alert-description>
            </pl-alert>
        {% /if %}

        <form method="POST" action="/servers/create">
            <pl-card class="hh-form-card">
                <pl-card-header>
                    <pl-card-title>Remote Server</pl-card-title>
                    <pl-card-description>A remote Docker host reached over SSH (key-based auth and docker required).</pl-card-description>
                </pl-card-header>
                <pl-card-content>
                    <div class="hh-form-stack">
                        <div class="hh-form-group">
                            <pl-label target="name">Name</pl-label>
                            <pl-input id="name" type={% "text" %} name={% "name" %} placeholder={% "edge-1" %} required={% true %}></pl-input>
                            <p class="hh-form-hint">Lowercase letters, digits, and dashes.</p>
                        </div>
                        <div class="hh-form-group">
                            <pl-label target="ssh-target">SSH Target</pl-label>
                            <pl-input id="ssh-target" type={% "text" %} name={% "ssh_target" %} placeholder={% "user@host" %} required={% true %}></pl-input>
                            <p class="hh-form-hint">Connected via ssh and docker system dial-stdio.</p>
                        </div>
                    </div>
                </pl-card-content>
            </pl-card>

            <div class="hh-form-actions">
                <pl-button variant={% "primary" %} type={% "submit" %}>Add Server</pl-button>
                <a href="/servers" class="hh-button-link"><pl-button variant={% "outline" %} type={% "button" %}>Cancel</pl-button></a>
            </div>
        </form>

    </main>
{% /block %}
