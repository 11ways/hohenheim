{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare servers: List %}

    <hh-page title={% "Servers" %}>
        <hh-page-actions description={% "Docker hosts this platform manages -- the local daemon plus remote hosts over SSH." %}>
            <a href="/servers/create" class="hh-button-link"><pl-button variant={% "primary" %}>Add Server</pl-button></a>
        </hh-page-actions>

        <hh-table-card>
            <pl-table-header><pl-table-row>
                <pl-table-head>Name</pl-table-head>
                <pl-table-head>Mode</pl-table-head>
                <pl-table-head>Target</pl-table-head>
                <pl-table-head>Reachable</pl-table-head>
                <pl-table-head>CPUs</pl-table-head>
                <pl-table-head>Memory</pl-table-head>
                <pl-table-head>Containers</pl-table-head>
                <pl-table-head>Images</pl-table-head>
                <pl-table-head></pl-table-head>
            </pl-table-row></pl-table-header>
            <pl-table-body>
                <hh-empty-row count={% servers |> Array.length %} colspan={% "9" %} message={% "No servers yet." %}></hh-empty-row>
                {% each servers as index, item %}
                <pl-table-row>
                    <pl-table-cell>{{ item.get("name") }}</pl-table-cell>
                    <pl-table-cell>
                        <pl-badge variant={% "secondary" %}>{{ item.get("mode") }}</pl-badge>
                    </pl-table-cell>
                    <pl-table-cell>{{ item.get("sshTarget") }}</pl-table-cell>
                    <pl-table-cell>
                        <hh-bool-badge value={% item.get("reachable") %} onLabel={% "Reachable" %} offLabel={% "Unreachable" %} offVariant={% "destructive" %}></hh-bool-badge>
                    </pl-table-cell>
                    <pl-table-cell>{{ item.get("cpus") }}</pl-table-cell>
                    <pl-table-cell>{{ item.get("memory") }}</pl-table-cell>
                    <pl-table-cell>{{ item.get("containers") }}</pl-table-cell>
                    <pl-table-cell>{{ item.get("images") }}</pl-table-cell>
                    <pl-table-cell>
                        {% if item.get("removable") == true %}
                        <hh-post-action action={% "/servers/" + item.get("name") + "/delete" %} label={% "Remove" %}></hh-post-action>
                        {% /if %}
                    </pl-table-cell>
                </pl-table-row>
                {% /each %}
            </pl-table-body>
        </hh-table-card>
    </hh-page>
{% /block %}
