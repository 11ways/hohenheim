{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare id: Integer %}
    {% declare name: String %}
    {% declare satisfy: String %}
    {% declare basicAuthUser: String %}
    {% declare basicAuthPass: String %}
    {% declare allowedIps: String %}
    {% declare deniedIps: String %}
    {% declare error: String %}

    <hh-page title={% "Edit Access List" %}>
        <hh-form-shell
            action={% "/access-lists/" + id %}
            title={% name %}
            submitLabel={% "Save Access List" %}
            cancelHref={% "/access-lists" %}
            error={% error %}>
            <hh-access-list-fields
                name={% name %}
                satisfy={% satisfy %}
                basicAuthUser={% basicAuthUser %}
                basicAuthPass={% basicAuthPass %}
                allowedIps={% allowedIps %}
                deniedIps={% deniedIps %}></hh-access-list-fields>
        </hh-form-shell>
    </hh-page>
{% /block %}
