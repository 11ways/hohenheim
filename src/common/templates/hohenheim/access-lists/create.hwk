{% extend "hohenheim:hohenheim/base" %}

{% block "main" %}
    {% declare error: String %}

    <hh-page title={% "Create Access List" %}>
        <hh-form-shell
            action={% "/access-lists/create" %}
            title={% "Access List" %}
            description={% "IP filtering and basic authentication." %}
            submitLabel={% "Create Access List" %}
            cancelHref={% "/access-lists" %}
            error={% error %}>
            <hh-access-list-fields></hh-access-list-fields>
        </hh-form-shell>
    </hh-page>
{% /block %}
