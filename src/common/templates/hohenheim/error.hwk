<!DOCTYPE html>
<html lang={% Locales.current() %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ statusCode }} - {{ title }}</title>
    {# The proxy answers on a customer's domain before any Zenit request, where no stylesheet of
       ours is reachable, so this page is standalone. It follows the reader's colour scheme through
       the system colours, and every muted tier is a mix of that pair, never a chosen literal. #}
    <style>
        :root { color-scheme: light dark; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: Canvas; color: CanvasText;
            display: flex; align-items: center; justify-content: center;
            min-height: 100vh;
        }
        .error { text-align: center; max-width: 480px; padding: 2rem; }
        .error-code {
            font-size: 6rem; font-weight: 700; line-height: 1;
            color: color-mix(in srgb, CanvasText 45%, Canvas);
        }
        .error-title { font-size: 1.25rem; font-weight: 600; margin: 1rem 0 0.5rem; }
        .error-message { color: color-mix(in srgb, CanvasText 75%, Canvas); font-size: 0.875rem; line-height: 1.5; }
        .error-host {
            color: color-mix(in srgb, CanvasText 60%, Canvas); font-size: 0.75rem; margin-top: 2rem;
            padding-top: 1rem; border-top: 1px solid color-mix(in srgb, CanvasText 15%, Canvas);
        }
    </style>
</head>
<body>
    {% declare statusCode: String %}
    {% declare title: String %}
    {% declare message: String %}
    {% declare hostname: String = "" %}

    <div class="error">
        <div class="error-code">{{ statusCode }}</div>
        <div class="error-title">{{ title }}</div>
        {% if message != "" %}
            <div class="error-message">{{ message }}</div>
        {% /if %}
        {% if hostname != "" %}
            <div class="error-host">{{ hostname }}</div>
        {% /if %}
    </div>
</body>
</html>
