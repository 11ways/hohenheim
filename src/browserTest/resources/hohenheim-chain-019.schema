table system_users
  column created_at timestamp(2000000000,10) null default=null
  column gecos varchar(512,0) null default=null
  column gid integer(2000000000,0) null default=null
  column home varchar(512,0) null default=null
  column id integer(2000000000,0) null default=null pk
  column last_seen_at timestamp(2000000000,10) null default=null
  column managed integer(2000000000,0) null default=false
  column name varchar(255,0) null default=null
  column obsolete integer(2000000000,0) null default=false
  column site_id integer(2000000000,0) null default=null
  column uid integer(2000000000,0) null default=null
  column updated_at timestamp(2000000000,10) null default=null
  index system_users_name_unique declared unique [name]
  index system_users_obsolete_index declared plain [obsolete]
  index system_users_site_id_unique declared unique [site_id]
  primary key [id]
table webhook_deliveries
  column action varchar(100,0) null default=null
  column created_at timestamp(2000000000,10) null default=null
  column delivery_key varchar(191,0) null default=null
  column event varchar(100,0) null default=null
  column id integer(2000000000,0) null default=null pk
  column instance_id integer(2000000000,0) not null default=null
  column received_at timestamp(2000000000,10) null default=null
  column updated_at timestamp(2000000000,10) null default=null
  foreign key [instance_id] -> instances[id] on update no action on delete no action
  index webhook_deliveries_instance_key_unique declared unique [instance_id, delivery_key]
  primary key [id]
